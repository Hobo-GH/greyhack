//Made By Hobo & Rowan
// AutoRoute 2.1.1 owned-route and AutoNet proxy controller for Grey Hack Public v0.9.6773.
//
// First run asks for an ordered SSH route and saves it outside the source.
// AutoRoute keeps that trusted chain separate from the verified AutoNet node
// database, then optionally extends and collapses a temporary proxy layer.
// A ready proxy route is published on the final owned server for AutoDeploy;
// collapse removes that active handoff before the final owned-route cleanup.

SCRIPT_VERSION = "2.1.1"
PIN = ""

AUTOSCRIPTS_ROOT = "/root/autoscripts"
NETWORK_ROOT = "/root/autoscripts/network"
NETWORK_INDEX_PATH = "/root/autoscripts/network/index.txt"
OWNED_ROUTE_PATH = "/root/autoscripts/network/owned-route.txt"
ACTIVE_PROXY_ROUTE_PATH = "/root/autoscripts/network/active-proxy-route.txt"
AUTONET_NODE_ROOT = "/root/autoscripts/autonet/nodes"
AUTONET_NODE_INDEX_PATH = "/root/autoscripts/autonet/nodes/index.txt"
AUTONET_NODE_INDEX_HEADER = "ANNODEINDEX1"
AUTONET_NODE_SHARD_HEADER = "ANNODES1"
AUTONET_NODE_SHARD_PREFIX = "ssh-"
NETWORK_INDEX_HEADER = "ASNETINDEX1"
ROUTE_HEADER = "ASOWNED1"
ACTIVE_PROXY_ROUTE_HEADER = "ASPROXY1"
MAX_HOPS = 8
DEFAULT_HOPS = 2
MAX_PROXY_HOPS = 50
DEFAULT_PROXY_HOPS = 3
DEFAULT_SSH_PORT = 22
HELPER_WAIT_SECONDS = 60
FINALIZER_WAIT_SECONDS = 2

// Compile the companion source as /bin/autoroute-proxy-helper. AutoRoute sends
// only that credential-free helper beyond the final owned server. The private
// controller remains confined to the home computer and trusted owned route.
PROXY_HELPER_SOURCE = "/bin/autoroute-proxy-helper"

// PRIVATE OPTIONAL OVERRIDE.
// Leave blank in every public/GitHub copy. In a private copy, enter the root
// password of the execution computer's physical router. AutoRoute uses it
// only when the router exploit returns a guest shell that cannot write the log.
HOME_ROUTER_PASSWORD = ""

COLOR_PURPLE = "#D86CFF"
COLOR_CYAN = "#55E7FF"
COLOR_GREEN = "#63FF9B"
COLOR_RED = "#FF5C7C"
COLOR_ORANGE = "#FFB86B"
COLOR_PINK = "#FF79C6"
COLOR_LAVENDER = "#C7A7E8"
COLOR_DIM = "#A79BC8"


paint = function(value, color)
    return "<color=" + color + ">" + str(value) + "</color>"
end function


event_line = function(label, label_color, detail = "", detail_color = COLOR_LAVENDER)
    line = paint("◆ " + label, label_color)
    if detail != "" then line = line + "  " + paint(detail, detail_color)
    return line
end function


event_branch = function(label, label_color, detail = "", detail_color = COLOR_LAVENDER)
    line = paint("  ╰ " + label, label_color)
    if detail != "" then line = line + "  " + paint(detail, detail_color)
    return line
end function


route_heading = function(title, detail = "")
    line = char(10) + paint("◆ " + title, COLOR_PURPLE)
    if detail != "" then line = line + "  " + paint(detail, COLOR_CYAN)
    print(line)
end function


fatal_line = function(message)
    return paint("AUTOROUTE REFUSED", COLOR_RED) + " | " + paint(message, COLOR_ORANGE)
end function


route_pin_signature = function()
    origin = "NO ORIGIN"
    if is_computer(globals.local_computer) then
        origin = globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
    end if
    top = paint("╭─◆ AUTOROUTE ◆─", COLOR_PURPLE) +
        paint("[PIN REQUIRED]", COLOR_ORANGE)
    bottom = paint("╰─", COLOR_PURPLE) + paint("ORIGIN ", COLOR_ORANGE) +
        paint(origin, COLOR_CYAN) + paint(" ─▶ ", COLOR_GREEN) +
        paint("ENTER PIN", COLOR_PINK) + paint(" ─▶ ", COLOR_GREEN)
    return top + char(10) + bottom
end function


show_auto_action = function(label, detail = "", color = COLOR_PURPLE, detail_color = COLOR_CYAN)
    print(event_line(label, color, detail, detail_color))
end function


show_attack_attempt = function(fingerprint, mode)
    if not globals.hasIndex("visual_attack_index") then
        globals.visual_attack_index = 0
    end if
    globals.visual_attack_index = globals.visual_attack_index + 1
    print(paint("◆ ATTACK ", COLOR_PURPLE) +
        paint("[" + globals.visual_attack_index + "]", COLOR_PINK) +
        "  " +
        paint(fingerprint, COLOR_CYAN) + "  " + paint(mode, COLOR_ORANGE))
end function


is_file = function(value)
    return typeof(value).lower == "file"
end function


is_shell = function(value)
    return typeof(value).lower == "shell"
end function


is_computer = function(value)
    return typeof(value).lower == "computer"
end function


is_exploit_object = function(value)
    kind = typeof(value).lower
    return kind == "shell" or kind == "computer" or kind == "file"
end function


join_path = function(folder, name)
    if folder == "/" then return "/" + name
    if folder[-1] == "/" then return folder + name
    return folder + "/" + name
end function


ensure_folder_path_on = function(computer, path)
    if not is_computer(computer) then return null
    current = "/"
    for part in path.split("/")
        part = part.trim
        if part == "" then continue
        next_path = join_path(current, part)
        item = computer.File(next_path)
        if is_file(item) then
            if not item.is_folder then return null
        else
            if computer.create_folder(current, part) != 1 then return null
            item = computer.File(next_path)
            if not is_file(item) then return null
        end if
        current = next_path
    end for
    return computer.File(path)
end function


ensure_folder_path = function(path)
    return ensure_folder_path_on(globals.local_computer, path)
end function


ensure_network_layout = function()
    network = ensure_folder_path(NETWORK_ROOT)
    if not is_file(network) then return false
    index = globals.local_computer.File(NETWORK_INDEX_PATH)
    if not is_file(index) then
        if globals.local_computer.touch(NETWORK_ROOT, "index.txt") != 1 then return false
        index = globals.local_computer.File(NETWORK_INDEX_PATH)
        if not is_file(index) then return false
        lines = [NETWORK_INDEX_HEADER, "O|owned-route.txt", "P|active-proxy-route.txt|" +
            ACTIVE_PROXY_ROUTE_HEADER]
        if index.set_content(lines.join(char(10))) != 1 then return false
    else if not index.is_binary then
        content = index.get_content
        if typeof(content).lower != "string" then return false
        lines = content.replace(char(13), "").split(char(10))
        if lines.len == 0 or lines[0].trim != NETWORK_INDEX_HEADER then return false
        record = "P|active-proxy-route.txt|" + ACTIVE_PROXY_ROUTE_HEADER
        if lines.indexOf(record) == null then
            lines.push(record)
            if index.set_content(lines.join(char(10))) != 1 then return false
        end if
    end if
    return true
end function


route_file = function(create = false)
    file = globals.local_computer.File(OWNED_ROUTE_PATH)
    if is_file(file) then return file
    if not create then return null
    if not ensure_network_layout then return null
    if globals.local_computer.touch(NETWORK_ROOT, "owned-route.txt") != 1 then return null
    return globals.local_computer.File(OWNED_ROUTE_PATH)
end function


safe_field = function(value)
    if typeof(value).lower != "string" then return false
    if value.indexOf("|") != null then return false
    if value.indexOf(char(10)) != null then return false
    if value.indexOf(char(13)) != null then return false
    return true
end function


final_owned_computer = function()
    if globals.shells.len < 2 then return null
    shell = globals.shells[-1]
    if not is_shell(shell) then return null
    return shell.host_computer
end function


ensure_remote_network_layout = function(computer)
    if not is_computer(computer) then return false
    network = ensure_folder_path_on(computer, NETWORK_ROOT)
    if not is_file(network) then return false
    index = computer.File(NETWORK_INDEX_PATH)
    record = "P|active-proxy-route.txt|" + ACTIVE_PROXY_ROUTE_HEADER
    if not is_file(index) then
        if computer.touch(NETWORK_ROOT, "index.txt") != 1 then return false
        index = computer.File(NETWORK_INDEX_PATH)
        if not is_file(index) then return false
        if index.set_content([NETWORK_INDEX_HEADER, record].join(char(10))) != 1 then return false
    else
        if index.is_folder or index.is_binary then return false
        content = index.get_content
        if typeof(content).lower != "string" then return false
        lines = content.replace(char(13), "").split(char(10))
        if lines.len == 0 or lines[0].trim != NETWORK_INDEX_HEADER then return false
        if lines.indexOf(record) == null then
            lines.push(record)
            if index.set_content(lines.join(char(10))) != 1 then return false
        end if
    end if
    return true
end function


active_proxy_route_file = function(create = false)
    computer = final_owned_computer
    if not is_computer(computer) then return null
    file = computer.File(ACTIVE_PROXY_ROUTE_PATH)
    if is_file(file) then return file
    if not create then return null
    if not ensure_remote_network_layout(computer) then return null
    if computer.touch(NETWORK_ROOT, "active-proxy-route.txt") != 1 then return null
    return computer.File(ACTIVE_PROXY_ROUTE_PATH)
end function


delete_active_proxy_manifest = function(silent = false)
    file = active_proxy_route_file
    if not is_file(file) then
        globals.proxy_manifest_active = false
        globals.proxy_manifest_count = 0
        globals.proxy_manifest_endpoint = "none"
        return true
    end if
    file.delete
    if is_file(active_proxy_route_file) then
        if not silent then
            print(event_line("AUTODEPLOY HANDOFF", COLOR_RED, "retirement failed", COLOR_RED))
        end if
        return false
    end if
    globals.proxy_manifest_active = false
    globals.proxy_manifest_count = 0
    globals.proxy_manifest_endpoint = "none"
    if not silent then print(event_line("AUTODEPLOY HANDOFF", COLOR_GREEN, "retired", COLOR_GREEN))
    return true
end function


write_active_proxy_manifest = function()
    if globals.proxy_nodes.len == 0 then return false
    lines = [ACTIVE_PROXY_ROUTE_HEADER]
    index = 0
    for node in globals.proxy_nodes
        fields = [str(index + 1), str(node.ip), str(node.port), str(node.user),
            str(node.password)]
        for field in fields
            if not safe_field(field) then
                print(event_line("AUTODEPLOY HANDOFF", COLOR_RED,
                    "unsafe proxy field refused", COLOR_RED))
                return false
            end if
        end for
        lines.push("P|" + fields.join("|"))
        index = index + 1
    end for
    file = active_proxy_route_file(true)
    if not is_file(file) or file.is_folder or file.is_binary then return false
    payload = lines.join(char(10))
    if file.set_content(payload) != 1 then return false
    check = file.get_content
    if typeof(check).lower != "string" or check != payload then return false
    globals.proxy_manifest_active = true
    globals.proxy_manifest_count = globals.proxy_nodes.len
    globals.proxy_manifest_endpoint = globals.proxy_nodes[-1].ip
    print(event_line("AUTODEPLOY HANDOFF", COLOR_GREEN, "READY", COLOR_GREEN))
    print(event_branch("NODES", COLOR_PINK, globals.proxy_manifest_count, COLOR_PINK) +
        "  " + paint("ENDPOINT", COLOR_CYAN) + "  " +
        paint(globals.proxy_manifest_endpoint, COLOR_CYAN))
    print(event_branch("MANIFEST", COLOR_ORANGE, ACTIVE_PROXY_ROUTE_PATH, COLOR_ORANGE))
    print(event_branch("CREDENTIALS", COLOR_PINK, "masked", COLOR_PINK))
    return true
end function


prompt_nonempty = function(label, hidden = false, fallback = "")
    while true
        if hidden then value = user_input(label, 1) else value = user_input(label)
        value = value.trim
        if value == "" and fallback != "" then value = fallback
        if value != "" and safe_field(value) then return value
        print(event_line("VALUE REFUSED", COLOR_RED,
            "required value cannot contain |", COLOR_RED))
    end while
end function


setup_route = function()
    route_heading("OWNED ROUTE SETUP", "FIRST RUN")
    print(event_line("ROUTE STORAGE", COLOR_PURPLE, OWNED_ROUTE_PATH, COLOR_ORANGE))
    print(event_branch("CREDENTIALS", COLOR_PINK,
        "masked during entry and never printed", COLOR_PINK))

    count_text = user_input("SSH hop count [" + DEFAULT_HOPS + "]: ").trim
    if count_text == "" then count = DEFAULT_HOPS else count = count_text.to_int
    if typeof(count).lower != "number" then return null
    if count < 1 or count > MAX_HOPS then
        print(event_line("HOP COUNT REFUSED", COLOR_RED,
            "expected 1-" + MAX_HOPS, COLOR_RED))
        return null
    end if

    hops = []
    number = 1
    while number <= count
        print(char(10) + paint("◆ SSH HOP ", COLOR_PURPLE) +
            paint(number + "/" + count, COLOR_PINK))
        alias = prompt_nonempty("Alias [hop" + number + "]: ", false, "hop" + number)
        ip = ""
        while ip == ""
            candidate = prompt_nonempty("Public IP: ")
            if is_valid_ip(candidate) then
                ip = candidate
            else
                print(event_line("IP REFUSED", COLOR_RED, candidate, COLOR_CYAN))
            end if
        end while

        port_text = user_input("SSH port [" + DEFAULT_SSH_PORT + "]: ").trim
        if port_text == "" then port = DEFAULT_SSH_PORT else port = port_text.to_int
        if typeof(port).lower != "number" or port < 1 or port > 65535 then
            print(event_line("PORT REFUSED", COLOR_RED, port_text, COLOR_CYAN))
            return null
        end if

        user = prompt_nonempty("SSH user [root]: ", false, "root")
        password = prompt_nonempty("SSH password: ", true)
        hops.push({"alias": alias, "ip": ip, "port": port, "user": user, "password": password})
        number = number + 1
    end while

    lines = [ROUTE_HEADER]
    for hop in hops
        lines.push("H|" + hop.alias + "|" + hop.ip + "|" + hop.port + "|" + hop.user + "|" + hop.password)
    end for
    file = route_file(true)
    if not is_file(file) then return null
    if file.set_content(lines.join(char(10))) != 1 then return null
    print(char(10) + event_line("OWNED ROUTE SAVED", COLOR_GREEN,
        hops.len + " hops", COLOR_GREEN))
    return hops
end function


load_route = function()
    file = route_file
    if not is_file(file) then return null
    if file.is_binary then return null
    content = file.get_content
    if typeof(content).lower != "string" then return null
    lines = content.replace(char(13), "").split(char(10))
    if lines.len < 2 then return null
    if lines[0].trim != ROUTE_HEADER then return null
    hops = []
    for line in lines[1:]
        parts = line.trim.split("[|]")
        if parts.len < 6 then continue
        if parts[0] != "H" then continue
        port = parts[3].to_int
        if not is_valid_ip(parts[2]) then continue
        if typeof(port).lower != "number" or port < 1 or port > 65535 then continue
        if parts[1] == "" or parts[4] == "" or parts[5] == "" then continue
        hops.push({"alias": parts[1], "ip": parts[2], "port": port,
            "user": parts[4], "password": parts[5],})
    end for
    if hops.len == 0 or hops.len > MAX_HOPS then return null
    return hops
end function


show_route = function(hops)
    route_heading("CONFIGURED ROUTE", hops.len + " HOPS")
    number = 1
    for hop in hops
        print(paint("◆ OWNED HOP ", COLOR_PURPLE) + paint("[" + number + "]", COLOR_PINK) +
            "  " + paint(hop.alias, COLOR_PINK))
        print(event_branch("ENDPOINT", COLOR_CYAN, hop.ip + ":" + hop.port, COLOR_CYAN) +
            "  " + paint("AUTHORITY", COLOR_PINK) + "  " + paint(hop.user, COLOR_PINK))
        number = number + 1
    end for
end function


digits_only = function(value)
    text = str(value)
    if text == "" then return false
    for character in text
        if character < "0" or character > "9" then return false
    end for
    return true
end function


pad4 = function(value)
    text = str(value)
    while text.len < 4
        text = "0" + text
    end while
    return text
end function


autonet_shard_name = function(number)
    return AUTONET_NODE_SHARD_PREFIX + pad4(number) + ".txt"
end function


load_autonet_nodes = function(base_shell)
    nodes = []
    if not is_shell(base_shell) then return nodes
    computer = base_shell.host_computer
    if not is_computer(computer) then return nodes
    folder = computer.File(AUTONET_NODE_ROOT)
    if not is_file(folder) or not folder.is_folder then return nodes

    shard_count = 0
    index = computer.File(AUTONET_NODE_INDEX_PATH)
    if is_file(index) and not index.is_folder and not index.is_binary then
        content = index.get_content
        if typeof(content).lower == "string" then
            lines = content.replace(char(13), "").split(char(10))
            if lines.len > 0 and lines[0].trim == AUTONET_NODE_INDEX_HEADER then
                for line in lines[1:]
                    parts = line.trim.split("[|]")
                    if parts.len == 2 and parts[0] == "S" and digits_only(parts[1]) then
                        shard_count = parts[1].to_int
                    end if
                end for
            end if
        end if
    end if

    names = []
    if shard_count > 0 then
        number = 1
        while number <= shard_count
            names.push(autonet_shard_name(number))
            number = number + 1
        end while
    else
        files = folder.get_files
        if typeof(files).lower == "list" then
            for file in files
                if file.name.indexOf(AUTONET_NODE_SHARD_PREFIX) == 0 then names.push(file.name)
            end for
        end if
    end if

    blocked = {}
    blocked[globals.local_computer.public_ip] = 1
    for hop in globals.hops
        blocked[hop.ip] = 1
    end for
    seen = {}
    for name in names
        file = computer.File(join_path(AUTONET_NODE_ROOT, name))
        if not is_file(file) or file.is_folder or file.is_binary then continue
        content = file.get_content
        if typeof(content).lower != "string" then continue
        lines = content.replace(char(13), "").split(char(10))
        if lines.len == 0 or lines[0].trim != AUTONET_NODE_SHARD_HEADER then continue
        for line in lines[1:]
            parts = line.trim.split("[|]")
            if parts.len < 11 or parts[0] != "N" then continue
            port = parts[3].to_int
            if not is_valid_ip(parts[2]) or blocked.hasIndex(parts[2]) then continue
            if typeof(port).lower != "number" or port < 1 or port > 65535 then continue
            if parts[4] != "root" or parts[5] == "" or not safe_field(parts[5]) then continue
            if parts[8] != "yes" then continue
            key = parts[2] + ":" + port
            if seen.hasIndex(key) then continue
            seen[key] = 1
            nodes.push({"id": parts[1], "ip": parts[2], "port": port,
                "user": parts[4], "password": parts[5], "lan": parts[6],
                "verified": parts[7], "computer_clean": parts[8],
                "router_clean": parts[9], "source": parts[10],})
        end for
    end for
    return nodes
end function


show_autonet_nodes = function()
    if globals.shells.len < 2 then
        print(event_line("AUTONET PROXY POOL", COLOR_RED, "owned route not ready", COLOR_RED))
        return
    end if
    nodes = load_autonet_nodes(globals.shells[-1])
    route_heading("AUTONET PROXY POOL", nodes.len + " VERIFIED")
    if nodes.len == 0 then
        print(event_line("NO VERIFIED NODES", COLOR_ORANGE,
            "final owned server pool is empty", COLOR_ORANGE))
        return
    end if
    index = 0
    for node in nodes
        router_color = COLOR_ORANGE
        if node.router_clean == "yes" then router_color = COLOR_GREEN
        print(paint("◆ NODE ", COLOR_PURPLE) + paint("[" + index + "]", COLOR_PINK) +
            "  " + paint(node.ip + ":" + node.port, COLOR_CYAN))
        print(event_branch("AUTHORITY", COLOR_PINK, node.user, COLOR_PINK) +
            "  " + paint("VERIFIED", COLOR_GREEN) + "  " + paint(node.verified, COLOR_GREEN))
        print(event_branch("PRIOR ROUTER CLEAN", COLOR_ORANGE,
            node.router_clean, router_color))
        index = index + 1
    end for
    print(event_line("AVAILABLE NODES", COLOR_GREEN, nodes.len, COLOR_PINK))
    print(event_branch("CREDENTIALS", COLOR_PINK, "masked", COLOR_PINK))
end function


select_proxy_nodes = function(nodes, count)
    selected = []
    pool = nodes[:]
    while selected.len < count and pool.len > 0
        index = floor(rnd * pool.len)
        selected.push(pool[index])
        pool.remove(index)
    end while
    return selected
end function


root_from_value = function(value)
    if is_shell(value) then return value.host_computer.File("/")
    if is_computer(value) then return value.File("/")
    if is_file(value) then
        current = value
        while current.parent
            current = current.parent
        end while
        return current
    end if
    return null
end function


child_named = function(folder, name)
    if not is_file(folder) then return null
    if not folder.is_folder then return null
    folders = folder.get_folders
    if typeof(folders).lower == "list" then
        for child in folders
            if child.name == name then return child
        end for
    end if
    files = folder.get_files
    if typeof(files).lower == "list" then
        for child in files
            if child.name == name then return child
        end for
    end if
    return null
end function


file_from_root = function(root, path)
    if not is_file(root) then return null
    current = root
    for part in path.split("/")
        part = part.trim
        if part == "" then continue
        current = child_named(current, part)
        if not is_file(current) then return null
    end for
    return current
end function


has_rwx = function(value)
    if not is_file(value) then return false
    if not value.has_permission("r") then return false
    if not value.has_permission("w") then return false
    return value.has_permission("x")
end function


access_level = function(value)
    root = root_from_value(value)
    if not is_file(root) then return "none"
    root_home = file_from_root(root, "/root")
    if has_rwx(root_home) then return "root"
    home = file_from_root(root, "/home")
    if not is_file(home) then return "guest"
    folders = home.get_folders
    if typeof(folders).lower != "list" then return "guest"
    for folder in folders
        if folder.name == "guest" then continue
        if has_rwx(folder) then return "user"
    end for
    return "guest"
end function


show_attack_result = function(value)
    if value == null then
        print(event_branch("NO USABLE RESULT", COLOR_RED, "null", COLOR_RED))
        return
    end if
    kind = typeof(value).lower
    if kind == "number" then
        print(event_branch("PAYLOAD ACCEPTED", COLOR_GREEN, "numeric return", COLOR_PINK))
        return
    end if
    authority = access_level(value)
    if kind == "shell" then
        print(paint("  ╰ ACCESS RETAINED", COLOR_GREEN) + "  " + paint(kind, COLOR_CYAN) +
            "  authority=" + paint(authority, COLOR_PINK))
        return
    end if
    if kind == "computer" or kind == "file" then
        print(paint("  ╰ OBJECT RETAINED", COLOR_GREEN) + "  " + paint(kind, COLOR_CYAN) +
            "  authority=" + paint(authority, COLOR_PINK))
        return
    end if
    print(event_branch("NO USABLE RESULT", COLOR_RED, kind, COLOR_RED))
end function


scrub_source_from_value = function(value)
    root = root_from_value(value)
    if not is_file(root) then return null
    for path in ["/var/silentclean", "/etc/fstab", "/etc/xorg.conf"]
        candidate = file_from_root(root, path)
        if not is_file(candidate) then continue
        if candidate.is_folder then continue
        if candidate.is_binary then continue
        if candidate.has_permission("r") then return candidate
    end for
    etc = file_from_root(root, "/etc")
    if not is_file(etc) then return null
    files = etc.get_files
    if typeof(files).lower != "list" then return null
    for candidate in files
        if candidate.is_folder then continue
        if candidate.is_binary then continue
        if candidate.has_permission("r") then return candidate
    end for
    return null
end function


log_writable_from_value = function(value)
    root = root_from_value(value)
    if not is_file(root) then return false
    log_file = file_from_root(root, "/var/system.log")
    if not is_file(log_file) then return false
    return log_file.has_permission("w")
end function


clean_source = function(source)
    if not is_file(source) then return false
    copied = source.copy("/var", "system.log")
    return copied == 1
end function


clean_value = function(value)
    return clean_source(scrub_source_from_value(value))
end function


unsafe_checks = function(provider, meta_lib, region)
    checks = []
    scan_text = provider.scan_address(meta_lib, region)
    if typeof(scan_text).lower != "string" then return checks
    pieces = scan_text.split("Unsafe check: ")
    if pieces.len < 2 then return checks
    for piece in pieces[1:]
        start = piece.indexOf("<b>")
        finish = piece.indexOf("</b>")
        if start == null or finish == null then continue
        if finish <= start + 3 then continue
        unsafe = piece[start + 3:finish].replace(char(10), "").trim
        if unsafe != "" and checks.indexOf(unsafe) == null then checks.push(unsafe)
    end for
    return checks
end function


stage_local_router_source = function()
    globals.last_router_shell = null
    router = get_router
    if typeof(router).lower != "router" then return null
    provider = include_lib("/lib/metaxploit.so")
    if typeof(provider).lower != "metaxploitlib" then return null
    session = provider.net_use(router.public_ip, 0)
    if typeof(session).lower != "netsession" then return null
    meta_lib = session.dump_lib
    if typeof(meta_lib).lower != "metalib" then return null
    fingerprint = meta_lib.lib_name + "@" + meta_lib.version
    show_auto_action("LIBRARY READY", fingerprint, COLOR_GREEN, COLOR_CYAN)
    regions = provider.scan(meta_lib)
    if typeof(regions).lower != "list" then return null

    for region in regions
        for unsafe in unsafe_checks(provider, meta_lib, region)
            show_attack_attempt(fingerprint, "router LAN payload")
            result = meta_lib.overflow(region, unsafe, router.local_ip)
            show_attack_result(result)
            if is_shell(result) and not is_shell(globals.last_router_shell) then globals.last_router_shell = result
            source = scrub_source_from_value(result)
            if is_file(source) and log_writable_from_value(result) then
                show_auto_action("ROUTER CLEAN SOURCE READY",
                    router.public_ip + "/" + router.local_ip, COLOR_GREEN, COLOR_CYAN)
                return source
            end if
            show_attack_attempt(fingerprint, "plain overflow")
            result = meta_lib.overflow(region, unsafe)
            show_attack_result(result)
            if is_shell(result) and not is_shell(globals.last_router_shell) then globals.last_router_shell = result
            source = scrub_source_from_value(result)
            if is_file(source) and log_writable_from_value(result) then
                show_auto_action("ROUTER CLEAN SOURCE READY",
                    router.public_ip + "/" + router.local_ip, COLOR_GREEN, COLOR_CYAN)
                return source
            end if
        end for
    end for
    show_auto_action("ROUTER CLEAN SOURCE UNAVAILABLE",
        router.public_ip + "/" + router.local_ip, COLOR_ORANGE, COLOR_CYAN)
    return null
end function


root_helper_mode = function()
    bridge = get_custom_object
    bridge.rg_router_source = null
    bridge.rg_helper_status = "root-running"
    password = bridge.rg_router_password
    bridge.rg_router_password = ""
    if typeof(password).lower != "string" or password == "" then
        bridge.rg_helper_status = "missing-router-password"
        exit
    end if
    root_shell = get_shell("root", password)
    password = ""
    if not is_shell(root_shell) then
        bridge.rg_helper_status = "router-root-login-failed"
        exit
    end if
    source = scrub_source_from_value(root_shell)
    if is_file(source) and log_writable_from_value(root_shell) then
        bridge.rg_router_source = source
        bridge.rg_helper_status = "root-ready"
    else
        bridge.rg_helper_status = "router-root-log-unavailable"
    end if
    exit
end function


helper_mode = function()
    bridge = get_custom_object
    bridge.rg_router_source = null
    bridge.rg_helper_status = "running"
    source = stage_local_router_source
    if is_file(source) then
        bridge.rg_router_source = source
        bridge.rg_helper_status = "ready"
    else
        bridge.rg_helper_status = "no-router-clean-object"
    end if
    exit
end function


writable_folder = function(shell)
    if not is_shell(shell) then return null
    computer = shell.host_computer
    root = computer.File("/root")
    if is_file(root) and root.has_permission("w") and root.has_permission("x") then return root
    homes = computer.File("/home")
    if not is_file(homes) then return null
    folders = homes.get_folders
    if typeof(folders).lower != "list" then return null
    for folder in folders
        if folder.has_permission("w") and folder.has_permission("x") then return folder
    end for
    return null
end function


deploy_helper = function(source_shell, source_path, remote_shell)
    work = writable_folder(remote_shell)
    if not is_file(work) then return ""
    source_file = source_shell.host_computer.File(source_path)
    if not is_file(source_file) then return ""
    copied = source_shell.scp(source_path, work.path, remote_shell)
    remote_path = join_path(work.path, source_file.name)
    if not is_file(remote_shell.host_computer.File(remote_path)) then return ""
    return remote_path
end function


stage_remote_router_source = function(remote_shell, helper_path)
    if not is_shell(remote_shell) then return null
    if helper_path == "" then return null
    bridge = get_custom_object
    bridge.rg_router_source = null
    bridge.rg_helper_status = "waiting"
    remote_shell.launch(helper_path, "--router-clean-helper")
    waited = 0
    while waited < HELPER_WAIT_SECONDS
        if bridge.rg_helper_status != "waiting" and bridge.rg_helper_status != "running" then break
        wait(0.2)
        waited = waited + 0.2
    end while
    source = bridge.rg_router_source
    bridge.rg_router_source = null
    if is_file(source) then return source
    return null
end function


stage_router_root_source = function(guest_shell, password)
    if not is_shell(guest_shell) then return null
    if typeof(password).lower != "string" or password == "" then return null
    helper_path = deploy_helper(globals.local_shell, program_path, guest_shell)
    if helper_path == "" then return null
    bridge = get_custom_object
    bridge.rg_router_source = null
    bridge.rg_router_password = password
    bridge.rg_helper_status = "waiting"
    guest_shell.launch(helper_path, "--router-root-helper")
    waited = 0
    while waited < HELPER_WAIT_SECONDS
        if bridge.rg_helper_status != "waiting" and bridge.rg_helper_status != "root-running" then break
        wait(0.2)
        waited = waited + 0.2
    end while
    bridge.rg_router_password = ""
    source = bridge.rg_router_source
    bridge.rg_router_source = null

    // The private controller binary contains HOME_ROUTER_PASSWORD. Remove the
    // guest-access router copy before the final log replacement.
    helper_file = guest_shell.host_computer.File(helper_path)
    if is_file(helper_file) then helper_file.delete
    if is_file(source) then return source
    return null
end function


stage_computer_source = function(shell)
    if not is_shell(shell) then return null
    source = scrub_source_from_value(shell)
    if not is_file(source) or not log_writable_from_value(shell) then return null
    return source
end function


delete_remote_helper = function(shell, path)
    if not is_shell(shell) or typeof(path).lower != "string" or path == "" then return
    file = shell.host_computer.File(path)
    if is_file(file) then file.delete
end function


reset_proxy_objects = function()
    globals.proxy_nodes = []
    globals.proxy_shells = []
    globals.proxy_computer_sources = []
    globals.proxy_router_sources = []
    globals.proxy_helper_paths = []
    globals.proxy_seed_helper_path = ""
    globals.proxy_manifest_active = false
    globals.proxy_manifest_count = 0
    globals.proxy_manifest_endpoint = "none"
end function


remove_proxy_seed_helper = function()
    if globals.proxy_seed_helper_path == "" then return true
    cleaned = true
    if globals.shells.len > 0 then
        delete_remote_helper(globals.shells[-1], globals.proxy_seed_helper_path)
        // File deletion creates a new system.log entry. Give that event time to
        // settle, then make the retained cleaner the final filesystem action.
        wait(FINALIZER_WAIT_SECONDS)
        cleaned = clean_stage(globals.shells.len - 1)
    end if
    globals.proxy_seed_helper_path = ""
    return cleaned
end function


stage_proxy_helper_seed = function()
    if globals.shells.len < 2 then return ""
    helper = globals.local_computer.File(PROXY_HELPER_SOURCE)
    if not is_file(helper) or helper.is_folder then
        print(event_line("PROXY HELPER MISSING", COLOR_RED, PROXY_HELPER_SOURCE, COLOR_ORANGE))
        print(event_branch("REQUIRED ACTION", COLOR_ORANGE,
            "compile autoroute-proxy-helper before extend", COLOR_ORANGE))
        return ""
    end if

    source_shell = globals.local_shell
    source_path = PROXY_HELPER_SOURCE
    staged_shell = null
    staged_path = ""
    index = 1
    while index < globals.shells.len
        remote_shell = globals.shells[index]
        next_path = deploy_helper(source_shell, source_path, remote_shell)
        if next_path == "" then
            delete_remote_helper(staged_shell, staged_path)
            if is_shell(staged_shell) and staged_path != "" then
                wait(FINALIZER_WAIT_SECONDS)
                clean_stage(index - 1)
            end if
            print(event_line("PROXY HELPER STAGING", COLOR_RED,
                "owned-route propagation failed", COLOR_RED))
            return ""
        end if
        delete_remote_helper(staged_shell, staged_path)
        if is_shell(staged_shell) and staged_path != "" then
            // The removed copy is itself logged on this owned hop. Clean only
            // after deletion so no helper-removal entry survives propagation.
            wait(FINALIZER_WAIT_SECONDS)
            clean_stage(index - 1)
        end if
        staged_shell = remote_shell
        staged_path = next_path
        source_shell = remote_shell
        source_path = next_path
        index = index + 1
    end while
    return staged_path
end function


proxy_shell_valid = function(shell, node)
    if not is_shell(shell) then return false
    computer = shell.host_computer
    if not is_computer(computer) or computer.public_ip != node.ip then return false
    root = computer.File("/root")
    if not is_file(root) or not root.is_folder then return false
    if not root.has_permission("r") or not root.has_permission("w") then return false
    return root.has_permission("x")
end function


clean_proxy_stage = function(index)
    if index < 0 or index >= globals.proxy_nodes.len then return false
    node = globals.proxy_nodes[index]
    computer_ok = false
    router_ok = false
    if index < globals.proxy_computer_sources.len then
        computer_ok = clean_source(globals.proxy_computer_sources[index])
    end if
    if index < globals.proxy_router_sources.len then
        router_ok = clean_source(globals.proxy_router_sources[index])
    end if
    computer_color = COLOR_RED
    router_color = COLOR_ORANGE
    if computer_ok then computer_color = COLOR_GREEN
    if router_ok then router_color = COLOR_GREEN
    print(paint("◆ CLEANUP ", COLOR_ORANGE) + paint("[PROXY " + (index + 1) + "]", COLOR_PINK) +
        "  " + paint(node.ip, COLOR_CYAN))
    print(event_branch("COMPUTER", COLOR_ORANGE,
        ["FAIL", "clean"][computer_ok], computer_color) +
        "  " + paint("ROUTER", COLOR_ORANGE) + "  " +
        paint(["best-effort", "clean"][router_ok], router_color))
    return computer_ok and router_ok
end function


clean_proxy_all = function()
    if globals.proxy_nodes.len == 0 then return true
    route_heading("PROXY-LAYER CLEANUP", globals.proxy_nodes.len + " HOPS")
    all_ok = true
    index = globals.proxy_nodes.len - 1
    while index >= 0
        if not clean_proxy_stage(index) then all_ok = false
        index = index - 1
    end while
    if all_ok then
        print(event_line("PROXY CLEANUP COMPLETE", COLOR_GREEN,
            "computer and router logs replaced", COLOR_GREEN))
    else
        print(event_line("PROXY CLEANUP PARTIAL", COLOR_ORANGE,
            "unavailable routers remain best-effort risk", COLOR_ORANGE))
    end if
    return all_ok
end function


collapse_proxy = function()
    if globals.proxy_nodes.len == 0 then
        print(event_line("OWNED ROUTE", COLOR_GREEN, "already active", COLOR_GREEN))
        manifest_ok = delete_active_proxy_manifest
        wait(FINALIZER_WAIT_SECONDS)
        owned_ok = clean_all
        return manifest_ok and owned_ok
    end if
    route_heading("COLLAPSING PROXY LAYER", globals.proxy_nodes.len + " HOPS")
    proxy_ok = true
    index = globals.proxy_nodes.len - 1
    while index >= 0
        if index < globals.proxy_helper_paths.len then
            delete_remote_helper(globals.proxy_shells[index], globals.proxy_helper_paths[index])
        end if
        globals.proxy_shells[index] = null
        wait(FINALIZER_WAIT_SECONDS)
        if not clean_proxy_stage(index) then proxy_ok = false
        index = index - 1
    end while
    manifest_ok = delete_active_proxy_manifest
    // Removing the handoff is logged on the final owned server. The owned
    // finalizer therefore runs after this deletion and remains the last move.
    wait(FINALIZER_WAIT_SECONDS)
    reset_proxy_objects
    owned_ok = clean_all
    if proxy_ok and manifest_ok and owned_ok then
        print(event_line("COLLAPSE COMPLETE", COLOR_GREEN, "owned route restored", COLOR_GREEN))
    else
        print(event_line("COLLAPSE PARTIAL", COLOR_ORANGE,
            "owned route restored with cleanup warnings", COLOR_ORANGE))
    end if
    return owned_ok
end function


extend_proxy = function(requested)
    if globals.proxy_nodes.len > 0 then
        print(event_line("PROXY EXTENSION REFUSED", COLOR_RED,
            "active proxy layer must collapse first", COLOR_RED))
        return false
    end if
    if globals.shells.len < 2 then
        print(event_line("PROXY EXTENSION REFUSED", COLOR_RED,
            "owned route not ready", COLOR_RED))
        return false
    end if
    // A previous interrupted run may have left a handoff behind. Remove it
    // before selecting a new route, then cover that deletion on Server B.
    if not delete_active_proxy_manifest(true) then
        print(event_line("AUTODEPLOY HANDOFF", COLOR_RED,
            "stale manifest retirement failed", COLOR_RED))
        return false
    end if
    wait(FINALIZER_WAIT_SECONDS)
    if not clean_stage(globals.shells.len - 1) then
        print(event_line("PROXY EXTENSION REFUSED", COLOR_RED,
            "final owned-server cleanup failed", COLOR_RED))
        return false
    end if
    available = load_autonet_nodes(globals.shells[-1])
    if available.len == 0 then
        print(event_line("PROXY EXTENSION REFUSED", COLOR_RED,
            "no verified AutoNet nodes available", COLOR_RED))
        return false
    end if
    count = requested
    if count > available.len then
        print(event_line("PROXY COUNT REDUCED", COLOR_ORANGE,
            "available pool is smaller than requested", COLOR_ORANGE))
        print(event_branch("REQUESTED", COLOR_PINK, count, COLOR_PINK) +
            "  " + paint("AVAILABLE", COLOR_PINK) + "  " + paint(available.len, COLOR_PINK))
        count = available.len
    end if
    selected = select_proxy_nodes(available, count)
    reset_proxy_objects
    globals.proxy_seed_helper_path = stage_proxy_helper_seed
    if globals.proxy_seed_helper_path == "" then return false
    previous_shell = globals.shells[-1]
    previous_helper = globals.proxy_seed_helper_path

    route_heading("EXTENDING PROXY LAYER", selected.len + " HOPS")
    for node in selected
        print(paint("◆ CONNECT ", COLOR_PURPLE) +
            paint("[" + (globals.proxy_nodes.len + 1) + "/" + selected.len + "]", COLOR_PINK) +
            "  " + paint("proxy route", COLOR_PURPLE))
        print(event_branch("ENDPOINT", COLOR_CYAN, node.ip + ":" + node.port, COLOR_CYAN) +
            "  " + paint("AUTHORITY", COLOR_PINK) + "  " + paint(node.user, COLOR_PINK))
        connected = previous_shell.connect_service(node.ip, node.port, node.user,
            node.password, "ssh")
        if not proxy_shell_valid(connected, node) then
            print(event_line("CONNECTION FAILED", COLOR_RED, node.ip + ":" + node.port, COLOR_CYAN))
            print(event_branch("RESIDUAL RISK", COLOR_RED,
                "failed candidate may retain connection evidence", COLOR_RED))
            remove_proxy_seed_helper
            collapse_proxy
            return false
        end if

        computer_source = stage_computer_source(connected)
        helper_path = deploy_helper(previous_shell, previous_helper, connected)
        router_source = stage_remote_router_source(connected, helper_path)
        if not is_file(computer_source) then
            delete_remote_helper(connected, helper_path)
            connected = null
            wait(FINALIZER_WAIT_SECONDS)
            print(event_line("PROXY EXTENSION REFUSED", COLOR_RED,
                "computer cleanup source unavailable", COLOR_RED))
            remove_proxy_seed_helper
            collapse_proxy
            return false
        end if

        globals.proxy_nodes.push(node)
        globals.proxy_shells.push(connected)
        globals.proxy_computer_sources.push(computer_source)
        globals.proxy_router_sources.push(router_source)
        globals.proxy_helper_paths.push(helper_path)
        print(paint("  ╰ ACCESS RETAINED", COLOR_GREEN) + "  " +
            paint("shell", COLOR_CYAN) + "  authority=" + paint(node.user, COLOR_PINK))

        previous_index = globals.proxy_nodes.len - 2
        if previous_index < 0 then
            remove_proxy_seed_helper
        else
            delete_remote_helper(globals.proxy_shells[previous_index],
                globals.proxy_helper_paths[previous_index])
            globals.proxy_helper_paths[previous_index] = ""
            wait(FINALIZER_WAIT_SECONDS)
            clean_proxy_stage(previous_index)
        end if
        previous_shell = connected
        previous_helper = helper_path
    end for

    last = globals.proxy_nodes.len - 1
    delete_remote_helper(globals.proxy_shells[last], globals.proxy_helper_paths[last])
    globals.proxy_helper_paths[last] = ""
    remove_proxy_seed_helper
    wait(FINALIZER_WAIT_SECONDS)
    clean_proxy_stage(last)
    if not write_active_proxy_manifest then
        print(event_line("AUTODEPLOY HANDOFF", COLOR_RED,
            "publication failed; collapsing proxy layer", COLOR_RED))
        collapse_proxy
        return false
    end if
    // Publication changes files on Server B, so cover that write before the
    // route is advertised as ready. AutoDeploy may now read the stable file.
    wait(FINALIZER_WAIT_SECONDS)
    if not clean_stage(globals.shells.len - 1) then
        print(event_line("AUTODEPLOY HANDOFF", COLOR_ORANGE,
            "ready with incomplete final owned-server cleanup", COLOR_ORANGE))
    end if
    print(event_line("PROXY ROUTE READY", COLOR_GREEN,
        globals.proxy_nodes.len + " active hops", COLOR_GREEN))
    print(event_branch("CURRENT", COLOR_PINK, current_endpoint_identity, COLOR_CYAN))
    open_final_terminal
    return true
end function


clean_stage = function(index)
    label = "home"
    if index > 0 then label = globals.hops[index - 1].alias
    computer_ok = clean_value(globals.shells[index])
    router_ok = false
    if index < globals.router_sources.len then router_ok = clean_source(globals.router_sources[index])
    computer_color = COLOR_RED
    router_color = COLOR_RED
    if computer_ok then computer_color = COLOR_GREEN
    if router_ok then router_color = COLOR_GREEN
    print(event_line("CLEANUP", COLOR_ORANGE, label, COLOR_CYAN))
    print(event_branch("COMPUTER", COLOR_ORANGE,
        ["FAIL", "clean"][computer_ok], computer_color) +
        "  " + paint("ROUTER", COLOR_ORANGE) + "  " +
        paint(["FAIL", "clean"][router_ok], router_color))
    return computer_ok and router_ok
end function


clean_all = function()
    route_heading("OWNED-ROUTE CLEANUP", globals.shells.len + " STAGES")
    all_ok = true
    index = globals.shells.len - 1
    while index >= 0
        if not clean_stage(index) then all_ok = false
        index = index - 1
    end while
    if all_ok then
        print(event_line("OWNED ROUTE CLEAN", COLOR_GREEN, "all logs replaced", COLOR_GREEN))
    else
        print(event_line("OWNED CLEANUP PARTIAL", COLOR_RED,
            "FAIL surfaces require attention", COLOR_RED))
    end if
    return all_ok
end function


clean_everything = function()
    proxy_ok = clean_proxy_all
    owned_ok = clean_all
    return proxy_ok and owned_ok
end function


show_banner = function()
    print("          " + paint("◆", COLOR_PINK) + "                 " + paint("◆", COLOR_CYAN))
    print("          " + paint("│", COLOR_PURPLE) + "                 " + paint("│", COLOR_CYAN))
    print(paint("◆─────────", COLOR_PURPLE) + paint("┴", COLOR_PINK) +
        paint("────────", COLOR_PURPLE) + paint("┬", COLOR_GREEN) +
        paint("──────────────────◆", COLOR_CYAN))
    print(paint("╰────────────", COLOR_PURPLE) + paint("[ AUTOROUTE ]", COLOR_PINK) +
        paint("────────────╯", COLOR_PURPLE))
    print("            " + paint("╰──────", COLOR_PURPLE) + paint("◆", COLOR_GREEN) +
        paint("──────╯", COLOR_CYAN))
    print("          " + paint("OWNED", COLOR_CYAN) + "  " +
        paint("ROUTE", COLOR_GREEN) + "  " + paint("PROXY", COLOR_PINK))
    print("       " + paint("ROWAN CIRCUIT // ", COLOR_PURPLE) +
        paint(SCRIPT_VERSION, COLOR_CYAN))
end function


route_origin_identity = function()
    if not is_computer(globals.local_computer) then return "unknown"
    return globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
end function


owned_endpoint_identity = function()
    if globals.hops.len == 0 then return route_origin_identity
    return globals.hops[-1].ip
end function


current_endpoint_identity = function()
    if globals.proxy_nodes.len > 0 then return globals.proxy_nodes[-1].ip
    return owned_endpoint_identity
end function


console_prompt = function()
    handoff = "EMPTY"
    handoff_color = COLOR_ORANGE
    if globals.proxy_manifest_active then
        handoff = "HANDOFF READY"
        handoff_color = COLOR_GREEN
    end if
    print(paint("╭─◆ AUTOROUTE ◆─", COLOR_PURPLE) +
        paint("[OWNED ", COLOR_CYAN) + paint(globals.hops.len, COLOR_PINK) +
        paint("]", COLOR_CYAN) + "─" +
        paint("[PROXY ", COLOR_PINK) + paint(globals.proxy_nodes.len, COLOR_PINK) +
        paint("]", COLOR_PINK) + "─" +
        paint("[" + handoff + "]", handoff_color))
    return paint("╰─ORIGIN ", COLOR_ORANGE) + paint(route_origin_identity, COLOR_CYAN) +
        paint(" ─▶ OWNED ", COLOR_GREEN) + paint(owned_endpoint_identity, COLOR_CYAN) +
        paint(" ─▶ CURRENT ", COLOR_PINK) + paint(current_endpoint_identity, COLOR_CYAN) +
        paint(" ─▶ ", COLOR_GREEN)
end function


open_final_terminal = function()
    if globals.shells.len < 2 then return false
    shell = globals.shells[-1]
    if globals.proxy_shells.len > 0 then shell = globals.proxy_shells[-1]
    computer = shell.host_computer
    terminal = computer.File("/usr/bin/Terminal.exe")
    if not is_file(terminal) then terminal = computer.File("/bin/Terminal.exe")
    if not is_file(terminal) then
        print(event_line("TERMINAL REFUSED", COLOR_RED,
            "Terminal.exe missing on current endpoint", COLOR_RED))
        return false
    end if
    shell.launch(terminal.path)
    print(event_line("TERMINAL REQUESTED", COLOR_GREEN,
        current_endpoint_identity, COLOR_CYAN))
    return true
end function


reset_route_objects = function()
    globals.shells = []
    globals.router_sources = []
    globals.helper_paths = []
end function


build_route = function()
    reset_route_objects
    globals.shells.push(globals.local_shell)
    home_router_source = stage_local_router_source
    if not is_file(home_router_source) and HOME_ROUTER_PASSWORD != "" then
        home_router_source = stage_router_root_source(globals.last_router_shell, HOME_ROUTER_PASSWORD)
    end if
    globals.router_sources.push(home_router_source)
    globals.helper_paths.push(program_path)

    previous_shell = globals.local_shell
    previous_helper = program_path
    number = 0
    for hop in globals.hops
        print(paint("◆ CONNECT ", COLOR_PURPLE) +
            paint("[" + (number + 1) + "/" + globals.hops.len + "]", COLOR_PINK) +
            "  " + paint("owned route", COLOR_PURPLE))
        print(event_branch("ALIAS", COLOR_PINK, hop.alias, COLOR_PINK) +
            "  " + paint("ENDPOINT", COLOR_CYAN) + "  " +
            paint(hop.ip + ":" + hop.port, COLOR_CYAN))
        print(event_branch("AUTHORITY", COLOR_PINK, hop.user, COLOR_PINK))
        connected = previous_shell.connect_service(hop.ip, hop.port, hop.user, hop.password, "ssh")
        if not is_shell(connected) then
            print(event_line("CONNECTION FAILED", COLOR_RED, hop.alias, COLOR_PINK))
            print(event_branch("ENDPOINT", COLOR_CYAN, hop.ip + ":" + hop.port, COLOR_CYAN))
            clean_all
            return false
        end if

        helper_path = deploy_helper(previous_shell, previous_helper, connected)
        router_source = stage_remote_router_source(connected, helper_path)
        globals.shells.push(connected)
        globals.router_sources.push(router_source)
        globals.helper_paths.push(helper_path)
        print(paint("  ╰ ACCESS RETAINED", COLOR_GREEN) + "  " +
            paint("shell", COLOR_CYAN) + "  authority=" + paint(hop.user, COLOR_PINK))

        // Once the next hop exists, the previous computer and router are no
        // longer needed for route construction. Replace their logs immediately.
        clean_stage(number)
        previous_shell = connected
        previous_helper = helper_path
        number = number + 1
    end for

    clean_stage(globals.shells.len - 1)
    print(event_line("OWNED ROUTE READY", COLOR_GREEN,
        globals.hops.len + " hops", COLOR_GREEN))
    print(event_branch("CURRENT", COLOR_PINK, current_endpoint_identity, COLOR_CYAN))
    return true
end function


show_status = function()
    route_heading("AUTOROUTE STATUS", "LIVE ROUTE")
    print(event_line("ORIGIN", COLOR_ORANGE, route_origin_identity, COLOR_CYAN))
    print(event_branch("CURRENT", COLOR_PINK, current_endpoint_identity, COLOR_CYAN))
    show_route(globals.hops)
    print(event_line("OWNED SHELLS", COLOR_GREEN, globals.shells.len, COLOR_PINK))
    index = 0
    while index < globals.shells.len
        label = "home"
        if index > 0 then label = globals.hops[index - 1].alias
        router_state = "missing"
        if index < globals.router_sources.len and is_file(globals.router_sources[index]) then router_state = "ready"
        color = COLOR_RED
        if router_state == "ready" then color = COLOR_GREEN
        print(event_branch("ROUTER CLEAN SOURCE", COLOR_ORANGE, label, COLOR_CYAN) +
            "  " + paint("STATE", COLOR_DIM) + "  " + paint(router_state, color))
        index = index + 1
    end while
    print(event_line("PROXY LAYER", COLOR_PURPLE,
        globals.proxy_nodes.len + " active hops", COLOR_PINK))
    index = 0
    while index < globals.proxy_nodes.len
        node = globals.proxy_nodes[index]
        computer_state = "missing"
        router_state = "best-effort"
        if index < globals.proxy_computer_sources.len and
            is_file(globals.proxy_computer_sources[index]) then computer_state = "ready"
        if index < globals.proxy_router_sources.len and
            is_file(globals.proxy_router_sources[index]) then router_state = "ready"
        computer_color = COLOR_RED
        router_color = COLOR_ORANGE
        if computer_state == "ready" then computer_color = COLOR_GREEN
        if router_state == "ready" then router_color = COLOR_GREEN
        print(paint("◆ PROXY ", COLOR_PURPLE) + paint("[" + (index + 1) + "]", COLOR_PINK) +
            "  " + paint(node.ip + ":" + node.port, COLOR_CYAN))
        print(event_branch("COMPUTER CLEAN", COLOR_ORANGE, computer_state, computer_color) +
            "  " + paint("ROUTER CLEAN", COLOR_ORANGE) + "  " +
            paint(router_state, router_color))
        index = index + 1
    end while
    handoff_state = "empty"
    handoff_color = COLOR_ORANGE
    if globals.proxy_manifest_active then
        handoff_state = "ready"
        handoff_color = COLOR_GREEN
    end if
    print(event_line("AUTODEPLOY HANDOFF", COLOR_PURPLE, handoff_state, handoff_color))
    print(event_branch("NODES", COLOR_PINK, globals.proxy_manifest_count, COLOR_PINK) +
        "  " + paint("ENDPOINT", COLOR_CYAN) + "  " +
        paint(globals.proxy_manifest_endpoint, COLOR_CYAN))
    print(event_branch("MANIFEST", COLOR_ORANGE, ACTIVE_PROXY_ROUTE_PATH, COLOR_ORANGE))
    print(event_branch("CREDENTIALS", COLOR_PINK,
        ["absent", "masked"][globals.proxy_manifest_active], COLOR_PINK))
end function


show_help = function()
    print("")
    print(paint("AutoRoute ", COLOR_PURPLE) + paint(SCRIPT_VERSION, COLOR_CYAN) +
        paint(" — owned route, proxy extension, and AutoDeploy handoff", COLOR_DIM))
    print(paint("Build the trusted SSH route once, then extend through verified AutoNet nodes.", COLOR_DIM))
    print(paint("Collapse in reverse order when the temporary proxy layer is finished.", COLOR_DIM))
    print("")
    print(paint("Commands", COLOR_PURPLE))
    print("  " + paint("nodes", COLOR_CYAN) +
        paint("                 list verified AutoNet proxy nodes", COLOR_DIM))
    print("  " + paint("extend", COLOR_PURPLE) + " " + paint("[count]", COLOR_PINK) +
        paint("        add 1-" + MAX_PROXY_HOPS + " proxy hops and publish the handoff", COLOR_DIM))
    print("  " + paint("collapse", COLOR_ORANGE) +
        paint("              retire the handoff, clean proxies, and return owned", COLOR_DIM))
    print("  " + paint("clean / clog / logs", COLOR_ORANGE) +
        paint("  replace logs across every active layer", COLOR_DIM))
    print("  " + paint("open", COLOR_CYAN) +
        paint("                  open another current-route terminal", COLOR_DIM))
    print("  " + paint("status", COLOR_CYAN) +
        paint("                show route, handoff, and cleaner readiness", COLOR_DIM))
    print("  " + paint("rebuild", COLOR_ORANGE) +
        paint("               collapse, clean, and reconnect the owned route", COLOR_DIM))
    print("  " + paint("setup", COLOR_ORANGE) +
        paint("                 collapse and replace the saved owned route", COLOR_DIM))
    print("  " + paint("help", COLOR_PURPLE) +
        paint("                  show this guide", COLOR_DIM))
    print("  " + paint("quit", COLOR_RED) +
        paint("                  final cleanup and exit", COLOR_DIM))
    print("")
    print(event_line("OWNED ROUTE", COLOR_PURPLE, OWNED_ROUTE_PATH, COLOR_ORANGE))
    print(event_line("AUTONET NODES", COLOR_CYAN, AUTONET_NODE_ROOT, COLOR_ORANGE))
    print(event_line("AUTODEPLOY HANDOFF", COLOR_GREEN,
        ACTIVE_PROXY_ROUTE_PATH, COLOR_ORANGE))
    print(event_branch("CREDENTIALS", COLOR_PINK,
        "masked in terminal output", COLOR_PINK))
end function


if params.len > 0 then
    if params[0] == "--router-clean-helper" then helper_mode
    if params[0] == "--router-root-helper" then root_helper_mode
end if

globals.local_shell = get_shell
globals.local_computer = globals.local_shell.host_computer
globals.hops = []
globals.last_router_shell = null
globals.visual_attack_index = 0
reset_route_objects
reset_proxy_objects

show_banner
entered_pin = user_input(route_pin_signature, 1)
if PIN != "" and entered_pin != PIN then exit(fatal_line("Incorrect PIN."))
show_help
if not ensure_network_layout then exit(fatal_line("Could not create /root/autoscripts/network."))
if params.len > 0 and params[0].lower == "setup" then globals.hops = setup_route else globals.hops = load_route
if typeof(globals.hops).lower != "list" then globals.hops = setup_route
if typeof(globals.hops).lower != "list" then exit(fatal_line("Route setup was not completed."))
show_route(globals.hops)

if not build_route then exit(fatal_line("AutoRoute could not build the saved route."))
open_final_terminal

while true
    raw_command = user_input(console_prompt).trim.lower
    words = []
    for word in raw_command.split(" ")
        if word.trim != "" then words.push(word.trim)
    end for
    command = ""
    if words.len > 0 then command = words[0]
    if command == "clean" or command == "clog" or command == "logs" then
        clean_everything
    else if command == "nodes" then
        show_autonet_nodes
    else if command == "extend" or command == "proxy" then
        requested = DEFAULT_PROXY_HOPS
        if words.len > 1 then
            if not digits_only(words[1]) then
                print(event_line("USAGE", COLOR_RED,
                    "extend [1-" + MAX_PROXY_HOPS + "]", COLOR_ORANGE))
                continue
            end if
            requested = words[1].to_int
        end if
        if requested < 1 or requested > MAX_PROXY_HOPS then
            print(event_line("PROXY COUNT REFUSED", COLOR_RED,
                "expected 1-" + MAX_PROXY_HOPS, COLOR_RED))
        else
            extend_proxy(requested)
        end if
    else if command == "collapse" then
        if collapse_proxy then open_final_terminal
    else if command == "status" then
        show_status
    else if command == "open" then
        open_final_terminal
    else if command == "rebuild" then
        collapse_proxy
        if build_route then open_final_terminal
    else if command == "setup" then
        collapse_proxy
        route = setup_route
        if typeof(route).lower == "list" then
            globals.hops = route
            if build_route then open_final_terminal
        end if
    else if command == "help" or command == "?" then
        show_help
    else if command == "quit" or command == "exit" or command == "q" then
        collapse_proxy
        print(event_line("AUTOROUTE CLOSED", COLOR_PURPLE,
            "owned route cleanup complete", COLOR_GREEN))
        exit
    else if command != "" then
        print(event_line("UNKNOWN COMMAND", COLOR_RED, "type help", COLOR_ORANGE))
    end if
end while
