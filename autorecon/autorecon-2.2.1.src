usage_line = function(usage)
    return event_line("USAGE", COLOR_RED, usage, COLOR_ORANGE)
end function


dispatch = function(words)
    if words.len == 0 then return true
    command = words[0].lower
    if command == "hunt" then
        if words.len > 1 and words[1].lower == "focus" then
            if words.len < 3 then
                print(usage_line("hunt focus <library> [version] [count]"))
                print(event_branch("OR", COLOR_ORANGE,
                    "hunt focus missing [count]", COLOR_ORANGE))
                return false
            end if
            if words[2].lower == "missing" then
                count = DEFAULT_HUNT_COUNT
                if words.len > 3 then
                    if not digits_only(words[3]) then
                        print(usage_line("hunt focus missing [count]"))
                        return false
                    end if
                    count = words[3].to_int
                end if
                if words.len > 4 then
                    print(usage_line("hunt focus missing [count]"))
                    return false
                end if
                return hunt_with_focus("discover", "", "", count)
            end if
            library = words[2]
            version = ""
            count = DEFAULT_HUNT_COUNT
            if words.len > 3 then
                if digits_only(words[3]) then count = words[3].to_int else version = words[3]
            end if
            if words.len > 4 then
                if not digits_only(words[4]) then
                    print(usage_line("hunt focus <library> [version] [count]"))
                    return false
                end if
                count = words[4].to_int
            end if
            if words.len > 5 then
                print(usage_line("hunt focus <library> [version] [count]"))
                return false
            end if
            return hunt_with_focus("missing", library, version, count)
        end if
        count = DEFAULT_HUNT_COUNT
        if words.len > 1 and digits_only(words[1]) then count = words[1].to_int
        return hunt(count)
    else if command == "target" then
        if words.len < 2 or not is_valid_ip(words[1]) then
            print(usage_line("target <ip> [port]"))
            return false
        end if
        port = 0
        if words.len > 2 and digits_only(words[2]) then port = words[2].to_int
        reset_stats
        result = scan_target(words[1], port)
        save_research
        show_summary
        return result
    else if command == "focus" then
        if words.len < 2 then
            show_focus
            return true
        end if
        if words[1].lower == "all" then
            set_focus("all")
            return true
        end if
        if words[1].lower == "missing" then
            if words.len < 3 then
                print(usage_line("focus missing <library> [version]"))
                return false
            end if
            version = ""
            if words.len > 3 then version = words[3]
            set_focus("missing", words[2], version)
            return true
        end if
        version = ""
        if words.len > 2 then version = words[2]
        set_focus("library", words[1], version)
        return true
    else if command == "rescan" then
        if words.len < 2 then
            print(usage_line("rescan <library> [version]"))
            return false
        end if
        version = ""
        if words.len > 2 then version = words[2]
        set_focus("force", words[1], version)
        return true
    else if command == "huntlib" then
        if words.len < 2 then
            print(usage_line("huntlib <library> [version] [count]"))
            return false
        end if
        library = words[1]
        version = ""
        count = DEFAULT_HUNT_COUNT
        if words.len > 2 then
            if digits_only(words[2]) then count = words[2].to_int else version = words[2]
        end if
        if words.len > 3 and digits_only(words[3]) then count = words[3].to_int
        return hunt_with_focus("missing", library, version, count)
    else if command == "coverage" then
        if words.len < 2 then
            print(usage_line("coverage <library> [version]"))
            return false
        end if
        version = ""
        if words.len > 2 then version = words[2]
        show_coverage(words[1], version)
        return true
    else if command == "find" then
        if words.len < 3 or words.len > 4 then
            print(usage_line("find <library> <version> [max-attempts]"))
            return false
        end if
        attempts = 0
        if words.len > 3 then
            if not digits_only(words[3]) then
                print(event_line("LOCATOR REFUSED", COLOR_RED,
                    "maximum attempts must be a whole number", COLOR_ORANGE))
                return false
            end if
            attempts = words[3].to_int
        end if
        return find_exact_library(words[1], words[2], attempts)
    else if command == "download" then
        return download_database_seed
    else if command == "upload" then
        return upload_outbox
    else if command == "sync" then
        return sync_database
    else if command == "export" then
        return export_coverage
    else if command == "import" then
        return sync_database
    else if command == "outbox" then
        show_outbox
        return true
    else if command == "fresh" then
        reset_stats
        set_focus("all")
        diag("fresh run state | database and outbox preserved")
        return true
    else if command == "status" then
        show_status
        return true
    else if command == "help" or command == "?" or command == "-h" or
        command == "--help" then
        show_help
        return true
    else if command == "quit" or command == "exit" or command == "q" then
        return false
    end if
    print(event_line("UNKNOWN COMMAND", COLOR_RED, "type help", COLOR_ORANGE))
    return true
end function


if params.len > 0 and params[0] == "--router-clean-helper" then router_helper_mode

globals.local_shell = get_shell
globals.local_computer = globals.local_shell.host_computer
globals.metaxploit = include_lib("/lib/metaxploit.so")
globals.execution_computer_source = null
globals.execution_router_source = null
globals.seen_targets = {}
globals.last_locator = null
globals.locator_last_version = "none"
reset_stats

if typeof(globals.metaxploit).lower != "metaxploitlib" then
    exit(fatal_line("MetaSploit provider unavailable."))
end if
if not init_layout then exit(fatal_line("Could not create /root/autoscripts/autorecon."))
if not init_log then exit(fatal_line("Diagnostic log unavailable."))

startup_words = []
for word in params
    if word.trim != "" then startup_words.push(word.trim)
end for

show_banner
print(event_line("TASK QUEUE", COLOR_PURPLE, TASK_ROOT, COLOR_ORANGE))
print(event_line("DIAGNOSTICS", COLOR_PURPLE, LOG_ROOT, COLOR_ORANGE))
print(event_line("RESEARCH OUTBOX", COLOR_PURPLE, OUTBOX_ROOT, COLOR_ORANGE))

entered_pin = user_input(recon_pin_signature, 1)
if PIN != "" then
    if entered_pin != PIN then exit(fatal_line("Incorrect PIN."))
end if

init_vulns
load_focus
if globals.authoritative_db then
    print(event_line("SHARED ACVDB3", COLOR_GREEN, VULN_DB_ROOT, COLOR_PURPLE))
    print(event_branch("DATABASE ROLE", COLOR_GREEN,
        "authoritative master", COLOR_GREEN))
else if globals.database_role == "endpoint" then
    print(event_line("COVERAGE SEED", COLOR_PURPLE, SYNC_ROOT, COLOR_PURPLE))
    print(event_branch("DATABASE ROLE", COLOR_ORANGE, "endpoint outbox", COLOR_ORANGE))
    print(paint("  ╰ DATABASE SERVER", COLOR_CYAN) + "  " + database_server_display)
else
    print(event_line("COVERAGE SEED", COLOR_PURPLE, SYNC_ROOT, COLOR_PURPLE))
    print(event_branch("DATABASE ROLE", COLOR_ORANGE,
        "standalone outbox", COLOR_ORANGE))
end if
if should_auto_download(startup_words) then download_database_seed
show_focus

if startup_words.len > 0 then
    dispatch(startup_words)
    save_research
    if is_file(globals.execution_computer_source) then clean_execution_route
    flush_log
    exit
end if

show_help
while true
    raw = console_prompt
    words = []
    for word in raw.split(" ")
        if word.trim != "" then words.push(word.trim)
    end for
    if words.len > 0 and (words[0].lower == "quit" or words[0].lower == "exit" or
        words[0].lower == "q") then break
    dispatch(words)
    // Keep latest.txt current even while the interactive prompt remains open.
    flush_log
end while

save_research
if is_file(globals.execution_computer_source) then clean_execution_route
flush_log
print(event_line("AUTORECON CLOSED", COLOR_GREEN,
    "research saved and execution cleanup attempted", COLOR_GREEN))
exit
