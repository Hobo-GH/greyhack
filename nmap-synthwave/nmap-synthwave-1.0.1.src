    name = program_path.split("/")[-1]
    return help_summary + char(10) + char(10) +
        paint("COMMANDS", COLOR_PURPLE) + char(10) +
        "  " + paint(name + " <target>", COLOR_CYAN) + char(10) +
        "    Full scan: stock-style ports, router identity, firewall rules, " +
        "forwarding sweep, LAN discovery, internal services, switches, Whois, and coverage gaps." + char(10) +
        "  " + paint(name + " --quick <target>", COLOR_CYAN) + char(10) +
        "    Quick scan: skips exhaustive 0-65535 forwarding and direct-subnet sweeps." + char(10) + char(10) +
        paint("EXAMPLES", COLOR_PURPLE) + char(10) +
        "  " + paint(name + " 12.32.56.89", COLOR_CYAN) + char(10) +
        "  " + paint(name + " www.example.com", COLOR_CYAN) + char(10) +
        "  " + paint(name + " --quick 192.168.0.1", COLOR_CYAN)
end function


