//Made By Hobo & Rowan
//command: nmap
// Nmap Synthwave Deep Recon 1.0.1
// Built for Grey Hack's native Router, Switch, Port, Shell, DNS, and Whois APIs.
// Read-only by design: no file writes, net_use calls, overflows, or configuration changes.
// Deep visibility is vantage-bound. Re-run from an internal foothold when a firewall
// or nested segment is reported as a coverage gap.

SCRIPT_VERSION = "1.0.1"
MAX_DEPTH = 4
MAX_NETWORK_DEVICES = 512
MAX_PORT_SWEEP_ROUTERS = 4
MAX_PORT_NUMBER = 65535
TABLE_PRINT_LIMIT = 1400
TABLE_DELIMITER = char(9)

COLOR_PURPLE = "#D86CFF"
COLOR_CYAN = "#55E7FF"
COLOR_GREEN = "#63FF9B"
COLOR_RED = "#FF5C7C"
COLOR_ORANGE = "#FFB86B"
COLOR_PINK = "#FF79C6"


paint = function(value, color)
    return "<color=" + color + ">" + str(value) + "</color>"
end function


safe_string = function(value, fallback="-")
    kind = typeof(value).lower
    if kind == "string" then
        if value != "" then return value
        return fallback
    end if
    if kind == "number" then return str(value)
    return fallback
end function


add_unique = function(values, value)
    if typeof(value).lower != "string" then return
    if value == "" then return
    if values.indexOf(value) == null then values.push(value)
end function


is_router_device = function(value)
    kind = typeof(value).lower
    return kind == "router" or kind == "switch"
end function


clean_spaces = function(value)
    text = safe_string(value, "").replace(char(13), " ").replace(char(10), " ").trim
    while text.indexOf("  ") != null
        text = text.replace("  ", " ")
    end while
    return text
end function


bounded_text = function(value, limit=240)
    text = clean_spaces(value)
    if text.len > limit then return text[:limit] + "..."
    return text
end function


heading = function(title)
    print(char(10) + "<size=125%><b>" + paint(title, COLOR_PURPLE) + "</b></size>")
end function


plain_cell = function(value)
    text = str(value)
    for color in [COLOR_PURPLE, COLOR_CYAN, COLOR_GREEN, COLOR_RED, COLOR_ORANGE, COLOR_PINK]
        text = text.replace("<color=" + color + ">", "")
    end for
    return text.replace("</color>", "")
end function


render_table_line = function(cells, widths)
    line = ""
    index = 0
    while index < cells.len
        cell = cells[index]
        line = line + cell
        if index < cells.len - 1 then
            padding = widths[index] - plain_cell(cell).len + 2
            if padding < 1 then padding = 1
            line = line + (" " * padding)
        end if
        index = index + 1
    end while
    return line
end function


table_row = function(cells)
    safe_cells = []
    for cell in cells
        safe_cells.push(str(cell).replace(char(13), " ").replace(char(10), " ").replace(TABLE_DELIMITER, " "))
    end for
    return safe_cells.join(TABLE_DELIMITER)
end function


print_table = function(header, rows)
    if typeof(rows).lower != "list" or rows.len == 0 then return
    header_cells = header.split(TABLE_DELIMITER)
    widths = []
    for cell in header_cells
        widths.push(cell.len)
    end for
    split_rows = []
    for row in rows
        cells = row.split(TABLE_DELIMITER)
        split_rows.push(cells)
        index = 0
        while index < cells.len
            while widths.len <= index
                widths.push(0)
            end while
            width = plain_cell(cells[index]).len
            if width > widths[index] then widths[index] = width
            index = index + 1
        end while
    end for

    colored_header = []
    for cell in header_cells
        colored_header.push(paint(cell, COLOR_PURPLE))
    end for
    rendered_header = render_table_line(colored_header, widths)
    buffer = rendered_header
    for cells in split_rows
        rendered = render_table_line(cells, widths)
        if buffer.len + rendered.len + 1 > TABLE_PRINT_LIMIT then
            print(buffer)
            buffer = rendered_header + char(10) + rendered
        else
            buffer = buffer + char(10) + rendered
        end if
    end for
    if buffer != rendered_header then print(buffer)
end function


help_title = function()
    return "<align=center><size=125%><b>" + paint("NMAP", COLOR_PURPLE) + " // " +
        paint("SYNTHWAVE DEEP RECON", COLOR_PINK) + "</b></size></align>" + char(10) +
        "Version " + paint(SCRIPT_VERSION, COLOR_PINK) + "  " +
        paint("READ-ONLY", COLOR_GREEN)
end function


help_summary = function()
    name = program_path.split("/")[-1]
    return help_title + char(10) + char(10) +
        paint("PURPOSE", COLOR_PURPLE) + char(10) +
        "Deep network reconnaissance from the current execution vantage." + char(10) +
        "No exploits, sessions, file writes, net_use calls, or configuration changes." + char(10) + char(10) +
        paint("USAGE", COLOR_PURPLE) + char(10) +
        "  " + paint(name + " <ip_address|domain>", COLOR_CYAN) + char(10) +
        "  " + paint(name + " --quick <ip_address|domain>", COLOR_CYAN) + char(10) + char(10) +
        paint("HELP LEVELS", COLOR_PURPLE) + char(10) +
        "  " + paint(name + " help", COLOR_CYAN) + "     command summary" + char(10) +
        "  " + paint(name + " -h", COLOR_CYAN) + "       syntax and examples" + char(10) +
        "  " + paint(name + " -help", COLOR_CYAN) + "    modes and report guide" + char(10) +
        "  " + paint(name + " --help", COLOR_CYAN) + "   full reference and boundaries"
end function


