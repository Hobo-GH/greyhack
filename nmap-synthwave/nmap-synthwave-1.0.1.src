        "  " + paint("Coverage Gaps", COLOR_CYAN) + "     visibility limits and suggested next pivots" + char(10) +
        "  " + paint("Scan Summary", COLOR_CYAN) + "      coverage counters, elapsed time, and read-only state"
end function


help_full = function()
    name = program_path.split("/")[-1]
    return help_detailed + char(10) + char(10) +
        paint("OBSERVATION BOUNDARY", COLOR_PURPLE) + char(10) +
        "Results describe only what Grey Hack exposes from the machine and LAN where this command runs." + char(10) +
        "An external scan cannot prove that nested-firewall devices do not exist. A private IP can also " +
        "refer to different machines on different LANs." + char(10) + char(10) +
        paint("PIVOT WORKFLOW", COLOR_PURPLE) + char(10) +
        "  1. Run a full scan from the current host." + char(10) +
        "  2. Read " + paint("COVERAGE GAPS // NEXT PIVOTS", COLOR_ORANGE) + "." + char(10) +
        "  3. Acquire a shell on, or execute from inside, the reported LAN boundary." + char(10) +
        "  4. Re-run " + paint(name + " <target>", COLOR_CYAN) + " from that new vantage." + char(10) + char(10) +
        paint("SAFETY CAPS", COLOR_PURPLE) + char(10) +
        "  router recursion depth     " + paint(MAX_DEPTH, COLOR_ORANGE) + char(10) +
        "  discovered network devices " + paint(MAX_NETWORK_DEVICES, COLOR_ORANGE) + char(10) +
        "  exhaustive router sweeps   " + paint(MAX_PORT_SWEEP_ROUTERS, COLOR_ORANGE) + char(10) +
        "  highest tested port number " + paint(MAX_PORT_NUMBER, COLOR_ORANGE) + char(10) + char(10) +
        paint("NOTES", COLOR_PURPLE) + char(10) +
        "  " + paint("FULL", COLOR_GREEN) + " is the default." + char(10) +
