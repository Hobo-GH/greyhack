    return help_standard + char(10) + char(10) +
        paint("SCAN MODES", COLOR_PURPLE) + char(10) +
        "  " + paint("FULL", COLOR_GREEN) + "   Enumerates visible ports and all 0-65535 router forwarding numbers, " +
        "then performs bounded direct-subnet discovery where the current vantage permits it." + char(10) +
        "  " + paint("QUICK", COLOR_ORANGE) + "  Uses exposed port and topology APIs without exhaustive port-number or subnet sweeps." + char(10) + char(10) +
        paint("REPORT GUIDE", COLOR_PURPLE) + char(10) +
        "  " + paint("Execution Vantage", COLOR_CYAN) + "  host, user, public/local IP, gateway, adapter" + char(10) +
