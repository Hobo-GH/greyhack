        "  DNS names are resolved before scanning and the resolved IP is shown in the header." + char(10) +
        "  Port 0 may represent the native router control endpoint rather than a forwarded service." + char(10) +
        "  Likely internal mappings are correlations because the API does not expose an exact destination port."
end function


usage = function()
    return help_standard
end function


port_record = function(router, port_object)
    info = router.port_info(port_object)
    if typeof(info).lower != "string" or info == "" then info = "unknown -"
    info = bounded_text(info, 160)
    pieces = info.split(" ")
    service = "unknown"
    version = "-"
    if pieces.len > 0 then service = pieces[0]
    if pieces.len > 1 then version = pieces[1:].join(" ")
    lan_ip = safe_string(port_object.get_lan_ip, "-")
    return {"number": port_object.port_number, "closed": port_object.is_closed,
        "service": service, "version": version, "info": info, "lan": lan_ip,
        "hidden_external": false, "forward_scope": ""}
end function


sort_port_records = function(records)
    i = 0
    while i < records.len
        j = i + 1
        while j < records.len
            if records[j].number < records[i].number then
                temp = records[i]
                records[i] = records[j]
                records[j] = temp
            end if
            j = j + 1
        end while
        i = i + 1
    end while
    return records
end function


records_from_ports = function(router, ports)
    records = []
    if typeof(ports).lower != "list" then return records
    for port_object in ports
        if typeof(port_object).lower == "port" then records.push(port_record(router, port_object))
    end for
    return sort_port_records(records)
end function


wan_links = function(wan_records, internal_record)
    internet_links = []
    upstream_links = []
    closed_links = []
    for wan_record in wan_records
        if wan_record.lan == internal_record.lan and wan_record.info == internal_record.info then
            if wan_record.closed then
                closed_links.push(wan_record.number)
            else if wan_record.forward_scope == "WAN" then
                internet_links.push(wan_record.number)
            else
                upstream_links.push(wan_record.number)
            end if
        end if
    end for
    return {"internet": internet_links, "upstream": upstream_links, "closed": closed_links}
end function


router_key = function(router)
    return safe_string(router.public_ip, "?") + "|" + safe_string(router.local_ip, "?")
end function


same_router = function(left, right)
    if not is_router_device(left) or not is_router_device(right) then return false
    return router_key(left) == router_key(right)
end function


status_cell = function(label, color)
    return paint(label, color)
end function


firewall_row = function(router_id, raw_rule)
    rule = clean_spaces(raw_rule)
    pieces = rule.split(" ")
    if pieces.len < 4 then
        return table_row([paint(router_id, COLOR_PINK), paint("RAW", COLOR_ORANGE),
            "-", "-", paint(bounded_text(rule, 160), COLOR_ORANGE)])
    end if
    action = "?"
    port = "?"
    source = "?"
    destination = "?"
    if pieces.len > 0 then action = pieces[0]
    if pieces.len > 1 then port = pieces[1]
    if pieces.len > 2 then source = pieces[2]
    if pieces.len > 3 then destination = pieces[3:].join(" ")
    action_color = COLOR_ORANGE
    if action.lower == "allow" then action_color = COLOR_GREEN
    if action.lower == "deny" or action.lower == "reject" then action_color = COLOR_RED
    return table_row([paint(router_id, COLOR_PINK), paint(action, action_color),
        paint(port, COLOR_CYAN), paint(source, COLOR_CYAN), paint(destination, COLOR_CYAN)])
end function


show_whois = function(public_ip)
    heading("WHOIS // PUBLIC IDENTITY")
    print("Public network: " + paint(public_ip, COLOR_CYAN))
    result = whois(public_ip)
    if typeof(result).lower != "string" or result == "" then
        print(paint("Whois returned no data.", COLOR_ORANGE))
        return
    end if
    for raw_line in result.replace(char(13), "").split(char(10))
        line = bounded_text(raw_line, 300)
        if line == "" then continue
        colon = line.indexOf(":")
        if colon == null then
            print(paint(line, COLOR_CYAN))
        else
            label = line[:colon]
            value = line[colon + 1:].trim
            print(label + ": " + paint(value, COLOR_CYAN))
        end if
    end for
end function


show_basic_nmap = function(router, target_ip, target_is_lan, ports)
    heading("BASIC NMAP READOUT")
    print("Starting nmap synthwave v" + SCRIPT_VERSION + " at " + paint(current_date, COLOR_ORANGE))
    print("Interesting ports on " + paint(target_ip, COLOR_CYAN))
    if typeof(ports).lower == "string" then
        print(paint(ports, COLOR_RED))
        return
    end if
    if typeof(ports).lower != "list" then
        print(paint("No port data returned from this vantage.", COLOR_ORANGE))
        return
    end if
    records = records_from_ports(router, ports)
    if records.len == 0 then
        print(paint("Scan finished. No visible ports.", COLOR_ORANGE))
        return
    end if
    rows = []
    for record in records
        state = status_cell("open", COLOR_GREEN)
        if record.closed and not target_is_lan then state = status_cell("closed", COLOR_RED)
        rows.push(table_row([paint(record.number, COLOR_CYAN), state,
            paint(record.service, COLOR_CYAN), record.version, paint(record.lan, COLOR_CYAN)]))
    end for
    header = table_row(["PORT", "STATE", "SERVICE", "VERSION", "LAN"])
    print_table(header, rows)
end function


discover_child = function(ip, current_router)
    child = get_switch(ip)
    if is_router_device(child) and not same_router(child, current_router) then
        return {"device": child, "kind": "switch"}
    end if
    return null
end function


add_gap = function(router_id, ip, reason)
    clean_reason = bounded_text(reason, 240)
    key = router_id + "|" + ip + "|" + clean_reason
    if globals.seen_gaps.hasIndex(key) then return
    globals.seen_gaps[key] = 1
    globals.gaps.push({"router": router_id, "ip": ip, "reason": clean_reason})
end function


full_port_sweep = function(router, router_id, visible_records, device_kind, forward_scope)
    all_records = visible_records[0:]
    sweep_label = forward_scope.lower + " forwarding"
    if globals.quick then
        add_gap(router_id, safe_string(router.public_ip), "full " + sweep_label + " sweep skipped by --quick")
        return all_records
    end if
    if device_kind == "switch" then return all_records
    if globals.stats.full_port_sweeps >= MAX_PORT_SWEEP_ROUTERS then
        add_gap(router_id, safe_string(router.public_ip), "full " + sweep_label + " sweep safety limit reached")
        return all_records
    end if

    globals.stats.full_port_sweeps = globals.stats.full_port_sweeps + 1
    sweep_hidden = 0
    known = {}
    for record in visible_records
        known[str(record.number)] = 1
    end for
    print(paint(router_id + " scanning " + sweep_label + " ports 0-" + MAX_PORT_NUMBER + "...", COLOR_PURPLE))
    sweep_start = time
    candidate = 0
    while candidate <= MAX_PORT_NUMBER
        port_object = router.ping_port(candidate)
        if typeof(port_object).lower == "port" and not known.hasIndex(str(candidate)) then
            record = port_record(router, port_object)
            record.number = candidate
            record.hidden_external = true
            record.forward_scope = forward_scope
            all_records.push(record)
            known[str(candidate)] = 1
            state = status_cell("HIDDEN-FWD", COLOR_ORANGE)
            if forward_scope == "UPSTREAM" then state = status_cell("HIDDEN-UPSTREAM", COLOR_ORANGE)
            if record.closed then state = status_cell("HIDDEN-CLOSED", COLOR_RED)
            globals.hidden_wan_rows.push(table_row([paint(router_id, COLOR_PINK),
                paint(forward_scope, COLOR_CYAN), paint(candidate, COLOR_CYAN), state,
                paint(record.service, COLOR_CYAN), record.version, paint(record.lan, COLOR_CYAN)]))
            globals.stats.hidden_external_ports = globals.stats.hidden_external_ports + 1
            sweep_hidden = sweep_hidden + 1
        end if
        candidate = candidate + 1
        if candidate % 1000 == 0 then wait(0.01)
    end while
    print(paint(router_id + " " + sweep_label + " sweep complete in " + (time - sweep_start) + "s", COLOR_GREEN) +
        "  hidden=" + paint(sweep_hidden, COLOR_PINK))
    return sort_port_records(all_records)
end function


expand_direct_subnet = function(router, router_id, addresses)
    if globals.quick then
        add_gap(router_id, safe_string(router.local_ip), "direct /24 ping discovery skipped by --quick")
        return addresses
    end if
    if not same_router(router, globals.vantage_router) then
        add_gap(router_id, safe_string(router.local_ip),
            "direct /24 ping discovery requires execution inside this router's LAN")
        return addresses
    end if
    local_ip = safe_string(router.local_ip, "")
    pieces = local_ip.split(".")
    if pieces.len != 4 then
        add_gap(router_id, local_ip, "could not derive a /24 subnet from router local IP")
        return addresses
    end if

    prefix = pieces[0] + "." + pieces[1] + "." + pieces[2] + "."
    print(paint(router_id + " probing direct subnet " + prefix + "1-254...", COLOR_PURPLE))
    octet = 1
    while octet <= 254
        candidate = prefix + octet
        cache_key = router_id + "|" + candidate
        reply = globals.execution_shell.ping(candidate)
        globals.ping_cache[cache_key] = reply
        if reply and addresses.indexOf(candidate) == null then
            addresses.push(candidate)
            globals.unlisted_hosts[cache_key] = 1
            globals.stats.unlisted_hosts = globals.stats.unlisted_hosts + 1
        end if
        octet = octet + 1
        if octet % 50 == 0 then wait(0.01)
    end while
    globals.stats.subnet_sweeps = globals.stats.subnet_sweeps + 1
    return addresses
end function


collect_router = function(router, device_kind, depth, via)
    if not is_router_device(router) then return
    if globals.stats.routers >= MAX_NETWORK_DEVICES then
        add_gap("LIMIT", via, "router/switch safety limit reached")
        return
    end if
    key = router_key(router)
    if globals.seen_routers.hasIndex(key) then return
    globals.seen_routers[key] = 1

    router_number = globals.stats.routers
    globals.stats.routers = globals.stats.routers + 1
    router_id = "R" + router_number
    public_ip = safe_string(router.public_ip, "-")
    local_ip = safe_string(router.local_ip, "-")
    kernel = safe_string(router.kernel_version, "unknown")
    essid = safe_string(router.essid_name, "unavailable/disabled")
    bssid = safe_string(router.bssid_name, "-")
    if device_kind == "switch" then globals.stats.switches = globals.stats.switches + 1
    router_is_vantage = same_router(router, globals.vantage_router)

    globals.router_rows.push(table_row([paint(router_id, COLOR_PINK),
        paint(device_kind.upper, COLOR_CYAN), paint(public_ip, COLOR_CYAN),
        paint(local_ip, COLOR_CYAN), paint(kernel, COLOR_CYAN),
        paint(depth, COLOR_PINK), paint(via, COLOR_CYAN)]))

    wifi_state = paint(essid, COLOR_CYAN)
    if device_kind == "switch" then
        wifi_state = paint("N/A", COLOR_ORANGE)
        bssid = "-"
    else if essid == "unavailable/disabled" then
        wifi_state = paint(essid, COLOR_ORANGE)
    end if
    globals.wifi_rows.push(table_row([paint(router_id, COLOR_PINK),
        paint(device_kind.upper, COLOR_CYAN), wifi_state, paint(bssid, COLOR_CYAN)]))

    globals.control_rows.push(table_row([paint(router_id, COLOR_PINK), paint(0, COLOR_CYAN),
        paint("NATIVE", COLOR_ORANGE), paint("kernel_router.so", COLOR_CYAN),
        kernel, paint(local_ip, COLOR_CYAN)]))
    globals.stats.control_endpoints = globals.stats.control_endpoints + 1

    raw_rules = router.firewall_rules
    if typeof(raw_rules).lower == "list" then
        for rule in raw_rules
            globals.firewall_rows.push(firewall_row(router_id, rule))
            globals.stats.firewall_rules = globals.stats.firewall_rules + 1
        end for
        if raw_rules.len == 0 then
            globals.firewall_notes.push(paint(router_id, COLOR_PINK) + " " +
                paint("No explicit firewall rules reported.", COLOR_ORANGE))
        end if
    else
        globals.firewall_notes.push(paint(router_id, COLOR_PINK) + " " +
            paint("Firewall rule data unavailable.", COLOR_ORANGE))
        add_gap(router_id, local_ip, "firewall rules unavailable")
    end if

    raw_wan_ports = router.used_ports
    if depth == 0 and not globals.target_is_lan and typeof(globals.basic_ports).lower == "list" then
        raw_wan_ports = globals.basic_ports
    end if
    if typeof(raw_wan_ports).lower == "string" then
        globals.forwarding_notes.push(paint(router_id, COLOR_PINK) + " " +
            paint("Forwarding list unavailable: " + bounded_text(raw_wan_ports, 180), COLOR_ORANGE))
        add_gap(router_id, public_ip, raw_wan_ports)
    else if typeof(raw_wan_ports).lower != "list" then
        globals.forwarding_notes.push(paint(router_id, COLOR_PINK) + " " +
            paint("Forwarding list unavailable from this vantage.", COLOR_ORANGE))
        add_gap(router_id, public_ip, "forwarding list unavailable")
    end if
    wan_records = records_from_ports(router, raw_wan_ports)
    forward_scope = "UPSTREAM"
    if depth == 0 and not globals.target_is_lan then forward_scope = "WAN"
    for record in wan_records
        record.forward_scope = forward_scope
        wan_state = status_cell("FORWARDED", COLOR_ORANGE)
        if forward_scope == "UPSTREAM" then wan_state = status_cell("UPSTREAM-FWD", COLOR_ORANGE)
        if record.closed then wan_state = status_cell("CLOSED", COLOR_RED)
        globals.wan_rows.push(table_row([paint(router_id, COLOR_PINK),
            paint(forward_scope, COLOR_CYAN), paint(record.number, COLOR_CYAN), wan_state,
            paint(record.service, COLOR_CYAN), record.version, paint(record.lan, COLOR_CYAN)]))
        globals.stats.visible_wan_ports = globals.stats.visible_wan_ports + 1
    end for
    wan_records = full_port_sweep(router, router_id, wan_records, device_kind, forward_scope)

    addresses = []
    listed_addresses = {}
    if is_valid_ip(local_ip) then
        add_unique(addresses, local_ip)
        listed_addresses[local_ip] = 1
    end if
    devices = router.devices_lan_ip
    if typeof(devices).lower == "list" then
        for ip in devices
            if is_valid_ip(ip) then
                add_unique(addresses, ip)
                listed_addresses[ip] = 1
            end if
        end for
    else
        add_gap(router_id, local_ip, "LAN device list unavailable from this vantage")
    end if
    if depth == 0 and globals.target_is_lan then
        add_unique(addresses, globals.target_ip)
        if listed_addresses.hasIndex(globals.target_ip) == false then
            globals.unlisted_hosts[router_id + "|" + globals.target_ip] = 1
            globals.stats.unlisted_hosts = globals.stats.unlisted_hosts + 1
        end if
    end if
    addresses = expand_direct_subnet(router, router_id, addresses)
    addresses.sort

    if not router_is_vantage then
        add_gap(router_id, local_ip,
            "execution-host ping and local switch-object lookup withheld outside this LAN to avoid private-IP collisions")
    end if

    for ip in addresses
        if globals.stats.lan_nodes >= MAX_NETWORK_DEVICES then
            add_gap(router_id, ip, "LAN node safety limit reached")
            break
        end if
        host_key = router_id + "|" + ip
        if globals.seen_hosts.hasIndex(host_key) then continue
        globals.seen_hosts[host_key] = 1

        child_info = null
        node_kind = "host"
        if ip == local_ip then
            node_kind = device_kind
        else if router_is_vantage then
            child_info = discover_child(ip, router)
            if typeof(child_info).lower == "map" then node_kind = child_info.kind
        end if

        cache_key = router_id + "|" + ip
        ping_reply = null
        ping_label = status_cell("UNKNOWN", COLOR_ORANGE)
        if router_is_vantage then
            if globals.ping_cache.hasIndex(cache_key) then
                ping_reply = globals.ping_cache[cache_key]
            else
                ping_reply = globals.execution_shell.ping(ip)
                globals.ping_cache[cache_key] = ping_reply
            end if
            ping_label = status_cell("NO-REPLY", COLOR_RED)
            if ping_reply then ping_label = status_cell("REPLY", COLOR_GREEN)
        end if

        raw_ports = null
        if depth == 0 and globals.target_is_lan and ip == globals.target_ip then
            raw_ports = globals.basic_ports
        else
            raw_ports = router.device_ports(ip)
        end if

        visibility = status_cell("NO-DATA", COLOR_ORANGE)
        port_count = 0
        if typeof(raw_ports).lower == "list" then
            port_count = raw_ports.len
            visibility = status_cell("VISIBLE", COLOR_GREEN)
            if raw_ports.len == 0 then visibility = status_cell("NO-SERVICE", COLOR_ORANGE)
        else if typeof(raw_ports).lower == "string" then
            lower_error = raw_ports.lower
            visibility = status_cell("FILTERED", COLOR_ORANGE)
            if lower_error.indexOf("firewall") != null or lower_error.indexOf("unreachable") != null then
                visibility = status_cell("BLOCKED", COLOR_RED)
            end if
            globals.stats.filtered = globals.stats.filtered + 1
            add_gap(router_id, ip, raw_ports)
        else
            globals.stats.filtered = globals.stats.filtered + 1
            add_gap(router_id, ip, "device ports unavailable; closer LAN vantage required")
        end if

        host_number = globals.stats.lan_nodes
        host_id = "H" + host_number
        globals.stats.lan_nodes = globals.stats.lan_nodes + 1
        discovery = paint("ROUTER-LIST", COLOR_CYAN)
        if ip == local_ip then discovery = paint("ROUTER-LOCAL", COLOR_CYAN)
        if globals.unlisted_hosts.hasIndex(cache_key) then discovery = paint("PING-UNLISTED", COLOR_ORANGE)
        globals.host_rows.push(table_row([paint(host_id, COLOR_PINK), paint(router_id, COLOR_PINK),
            paint(ip, COLOR_CYAN), paint(node_kind.upper, COLOR_CYAN), discovery,
            ping_label, visibility, paint(port_count, COLOR_PINK)]))

        internal_records = records_from_ports(router, raw_ports)
        for record in internal_records
            links = wan_links(wan_records, record)
            mapped_text = "-"
            scope = status_cell("NO-FORWARD-MATCH", COLOR_CYAN)
            if links.internet.len > 0 then
                mapped_text = links.internet.join(",")
                scope = status_cell("LIKELY-WAN-MAPPED", COLOR_ORANGE)
            else if links.upstream.len > 0 then
                mapped_text = links.upstream.join(",")
                scope = status_cell("LIKELY-UPSTREAM-MAPPED", COLOR_ORANGE)
            else if links.closed.len > 0 then
                mapped_text = links.closed.join(",")
                scope = status_cell("MAPPED-CLOSED", COLOR_RED)
            else if record.closed then
                scope = status_cell("CLOSED-NO-MATCH", COLOR_RED)
            end if
            globals.port_rows.push(table_row([paint(host_id, COLOR_PINK),
                paint(ip, COLOR_CYAN), paint(record.number, COLOR_CYAN), scope,
                paint(record.service, COLOR_CYAN), record.version, paint(mapped_text, COLOR_CYAN)]))
            globals.stats.internal_ports = globals.stats.internal_ports + 1
            if links.internet.len == 0 and links.upstream.len == 0 and links.closed.len == 0 then
                globals.stats.unmatched_internal_ports = globals.stats.unmatched_internal_ports + 1
            end if
        end for

        if typeof(child_info).lower == "map" then
            globals.topology_rows.push(table_row([paint(router_id, COLOR_PINK),
                paint("->", COLOR_PURPLE), paint(ip, COLOR_CYAN),
                paint(child_info.kind.upper, COLOR_CYAN), paint("DISCOVERED", COLOR_GREEN)]))
            if depth < MAX_DEPTH then
                collect_router(child_info.device, child_info.kind, depth + 1, router_id + "/" + ip)
            else
                add_gap(router_id, ip, "child " + child_info.kind + " found at recursion depth limit")
            end if
        else if node_kind != "host" and not router_is_vantage then
            add_gap(router_id, ip,
                "child-object lookup withheld outside execution LAN to avoid private-IP collision")
        end if
    end for
end function


// Parse one target. Exhaustive external-port and direct-subnet sweeps are the default.
globals.quick = false
target_argument = ""
for argument in params
    if argument == "help" then exit(help_summary)
    if argument == "-h" then exit(help_standard)
    if argument == "-help" then exit(help_detailed)
    if argument == "--help" then exit(help_full)
    if argument == "--quick" then
        globals.quick = true
    else if argument[:2] == "--" then
        exit(paint("nmap: unknown option", COLOR_RED) + " " + argument + char(10) + usage)
    else
        if target_argument != "" then exit(usage)
        target_argument = argument
    end if
end for
if target_argument == "" then exit(usage)

globals.execution_shell = get_shell
globals.execution_computer = globals.execution_shell.host_computer
globals.vantage_router = get_router

globals.requested_target = target_argument
globals.target_ip = globals.requested_target
if globals.target_ip == "127.0.0.1" then globals.target_ip = globals.execution_computer.local_ip
if not is_valid_ip(globals.target_ip) then globals.target_ip = nslookup(globals.target_ip)
if not is_valid_ip(globals.target_ip) then
    exit(paint("nmap: target could not be resolved", COLOR_RED) + " " + globals.requested_target)
end if
globals.target_is_lan = is_lan_ip(globals.target_ip)
if not globals.target_is_lan and not globals.execution_computer.is_network_active then
    exit(paint("nmap: no Internet route for this public target", COLOR_RED))
end if

globals.root_router = null
if globals.target_is_lan then
    globals.root_router = get_router
else
    globals.root_router = get_router(globals.target_ip)
end if
if not is_router_device(globals.root_router) then
    exit(paint("nmap: router or target not found", COLOR_RED) + " " + paint(globals.target_ip, COLOR_CYAN))
end if

globals.basic_ports = null
if globals.target_is_lan then
    globals.basic_ports = globals.root_router.device_ports(globals.target_ip)
else
    globals.basic_ports = globals.root_router.used_ports
end if

globals.router_rows = []
globals.wifi_rows = []
globals.control_rows = []
globals.firewall_rows = []
globals.firewall_notes = []
globals.forwarding_notes = []
globals.wan_rows = []
globals.hidden_wan_rows = []
globals.host_rows = []
globals.port_rows = []
globals.topology_rows = []
globals.gaps = []
globals.seen_routers = {}
globals.seen_hosts = {}
globals.seen_gaps = {}
globals.ping_cache = {}
globals.unlisted_hosts = {}
globals.stats = {"routers": 0, "switches": 0, "control_endpoints": 0,
    "firewall_rules": 0, "visible_wan_ports": 0, "hidden_external_ports": 0,
    "full_port_sweeps": 0, "subnet_sweeps": 0, "unlisted_hosts": 0,
    "lan_nodes": 0, "internal_ports": 0, "unmatched_internal_ports": 0, "filtered": 0}
globals.scan_start = time

print("<align=center><size=125%><b>" + paint("NMAP", COLOR_PURPLE) + " // " +
    paint("SYNTHWAVE DEEP RECON", COLOR_PINK) + "</b></size></align>")
print("Target " + paint(globals.requested_target, COLOR_CYAN) + " -> " +
    paint(globals.target_ip, COLOR_CYAN) + "  version=" + paint(SCRIPT_VERSION, COLOR_PINK))
scan_mode = "FULL"
if globals.quick then scan_mode = "QUICK"
print("Mode " + paint(scan_mode, COLOR_PINK))

heading("EXECUTION VANTAGE")
vantage_rows = []
vantage_rows.push(table_row(["HOST", paint(safe_string(globals.execution_computer.get_name, "unknown"), COLOR_GREEN)]))
vantage_rows.push(table_row(["USER", paint(active_user, COLOR_GREEN)]))
vantage_rows.push(table_row(["PUBLIC_IP", paint(safe_string(globals.execution_computer.public_ip), COLOR_CYAN)]))
vantage_rows.push(table_row(["LOCAL_IP", paint(safe_string(globals.execution_computer.local_ip), COLOR_CYAN)]))
vantage_rows.push(table_row(["GATEWAY", paint(safe_string(globals.execution_computer.network_gateway), COLOR_CYAN)]))
vantage_rows.push(table_row(["ADAPTER", paint(safe_string(globals.execution_computer.active_net_card), COLOR_GREEN)]))
print_table(table_row(["FIELD", "VALUE"]), vantage_rows)

show_basic_nmap(globals.root_router, globals.target_ip, globals.target_is_lan, globals.basic_ports)
show_whois(globals.root_router.public_ip)

same_public = safe_string(globals.execution_computer.public_ip, "") == safe_string(globals.root_router.public_ip, "-")
globals.coverage = "EXTERNAL-VIEW"
if globals.target_is_lan or same_public then globals.coverage = "LAN-VISIBLE"
if globals.coverage == "EXTERNAL-VIEW" then
    add_gap("ROOT", globals.root_router.public_ip,
        "external view cannot prove devices hidden behind nested firewalls; re-run from an internal foothold")
end if
add_gap("API", globals.target_ip,
    "game-hidden LAN identities suppress passive device listing and ping; absence requires a known IP or another vantage")

heading("DEEP TOPOLOGY COLLECTION")
print(paint("Enumerating forwarded ports, router-local control planes, LAN nodes, " +
    "internal services, local switches, pivot gaps, and firewall barriers...", COLOR_PURPLE))
collect_router(globals.root_router, typeof(globals.root_router).lower, 0, "target")
print(paint("API collection pass complete.", COLOR_GREEN))
if globals.gaps.len > 0 then print(paint(globals.gaps.len + " coverage gap(s) recorded.", COLOR_ORANGE))

heading("ROUTERS + SWITCHES")
print_table(table_row(["IDX", "TYPE", "PUBLIC_IP", "LOCAL_IP", "KERNEL", "DEPTH", "VIA"]), globals.router_rows)

heading("WIRELESS IDENTITY")
print_table(table_row(["IDX", "TYPE", "ESSID", "BSSID"]), globals.wifi_rows)

heading("ROUTER CONTROL PLANE")
print(paint("Port 0 is reported from kernel_version as a native router endpoint, not as a forwarded-port probe.", COLOR_ORANGE))
print_table(table_row(["IDX", "PORT", "STATE", "SERVICE", "VERSION", "LAN"]), globals.control_rows)

heading("FIREWALL RULES")
if globals.firewall_rows.len > 0 then
    print_table(table_row(["ROUTER", "ACTION", "PORT", "SOURCE", "DEST"]), globals.firewall_rows)
end if
for note in globals.firewall_notes
    print(note)
end for

heading("FORWARDING MAP")
if globals.wan_rows.len == 0 then
    if globals.forwarding_notes.len == 0 then
        print(paint("No forwarded ports reported.", COLOR_ORANGE))
    else
        print(paint("No forwarding rows were available from the reported devices.", COLOR_ORANGE))
    end if
else
    print_table(table_row(["ROUTER", "SCOPE", "FWD_PORT", "STATE", "SERVICE", "VERSION", "DEST_LAN"]), globals.wan_rows)
end if
for note in globals.forwarding_notes
    print(note)
end for

heading("NON-VISIBLE FORWARDS")
print(paint("Found by exhaustive router.ping_port sweeps; used_ports omits non-visible forwards.", COLOR_ORANGE))
if globals.quick then
    print(paint("NOT ASSESSED in --quick mode.", COLOR_ORANGE))
else if globals.stats.full_port_sweeps == 0 then
    print(paint("NOT ASSESSED; no eligible forwarding sweep completed.", COLOR_ORANGE))
else if globals.hidden_wan_rows.len == 0 then
    print(paint("None observed in " + globals.stats.full_port_sweeps + " completed eligible sweep(s).", COLOR_GREEN))
    if globals.gaps.len > 0 then print(paint("Review coverage gaps for unassessed devices.", COLOR_ORANGE))
else
    print_table(table_row(["ROUTER", "SCOPE", "FWD_PORT", "STATE", "SERVICE", "VERSION", "DEST_LAN"]), globals.hidden_wan_rows)
end if

heading("LAN NODE INVENTORY")
if globals.host_rows.len == 0 then
    print(paint("No LAN nodes were observable from this vantage.", COLOR_ORANGE))
else
    print_table(table_row(["HOST", "ROUTER", "IP", "TYPE", "DISCOVERY", "PING_FROM_EXEC", "VISIBILITY", "PORTS"]), globals.host_rows)
end if

heading("INTERNAL PORT MAP")
print(paint("LIKELY mappings correlate destination LAN IP plus service/version; the API does not expose an exact internal destination port.", COLOR_ORANGE))
if globals.port_rows.len == 0 then
    print(paint("No internal service ports were observable.", COLOR_ORANGE))
else
    print_table(table_row(["HOST", "IP", "PORT", "SCOPE", "SERVICE", "VERSION", "MAPPED_PORT"]), globals.port_rows)
end if

heading("LOCAL SWITCH EDGES")
if globals.topology_rows.len == 0 then
    print(paint("No local switch objects were directly discoverable from the execution LAN.", COLOR_ORANGE))
else
    print_table(table_row(["FROM", "EDGE", "ADDRESS", "TYPE", "STATE"]), globals.topology_rows)
end if

heading("COVERAGE GAPS // NEXT PIVOTS")
if globals.gaps.len == 0 then
    print(paint("No API-visible coverage gaps were reported in the observed topology.", COLOR_GREEN))
else
    gap_number = 0
    for gap in globals.gaps
        print("[" + paint(gap_number, COLOR_PINK) + "] " + paint(gap.router, COLOR_PINK) + " " +
            paint(gap.ip, COLOR_CYAN) + "  " + paint(gap.reason, COLOR_ORANGE))
        gap_number = gap_number + 1
    end for
    print(paint("Pivot guidance: acquire a shell on or inside the listed boundary, then run this nmap again.", COLOR_ORANGE))
end if

heading("SCAN SUMMARY")
summary_rows = []
coverage_color = COLOR_ORANGE
if globals.coverage == "LAN-VISIBLE" then coverage_color = COLOR_GREEN
summary_rows.push(table_row(["COVERAGE", paint(globals.coverage, coverage_color)]))
summary_rows.push(table_row(["ROUTE_DEVICES", paint(globals.stats.routers, COLOR_PINK)]))
summary_rows.push(table_row(["ROUTERS", paint(globals.stats.routers - globals.stats.switches, COLOR_PINK)]))
summary_rows.push(table_row(["SWITCHES", paint(globals.stats.switches, COLOR_PINK)]))
summary_rows.push(table_row(["CONTROL_ENDPOINTS", paint(globals.stats.control_endpoints, COLOR_PINK)]))
summary_rows.push(table_row(["FIREWALL_RULES", paint(globals.stats.firewall_rules, COLOR_PINK)]))
summary_rows.push(table_row(["FORWARDS_VISIBLE", paint(globals.stats.visible_wan_ports, COLOR_PINK)]))
summary_rows.push(table_row(["FORWARDS_HIDDEN", paint(globals.stats.hidden_external_ports, COLOR_PINK)]))
summary_rows.push(table_row(["FULL_PORT_SWEEPS", paint(globals.stats.full_port_sweeps, COLOR_PINK)]))
summary_rows.push(table_row(["DIRECT_SUBNET_SWEEPS", paint(globals.stats.subnet_sweeps, COLOR_PINK)]))
summary_rows.push(table_row(["PING_UNLISTED_HOSTS", paint(globals.stats.unlisted_hosts, COLOR_PINK)]))
summary_rows.push(table_row(["LAN_NODES", paint(globals.stats.lan_nodes, COLOR_PINK)]))
summary_rows.push(table_row(["INTERNAL_PORTS", paint(globals.stats.internal_ports, COLOR_PINK)]))
summary_rows.push(table_row(["NO_FORWARD_MATCH", paint(globals.stats.unmatched_internal_ports, COLOR_PINK)]))
summary_rows.push(table_row(["FILTERED_OR_UNKNOWN", paint(globals.stats.filtered, COLOR_PINK)]))
summary_rows.push(table_row(["PIVOT_GAPS", paint(globals.gaps.len, COLOR_PINK)]))
summary_rows.push(table_row(["ELAPSED_SECONDS", paint(time - globals.scan_start, COLOR_PINK)]))
print_table(table_row(["METRIC", "VALUE"]), summary_rows)
print(paint("READ-ONLY", COLOR_GREEN) + "  no exploits, service sessions, file writes, or network configuration changes")
print(paint("Observation boundary:", COLOR_ORANGE) + " results are complete only for data visible from this execution vantage.")
