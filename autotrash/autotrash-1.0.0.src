//Made By Hobo
// AutoTrash 1.0.0
// Fast, account-aware Grey Hack trash cleanup.
//
// Usage:
//   autotrash
//   autotrash preview
//   autotrash help
//
// Running as root cleans /root/.Trash and conventional /home/<account>/.Trash
// folders. Other users clean only their own conventional home trash. AutoTrash
// preserves every .Trash folder and never accepts an arbitrary target path.

SCRIPT_VERSION = "1.0.0"

ROOT_TRASH = "/root/.Trash"
HOME_ROOT = "/home"
TRASH_NAME = ".Trash"
PROGRESS_INTERVAL = 25

COLOR_PURPLE = "#D86CFF"
COLOR_CYAN = "#55E7FF"
COLOR_GREEN = "#63FF9B"
COLOR_RED = "#FF5C7C"
COLOR_ORANGE = "#FFB86B"
COLOR_PINK = "#FF79C6"
COLOR_DIM = "#A79BC8"

paint = function(value, color)
    return "<color=" + color + ">" + str(value) + "</color>"
end function

usage = paint("AutoTrash " + SCRIPT_VERSION, COLOR_PURPLE) + char(10) +
    "Usage:" + char(10) +
    "  autotrash                 clean trash for the permitted account scope" + char(10) +
    "  autotrash preview         list top-level entries without deleting" + char(10) +
    "  autotrash --dry-run       alias for preview" + char(10) +
    "  autotrash help | -h | --help" + char(10) + char(10) +
    "Root cleans root plus conventional home-account trash folders. Other users" + char(10) +
    "clean only /home/<active-user>/.Trash. Trash folders themselves are kept."

args = params
if args == null then args = []
if args.len > 1 then exit("autotrash: too many arguments" + char(10) + usage)

mode = "clean"
if args.len == 1 then
    arg = args[0].trim.lower
    if arg == "help" or arg == "-h" or arg == "--help" then exit(usage)
    if arg == "preview" or arg == "--dry-run" then
        mode = "preview"
    else if arg != "clean" then
        exit("autotrash: expected preview, --dry-run, clean, or help" + char(10) + usage)
    end if
end if

shell = get_shell
if shell == null then exit(paint("AUTOTRASH ERROR", COLOR_RED) + " no active shell")

computer = shell.host_computer
if computer == null then exit(paint("AUTOTRASH ERROR", COLOR_RED) + " no host computer")

isFileObject = function(value)
    return typeof(value).lower == "file"
end function

joinPath = function(folder, name)
    if folder == "/" then return "/" + name
    return folder + "/" + name
end function

isDirectChild = function(rootPath, childPath)
    if typeof(childPath) != "string" then return false
    prefix = rootPath + "/"
    if childPath.indexOf(prefix) != 0 then return false
    relative = childPath[prefix.len:]
    if relative.len == 0 then return false
    return relative.indexOf("/") == null
end function

print(paint("AUTOTRASH // ACCOUNT TRASH CLEANER", COLOR_PURPLE))
print("Version: " + SCRIPT_VERSION + " | Host: " + paint(computer.get_name, COLOR_CYAN) +
    " | User: " + paint(active_user, COLOR_GREEN) + " | Mode: " + mode)

trashPaths = []
stats = {
    "discovery": 0,
    "files": 0,
    "folders": 0,
    "links": 0,
    "link_api": 0,
}

addTrashPath = function(path, trashPaths, stats)
    trash = computer.File(path)
    if not isFileObject(trash) then return
    if trash.path != path then
        print(paint("BOUNDARY REFUSED", COLOR_RED) + " requested=" + path + " resolved=" + str(trash.path))
        stats["discovery"] = stats["discovery"] + 1
        return
    end if
    if trash.is_folder != 1 then
        print(paint("BOUNDARY REFUSED", COLOR_RED) + " trash path is not a folder: " + path)
        stats["discovery"] = stats["discovery"] + 1
        return
    end if
    if trash.hasIndex("is_symlink") then
        if trash.is_symlink == 1 then
            print(paint("BOUNDARY REFUSED", COLOR_RED) + " trash root is a symlink: " + path)
            stats["discovery"] = stats["discovery"] + 1
            return
        end if
    end if
    if trashPaths.indexOf(path) == null then trashPaths.push(path)
end function

if active_user == "root" then
    addTrashPath(ROOT_TRASH, trashPaths, stats)

    home = computer.File(HOME_ROOT)
    if isFileObject(home) and home.is_folder == 1 then
        accounts = home.get_folders
        if typeof(accounts) == "list" then
            for account in accounts
                if not isFileObject(account) then
                    stats["discovery"] = stats["discovery"] + 1
                    continue
                end if
                expected = joinPath(HOME_ROOT, account.name)
                if account.path != expected or account.name.len == 0 or account.name.indexOf("/") != null then
                    print(paint("BOUNDARY REFUSED", COLOR_RED) + " unexpected home entry: " + str(account.path))
                    stats["discovery"] = stats["discovery"] + 1
                    continue
                end if
                addTrashPath(joinPath(expected, TRASH_NAME), trashPaths, stats)
            end for
        else
            print(paint("SCAN ERROR", COLOR_RED) + " could not enumerate " + HOME_ROOT)
            stats["discovery"] = stats["discovery"] + 1
        end if
    end if
else
    addTrashPath(joinPath(joinPath(HOME_ROOT, str(active_user)), TRASH_NAME), trashPaths, stats)
end if

trashPaths.sort

if trashPaths.len == 0 and stats["discovery"] == 0 then
    print(paint("TRASH ALREADY EMPTY", COLOR_GREEN) + " | no conventional trash folder exists for this account scope")
    exit
end if

targets = {}

addTarget = function(child, trashPath, expectedFolder, targets, stats)
    if not isFileObject(child) then
        stats["discovery"] = stats["discovery"] + 1
        return
    end if

    childPath = child.path
    if not isDirectChild(trashPath, childPath) then
        print(paint("BOUNDARY REFUSED", COLOR_RED) + " non-child entry: " + str(childPath))
        stats["discovery"] = stats["discovery"] + 1
        return
    end if

    isFolder = child.is_folder == 1
    if expectedFolder and not isFolder then
        print(paint("SCAN ERROR", COLOR_RED) + " folder listing returned a non-folder: " + childPath)
        stats["discovery"] = stats["discovery"] + 1
        return
    end if
    if not expectedFolder and isFolder then
        print(paint("SCAN ERROR", COLOR_RED) + " file listing returned a folder: " + childPath)
        stats["discovery"] = stats["discovery"] + 1
        return
    end if

    kind = "FILE"
    if isFolder then kind = "FOLDER"
    if child.hasIndex("is_symlink") then
        stats["link_api"] = 1
        if child.is_symlink == 1 then kind = "LINK"
    end if

    if targets.hasIndex(childPath) then
        print(paint("SCAN ERROR", COLOR_RED) + " duplicate child path: " + childPath)
        stats["discovery"] = stats["discovery"] + 1
        return
    end if

    targets[childPath] = {
        "kind": kind,
        "trash": trashPath,
    }
    if kind == "FILE" then stats["files"] = stats["files"] + 1
    if kind == "FOLDER" then stats["folders"] = stats["folders"] + 1
    if kind == "LINK" then stats["links"] = stats["links"] + 1
end function

for trashPath in trashPaths
    trash = computer.File(trashPath)
    if not isFileObject(trash) or trash.is_folder != 1 or trash.path != trashPath then
        print(paint("SCAN ERROR", COLOR_RED) + " trash folder changed during preparation: " + trashPath)
        stats["discovery"] = stats["discovery"] + 1
        continue
    end if

    files = trash.get_files
    folders = trash.get_folders
    if typeof(files) != "list" or typeof(folders) != "list" then
        print(paint("SCAN ERROR", COLOR_RED) + " could not enumerate: " + trashPath)
        stats["discovery"] = stats["discovery"] + 1
        continue
    end if

    for child in files
        addTarget(child, trashPath, false, targets, stats)
    end for
    for child in folders
        addTarget(child, trashPath, true, targets, stats)
    end for
end for

paths = targets.indexes
paths.sort

print(paint("Cleanup scope", COLOR_PINK) +
    " | trashes=" + trashPaths.len +
    " | top-level entries=" + paths.len +
    " | files=" + stats["files"] +
    " | folders=" + stats["folders"] +
    " | links=" + stats["links"])
for trashPath in trashPaths
    print("  " + paint(trashPath, COLOR_CYAN))
end for

if stats["link_api"] == 0 then
    print(paint("NOTICE", COLOR_ORANGE) +
        " is_symlink is unavailable; AutoTrash does not descend into children and enforces exact direct-child paths.")
end if

if stats["discovery"] > 0 then
    exit(paint("AUTOTRASH REFUSED", COLOR_RED) +
        " | preparation issues=" + stats["discovery"] + " | nothing was deleted")
end if

if mode == "preview" then
    print(paint("PREVIEW ONLY", COLOR_ORANGE) + " | no files or folders will be deleted")
    for path in paths
        print("  " + paint("[" + targets[path]["kind"] + "]", COLOR_PURPLE) + " " + paint(path, COLOR_CYAN))
    end for
    exit(paint("Preview complete.", COLOR_GREEN))
end if

if paths.len == 0 then
    print(paint("TRASH ALREADY EMPTY", COLOR_GREEN) + " | nothing to delete")
    exit
end if

print(paint("CLEANING", COLOR_ORANGE) +
    " | Grey Hack recursively deletes folder targets; every .Trash root is preserved")

deletedCount = 0
missingCount = 0
failedCount = 0
processedCount = 0
nextProgress = PROGRESS_INTERVAL

for path in paths
    processedCount = processedCount + 1
    record = targets[path]
    current = computer.File(path)

    if not isFileObject(current) then
        missingCount = missingCount + 1
    else if current.path != path or not isDirectChild(record["trash"], current.path) then
        print(paint("BOUNDARY REFUSED", COLOR_RED) + " changed target: " + path)
        failedCount = failedCount + 1
    else
        result = current.delete
        if not isFileObject(computer.File(path)) then
            deletedCount = deletedCount + 1
        else
            print(paint("DELETE FAILED", COLOR_RED) + " " + path + " | " + str(result))
            failedCount = failedCount + 1
        end if
    end if

    if processedCount >= nextProgress or processedCount == paths.len then
        print(paint("Progress", COLOR_GREEN) + " " + processedCount + "/" + paths.len)
        nextProgress = nextProgress + PROGRESS_INTERVAL
    end if
end for

remainingCount = 0
verificationIssues = 0
for trashPath in trashPaths
    trash = computer.File(trashPath)
    if not isFileObject(trash) or trash.is_folder != 1 or trash.path != trashPath then
        print(paint("VERIFY ERROR", COLOR_RED) + " trash root was not preserved: " + trashPath)
        verificationIssues = verificationIssues + 1
        continue
    end if
    files = trash.get_files
    folders = trash.get_folders
    if typeof(files) != "list" or typeof(folders) != "list" then
        print(paint("VERIFY ERROR", COLOR_RED) + " could not inspect: " + trashPath)
        verificationIssues = verificationIssues + 1
    else
        remainingCount = remainingCount + files.len + folders.len
    end if
end for

print("")
print(paint("AUTOTRASH RESULTS", COLOR_PURPLE))
print("Deleted top-level entries: " + paint(deletedCount, COLOR_GREEN))
print("Already missing: " + paint(missingCount, COLOR_ORANGE))
print("Delete failures: " + paint(failedCount, COLOR_RED))
print("Remaining top-level entries: " + paint(remainingCount, COLOR_CYAN))
print("Verification issues: " + paint(verificationIssues, COLOR_RED))

if failedCount > 0 or remainingCount > 0 or verificationIssues > 0 then
    print(paint("RESULT INCOMPLETE", COLOR_RED) + " | review the reported paths")
else
    print(paint("TRASH CLEAN", COLOR_GREEN) + " | every discovered trash root was preserved and emptied")
end if
