//Made By Hobo & Rowan
// AutoHack 3.0.0 retained-access, exact-LAN discovery, embedded deep
// recon, poison-library promotion, interesting-file inventory, Blackout, and
// host-fortification tool for Grey Hack Public.
//
// AutoHack is a clean rebuild informed by the preserved BlueHack donor, the
// field-proven Auto Family engines, and the preserved Nmap Synthwave Deep Recon
// version-one donor. One public IP plus an optional port and/or exact LAN IP drives
// the whole access sequence: discover every visible endpoint, reuse or expand
// ACVDB3, rank exploits, recover root credentials, retain the strongest usable
// shell, and replace computer/router logs before and after operator-opened
// target actions. The two-address form <public-ip> <lan-ip> scans every visible
// service while requiring that exact LAN machine; the three-address form adds
// an exact service port. The native nmap command embeds the complete read-only
// synthwave topology engine and always returns to the persistent AutoHack
// console without altering retained access state.
// The interesting command records non-stock metadata without reading contents.
// The Rowan circuit prompt keeps execution origin, selected retained target,
// authority, and cleanup state visible. Matching weak libraries can be promoted
// from /root/PoisonLibs through separately obtained root file/computer authority.
// Confirmation-gated nuke and harden operations remain isolated from ordinary
// attack and reconnaissance paths.

SCRIPT_VERSION = "3.0.0"

// Personal activation PIN. The GitHub-ready source leaves this blank.
PIN = ""

AUTOSCRIPTS_ROOT = "/root/autoscripts"
APP_ROOT = "/root/autoscripts/autohack"
LOG_ROOT = "/root/autoscripts/autohack/logs"

VULN_DB_ROOT = "/root/vulndb"
VULN_DB_INDEX_PATH = "/root/vulndb/index.txt"
VULN_DB_INDEX_HEADER = "ACVDBINDEX3"
VULN_DB_SHARD_PREFIX = "shard-"
VULN_DB_SHARD_LIMIT = 120000
VULN_DB_SOURCE = "autohack"

MAX_RESULTS_PER_SERVICE = 24
MAX_ACCESS_SESSIONS = 12
INTERESTING_SCAN_LIMIT = 4000
INTERESTING_RESULT_LIMIT = 250
HELPER_WAIT_SECONDS = 60
FINALIZER_WAIT_SECONDS = 2
ROOT_PASSWORD_INJECT = "af2026"

// Shared Auto Family weak-library arsenal. A file whose name matches the
// currently attacked service library is eligible for endpoint promotion. The
// initial field set is kernel_router.so and libhttp.so; future weak libraries
// become available automatically when placed in this same directory.
POISON_LIB_ROOT = "/root/PoisonLibs"
REBOOT_SOURCE = "/bin/reboot"
POISON_REBOOT_WAIT_SECONDS = 3

// High-impact standalone operations. Nuke is bounded to these exact system
// roots and never runs without an exact retained root shell plus a host-specific
// confirmation. Harden affects only the AutoHack execution host and requires a
// separate host-specific confirmation.
NUKE_ROOTS = ["/boot", "/etc", "/home", "/lib", "/root", "/server", "/sys", "/usr"]
NUKE_PRESERVE_BIN = ["/bin/rm", "/bin/rmdir"]
NUKE_SCAN_LIMIT = 8000
HOME_HARDEN_TRAVERSE = ["/", "/usr", "/usr/bin", "/bin"]
HOME_HARDEN_EXECUTE = ["/usr/bin/Terminal.exe", "/bin/sudo", "/bin/bash"]

// Development behavior. Unknown service libraries are scanned and added to the
// shared ACVDB3 database. Disable this to use known vulnerability records only.
LEARN_UNKNOWN_LIBRARIES = true

// The target computer must always be cleaned. Target-router cleanup remains
// best-effort because the verified clean execution route is the owned chain
// break; its actual result is printed and written to diagnostics.
REQUIRE_TARGET_ROUTER_CLEAN = false
REQUIRE_EXECUTION_ROUTER_CLEAN = true

COLOR_PURPLE = "#D86CFF"
COLOR_CYAN = "#55E7FF"
COLOR_GREEN = "#63FF9B"
COLOR_RED = "#FF5C7C"
COLOR_ORANGE = "#FFB86B"
COLOR_PINK = "#FF79C6"
COLOR_LAVENDER = "#C7A7E8"
COLOR_DIM = "#A79BC8"

// Known Grey Hack operating-system and service files. AutoHack suppresses only
// these exact paths; an unfamiliar tool living beside them is still reported.
// Comparisons are case-insensitive so player-created capitalization cannot make
// an ordinary stock file look rare.
INTERESTING_STOCK_PATHS = [
    "/boot/kernel.img", "/boot/initrd.img", "/boot/system.map",
    "/etc/passwd", "/etc/xorg.conf", "/etc/fstab",
    "/etc/apt/sources.txt", "/etc/apt/aptcache.bin",
    "/lib/init.so", "/lib/kernel_module.so", "/lib/net.so",
    "/lib/aptclient.so", "/lib/metaxploit.so", "/lib/crypto.so",
    "/lib/libsmtp.so", "/lib/libssh.so", "/lib/libhttp.so", "/lib/libftp.so",
    "/sys/xorg.sys", "/sys/config.sys", "/sys/network.cfg", "/var/system.log",
    "/bin/cd", "/bin/ls", "/bin/ps", "/bin/pwd", "/bin/ifconfig",
    "/bin/iwconfig", "/bin/iwlist", "/bin/cat", "/bin/rm", "/bin/mv",
    "/bin/cp", "/bin/ssh", "/bin/ftp", "/bin/mkdir", "/bin/rmdir",
    "/bin/chmod", "/bin/reboot", "/bin/whois", "/bin/sudo", "/bin/useradd",
    "/bin/userdel", "/bin/passwd", "/bin/nslookup", "/bin/build", "/bin/touch",
    "/bin/chown", "/bin/chgrp", "/bin/groupadd", "/bin/groupdel", "/bin/groups",
    "/bin/kill", "/bin/ping", "/bin/apt-get", "/bin/man", "/bin/whoami",
    "/usr/bin/fileexplorer.exe", "/usr/bin/terminal.exe", "/usr/bin/mail.exe",
    "/usr/bin/browser.exe", "/usr/bin/notepad.exe", "/usr/bin/settings.exe",
    "/usr/bin/logviewer.exe", "/usr/bin/codeeditor.exe", "/usr/bin/imageviewer.exe",
    "/usr/bin/pdfreader.exe", "/usr/bin/map.exe", "/usr/bin/manual.exe",
    "/usr/bin/scanlan.exe", "/usr/bin/chat.exe",
    "/server/smtpd", "/server/sshd", "/server/httpd", "/server/ftpd",
    "/server/encode.src", "/server/decode.bin", "/server/conf/smtpd.conf",
    "/server/conf/userconfig.sys", "/server/conf/sshd.conf",
    "/server/conf/httpd.conf", "/server/conf/ftpd.conf",
    "/public/htdocs/website.html",]


paint = function(value, color)
    return "<color=" + color + ">" + str(value) + "</color>"
end function


action_piece_color = function(piece, label)
    lowered = piece.lower
    label_lower = label.lower
    if lowered.indexOf("failed") != null or lowered.indexOf("mismatch") != null or
        lowered.indexOf("unavailable") != null or lowered.indexOf("exhausted") != null or
        lowered.indexOf("not found") != null then return COLOR_RED
    if lowered == "root" or lowered == "guest" or lowered.indexOf("credential") != null or
        lowered.indexOf("authority") != null then return COLOR_PINK
    if piece.indexOf("@") != null or (piece.indexOf(":") != null and piece.indexOf(" ") == null) then return COLOR_CYAN
    if piece.indexOf("/") == 0 then return COLOR_ORANGE
    if label_lower.indexOf("endpoint") != null or label_lower.indexOf("library") != null or
        label_lower.indexOf("reconnect") != null or lowered.indexOf("endpoint") != null then return COLOR_CYAN
    if lowered.indexOf("retained") != null or lowered.indexOf("installed") != null or
        lowered.indexOf("reacquired") != null or lowered.indexOf("ready") != null or
        lowered.indexOf("accepted") != null then return COLOR_GREEN
    if lowered.indexOf("waiting") != null or lowered.indexOf("skipped") != null or
        lowered.indexOf("attempt") != null or lowered.indexOf("continuing") != null then return COLOR_ORANGE
    return COLOR_DIM
end function


show_auto_action = function(label, detail = "", color = COLOR_PURPLE)
    line = paint("◆ " + label, color)
    if detail != "" then
        pieces = detail.split("[|]")
        for piece in pieces
            piece = piece.trim
            if piece == "" then continue
            if line.indexOf("  ") != null then line = line + "  |  " else line = line + "  "
            line = line + paint(piece, action_piece_color(piece, label))
        end for
    end if
    print(line)
end function


show_attack_attempt = function(fingerprint, attempt, mode)
    line = paint("◆ ATTACK", COLOR_PURPLE) + " " +
        paint("[" + attempt + "]", COLOR_PINK) + " " +
        paint(fingerprint, COLOR_CYAN) + "  " + paint(mode, COLOR_ORANGE)
    print(line)
end function


show_attack_result = function(value, target_match = true)
    kind = typeof(value).lower
    if is_exploit_object(value) then
        if is_shell(value) and not target_match then
            print(paint("  ╰ OBJECT REJECTED", COLOR_ORANGE) + "  " +
                paint("shell target mismatch", COLOR_RED))
            return
        end if
        authority = access_level(value)
        if is_shell(value) then
            print(paint("  ╰ ACCESS RETAINED", COLOR_GREEN) + "  " + paint(kind, COLOR_CYAN) +
                "  authority=" + paint(authority, COLOR_PINK))
        else
            print(paint("  ╰ OBJECT RETAINED", COLOR_GREEN) + "  " + paint(kind, COLOR_CYAN) +
                "  authority=" + paint(authority, COLOR_PINK))
        end if
        return
    end if
    if kind == "number" then
        print(paint("  ╰ PAYLOAD ACCEPTED", COLOR_GREEN) + "  " +
            paint("numeric return", COLOR_PINK))
        return
    end if
    print(paint("  ╰ NO USABLE RESULT", COLOR_RED) + "  " + paint(kind, COLOR_RED))
end function


show_banner = function()
    print("                       " + paint("◆", COLOR_PINK) + "      " +
        paint("◆", COLOR_CYAN))
    print(paint("                       │      │", COLOR_PURPLE))
    print("    " + paint("◆", COLOR_PINK) +
        paint("──────────╮   ╭───┴──────┴───╮", COLOR_PURPLE))
    print(paint("               ├───┤   ", COLOR_PURPLE) +
        paint("AUTOHACK", COLOR_PINK) + paint("   ├────────", COLOR_PURPLE) +
        paint("◆", COLOR_GREEN))
    print("    " + paint("◆", COLOR_CYAN) +
        paint("──────────╯   ╰──────┬───────╯        │", COLOR_PURPLE))
    print(paint("    │                     │         ╭──────╯", COLOR_PURPLE))
    print(paint("    ╰─────────────────────", COLOR_PURPLE) +
        paint("◆", COLOR_CYAN) + paint("─────────╯", COLOR_PURPLE))
    print(paint("      ROWAN CIRCUIT // ", COLOR_PURPLE) + paint(SCRIPT_VERSION, COLOR_CYAN))
end function


require_pin = function()
    if PIN == "" then
        show_auto_action("AUTOHACK LOCKED", "configure PIN in the source", COLOR_RED)
        return false
    end if
    origin = globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
    print(paint("╭─◆ AUTOHACK ◆─", COLOR_PURPLE) + paint("[PIN REQUIRED]", COLOR_ORANGE))
    entered = user_input(paint("╰─ORIGIN ", COLOR_ORANGE) + paint(origin, COLOR_CYAN) +
        paint(" ─▶ ENTER PIN ─▶ ", COLOR_GREEN), 1)
    if entered != PIN then
        show_auto_action("AUTHORITY DENIED", "invalid PIN", COLOR_RED)
        return false
    end if
    show_auto_action("AUTHORITY", "PIN accepted", COLOR_GREEN)
    return true
end function


join_path = function(folder, name)
    if folder == "/" then return "/" + name
    if folder[-1] == "/" then return folder + name
    return folder + "/" + name
end function


is_file = function(value)
    return typeof(value).lower == "file"
end function


is_shell = function(value)
    return typeof(value).lower == "shell"
end function


is_computer = function(value)
    return typeof(value).lower == "computer"
end function


is_session = function(value)
    return typeof(value).lower == "netsession"
end function


is_meta_lib = function(value)
    return typeof(value).lower == "metalib"
end function


is_exploit_object = function(value)
    kind = typeof(value).lower
    return kind == "shell" or kind == "computer" or kind == "file"
end function


add_unique = function(values, value)
    if typeof(value).lower != "string" then return
    if value == "" then return
    if values.indexOf(value) == null then values.push(value)
end function


safe_field = function(value)
    if typeof(value).lower != "string" then return false
    if value.indexOf("|") != null then return false
    if value.indexOf(char(10)) != null then return false
    if value.indexOf(char(13)) != null then return false
    return true
end function


db_field = function(value)
    cleaned = str(value).replace("[|]", "/")
    cleaned = cleaned.replace(char(10), " ")
    cleaned = cleaned.replace(char(13), " ")
    return cleaned.trim
end function


path_component = function(value)
    cleaned = db_field(value)
    cleaned = cleaned.replace("[/]", "_")
    cleaned = cleaned.replace("[:]", "_")
    cleaned = cleaned.replace(" ", "_")
    cleaned = cleaned.replace("@", "_")
    if cleaned == "" then cleaned = "unknown"
    return cleaned
end function


pad4 = function(number)
    digits = str(number)
    while digits.len < 4
        digits = "0" + digits
    end while
    return digits
end function


ensure_folder_path = function(path)
    computer = globals.local_computer
    current = "/"
    for part in path.split("/")
        part = part.trim
        if part == "" then continue
        next_path = join_path(current, part)
        item = computer.File(next_path)
        if is_file(item) then
            if not item.is_folder then return null
        else
            if computer.create_folder(current, part) != 1 then return null
            item = computer.File(next_path)
            if not is_file(item) or not item.is_folder then return null
        end if
        current = next_path
    end for
    return computer.File(path)
end function


touch_file = function(folder, name)
    if not is_file(folder) then return null
    path = join_path(folder.path, name)
    file = globals.local_computer.File(path)
    if is_file(file) then return file
    if globals.local_computer.touch(folder.path, name) != 1 then return null
    return globals.local_computer.File(path)
end function


init_storage = function()
    globals.app_folder = ensure_folder_path(APP_ROOT)
    globals.log_folder = ensure_folder_path(LOG_ROOT)
    globals.vuln_folder = ensure_folder_path(VULN_DB_ROOT)
    if not is_file(globals.app_folder) then return false
    if not is_file(globals.log_folder) then return false
    if not is_file(globals.vuln_folder) then return false
    return true
end function


semantic_diag_color = function(key, value, context)
    key_lower = key.lower
    value_lower = value.lower
    context_lower = context.lower
    if value_lower.indexOf("failed") != null or value_lower.indexOf("rejected") != null or
        value_lower.indexOf("refused") != null or value_lower.indexOf("unavailable") != null or
        value_lower.indexOf("invalid") != null or value_lower.indexOf("exhausted") != null or
        value_lower.indexOf("not-found") != null or value_lower.indexOf("not_found") != null then return COLOR_RED
    if key_lower.indexOf("risk") != null then
        if value_lower == "0" or value_lower == "false" or value_lower == "no" then return COLOR_GREEN
        return COLOR_RED
    end if
    if key_lower.indexOf("failed") != null then
        if value_lower == "0" or value_lower == "false" or value_lower == "no" then return COLOR_GREEN
        return COLOR_RED
    end if
    if value_lower == "yes" or value_lower == "true" or value_lower == "success" or
        value_lower == "ready" or value_lower == "complete" or value_lower == "completed" or
        value_lower == "retained" or value_lower == "saved" or value_lower == "staged" or
        value_lower == "clean" then return COLOR_GREEN
    if value_lower == "no" or value_lower == "false" or value_lower == "unknown" or
        value_lower == "skipped" or value_lower == "cancelled" or value_lower == "masked" then return COLOR_ORANGE
    if key_lower.indexOf("authority") != null or key_lower.indexOf("user") != null or
        key_lower.indexOf("credential") != null or key_lower.indexOf("password") != null or
        key_lower.indexOf("session") != null or key_lower.indexOf("index") != null then return COLOR_PINK
    if key_lower.indexOf("host") != null or key_lower.indexOf("endpoint") != null or
        key_lower.indexOf("router") != null or key_lower.indexOf("ip") != null or
        key_lower.indexOf("lan") != null or key_lower.indexOf("port") != null or
        key_lower.indexOf("library") != null or key_lower == "lib" or
        key_lower.indexOf("version") != null or key_lower.indexOf("schema") != null or
        key_lower.indexOf("bucket") != null or key_lower.indexOf("service") != null then return COLOR_CYAN
    if key_lower.indexOf("path") != null or key_lower.indexOf("file") != null or
        key_lower.indexOf("folder") != null or key_lower.indexOf("source") != null then
        if context_lower.indexOf("cleanup") != null or context_lower.indexOf("log ") != null or
            context_lower.indexOf("poison") != null then return COLOR_ORANGE
        return COLOR_PURPLE
    end if
    if key_lower.indexOf("vuln") != null or key_lower.indexOf("region") != null or
        key_lower.indexOf("overflow") != null then return COLOR_PURPLE
    if key_lower.indexOf("mode") != null or key_lower.indexOf("reason") != null or
        key_lower.indexOf("status") != null or key_lower.indexOf("state") != null or
        key_lower.indexOf("requested") != null then return COLOR_ORANGE
    if key_lower.indexOf("count") != null or key_lower.indexOf("entries") != null or
        key_lower.indexOf("attempt") != null or key_lower.indexOf("result") != null or
        key_lower.indexOf("computer") != null or key_lower.indexOf("objects") != null or
        key_lower.indexOf("deleted") != null or key_lower.indexOf("preserved") != null or
        key_lower.indexOf("retained") != null then return COLOR_PINK
    return COLOR_DIM
end function


semantic_diag_field = function(field, context)
    cleaned = field.trim
    if cleaned == "" then return ""
    equals = cleaned.indexOf("=")
    if equals == null then return paint(cleaned, semantic_diag_color("", cleaned, context))
    key = cleaned[:equals].trim
    value = cleaned[equals + 1:].trim
    return key.replace("_", " ") + "=" + paint(value, semantic_diag_color(key, value, context))
end function


semantic_diag_lead = function(lead)
    cleaned = lead.trim
    lowered = cleaned.lower
    if cleaned == "" then return ""
    if lowered.indexOf("failed") != null or lowered.indexOf("refused") != null or
        lowered.indexOf("rejected") != null or lowered.indexOf("unavailable") != null or
        lowered.indexOf("exhausted") != null then return paint(cleaned, COLOR_RED)
    if lowered.indexOf("complete") != null or lowered.indexOf("ready") != null or
        lowered.indexOf("retained") != null or lowered.indexOf("recovered") != null or
        lowered.indexOf("installed") != null then return paint(cleaned, COLOR_GREEN)
    if lowered.indexOf("cleanup") != null or lowered.indexOf("clean") != null or
        lowered.indexOf("promotion") != null or lowered.indexOf("staged") != null or
        lowered.indexOf("skipped") != null or lowered.indexOf("nuke") != null or
        lowered.indexOf("harden") != null then return paint(cleaned, COLOR_ORANGE)
    if lowered.indexOf("credential") != null or lowered.indexOf("password") != null then return paint(cleaned, COLOR_PINK)
    if lowered.indexOf("vuln") != null or lowered.indexOf("scan") != null then return paint(cleaned, COLOR_PURPLE)
    return paint(cleaned, COLOR_DIM)
end function


terminal_diag = function(message, line)
    lowered = message.lower
    label = "EVENT"
    label_color = COLOR_PURPLE
    if lowered.indexOf("cleanup") != null or lowered.indexOf("logs clean") != null or
        lowered.indexOf("finalizer") != null then
        label = "CLEANUP"
        label_color = COLOR_ORANGE
    else if lowered.indexOf("vuln") != null or lowered.indexOf("scan") != null then
        label = "VULNERABILITY"
    else if lowered.indexOf("credential") != null then
        label = "AUTHORITY"
        label_color = COLOR_PINK
    else if lowered.indexOf("poison") != null then
        label = "POISONLIB"
    else if lowered.indexOf("nuke") != null then
        label = "BLACKOUT"
        label_color = COLOR_RED
    else if lowered.indexOf("harden") != null then
        label = "FORTIFICATION"
        label_color = COLOR_ORANGE
    else if lowered.indexOf("target") != null then
        label = "TARGET"
    else if lowered.indexOf("access ready") != null then
        label = "ACCESS RETAINED"
        label_color = COLOR_GREEN
    else if lowered.indexOf("startup") != null then
        label = "STARTUP"
    else if lowered.indexOf("shutdown") != null then
        label = "SHUTDOWN"
        label_color = COLOR_ORANGE
    end if
    if lowered.indexOf("failed") != null or lowered.indexOf("refused") != null or
        lowered.indexOf("unavailable") != null then label_color = COLOR_RED
    if label == "EVENT" and (lowered.indexOf("complete") != null or
        lowered.indexOf("ready") != null or lowered.indexOf("recovered") != null) then
        label = "READY"
        label_color = COLOR_GREEN
    end if
    parts = message.split("[|]")
    lead = parts[0].trim
    output = paint("◆ " + label, label_color) + "  " + paint("[AHLOG " + globals.log_seq + "]", COLOR_DIM)
    lead_output = semantic_diag_lead(lead)
    if lead_output != "" then output = output + "  " + lead_output
    branch = ""
    fields_on_branch = 0
    if parts.len > 1 then
        for index in range(1, parts.len - 1)
            field_output = semantic_diag_field(parts[index], lead)
            if field_output == "" then continue
            if fields_on_branch == 0 then branch = paint("  ╰ ", COLOR_DIM) + field_output else branch = branch + "  |  " + field_output
            fields_on_branch = fields_on_branch + 1
            if fields_on_branch == 2 then
                output = output + char(10) + branch
                branch = ""
                fields_on_branch = 0
            end if
        end for
    end if
    if fields_on_branch > 0 then output = output + char(10) + branch
    return output
end function


init_log = function()
    globals.log_seq = 0
    globals.log_pending = []
    globals.log_file = touch_file(globals.log_folder, "latest.txt")
    if not is_file(globals.log_file) then return false
    header = "AutoHack diagnostic log" + char(10) +
        "version=" + SCRIPT_VERSION + char(10) +
        "started=" + current_date + char(10) +
        "execution_host=" + globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
    return globals.log_file.set_content(header) == 1
end function


flush_log = function()
    if not is_file(globals.log_file) then return false
    if globals.log_pending.len == 0 then return true
    content = globals.log_file.get_content
    if typeof(content).lower != "string" then return false
    if globals.log_file.set_content(content + char(10) + globals.log_pending.join(char(10))) != 1 then return false
    globals.log_pending = []
    return true
end function


diag = function(message)
    globals.log_seq = globals.log_seq + 1
    line = "[AHLOG " + globals.log_seq + "] " + message
    print(terminal_diag(message, line))
    globals.log_pending.push(line)
    if globals.log_pending.len >= 10 then flush_log
end function


root_from_value = function(value)
    if is_shell(value) then return value.host_computer.File("/")
    if is_computer(value) then return value.File("/")
    if is_file(value) then
        current = value
        while current.parent
            current = current.parent
        end while
        return current
    end if
    return null
end function


computer_from_value = function(value)
    if is_shell(value) then return value.host_computer
    if is_computer(value) then return value
    root = root_from_value(value)
    if not is_file(root) then return null
    return null
end function


child_named = function(folder, name)
    if not is_file(folder) or not folder.is_folder then return null
    folders = folder.get_folders
    if typeof(folders).lower == "list" then
        for child in folders
            if child.name == name then return child
        end for
    end if
    files = folder.get_files
    if typeof(files).lower == "list" then
        for child in files
            if child.name == name then return child
        end for
    end if
    return null
end function


file_from_root = function(root, path)
    if not is_file(root) then return null
    current = root
    for part in path.split("/")
        part = part.trim
        if part == "" then continue
        current = child_named(current, part)
        if not is_file(current) then return null
    end for
    return current
end function


path_ends_with = function(path, suffix)
    if typeof(path).lower != "string" or typeof(suffix).lower != "string" then return false
    if suffix.len == 0 or path.len < suffix.len then return false
    return path[path.len - suffix.len:] == suffix
end function


path_has_trash_component = function(path)
    if typeof(path).lower != "string" then return false
    for part in path.split("/")
        if part.lower == ".trash" then return true
    end for
    return false
end function


path_is_hidden = function(path)
    if typeof(path).lower != "string" then return false
    for part in path.split("/")
        if part.len > 1 and part[0] == "." then return true
    end for
    return false
end function


is_stock_interesting_path = function(path)
    if typeof(path).lower != "string" then return true
    return INTERESTING_STOCK_PATHS.indexOf(path.lower) != null
end function


interesting_category = function(file)
    path = file.path.lower
    if path_ends_with(path, ".src") then return "SOURCE"
    if path.indexOf("chat") != null or path.indexOf("message") != null or
        path.indexOf("mail.txt") != null then return "CHAT"
    if path_ends_with(path, ".png") or path_ends_with(path, ".jpg") or
        path_ends_with(path, ".jpeg") or path_ends_with(path, ".bmp") or
        path_ends_with(path, ".gif") then return "IMAGE"
    if path_ends_with(path, ".pdf") then return "PDF"
    if path_ends_with(path, ".log") then return "LOG"
    if path_ends_with(path, ".txt") or path_ends_with(path, ".md") or
        path_ends_with(path, ".rtf") then return "DOCUMENT"
    if path_ends_with(path, ".db") or path_ends_with(path, ".csv") or
        path_ends_with(path, ".json") then return "DATA"
    if path_ends_with(path, ".conf") or path_ends_with(path, ".cfg") then return "CONFIG"
    if file.is_binary or path_ends_with(path, ".exe") or path_ends_with(path, ".bin") or
        path_ends_with(path, ".so") or path_ends_with(path, ".5pk") or
        path_ends_with(path, ".mx") then return "TOOL"
    return "OTHER"
end function


interesting_color = function(category)
    if category == "SOURCE" or category == "TOOL" then return COLOR_PURPLE
    if category == "CHAT" then return COLOR_PINK
    if category == "IMAGE" or category == "PDF" or category == "DATA" then return COLOR_CYAN
    if category == "DOCUMENT" then return COLOR_GREEN
    if category == "LOG" or category == "CONFIG" then return COLOR_ORANGE
    return COLOR_PINK
end function


interesting_value = function(value)
    if value == null then return "?"
    return str(value)
end function


// Iterative and bounded so a large player machine or a symlink cycle cannot
// turn a curiosity scan into an unbounded recursive walk. Hidden paths remain
// eligible; only trash folders are skipped. Results retain strings and metadata,
// never remote File objects or contents.
inventory_interesting_files = function(root)
    results = []
    pending = [root]
    seen = {}
    scanned = 0
    stock_ignored = 0
    trash_skipped = 0
    unreadable = 0
    truncated = false
    symlink_api = false

    while pending.len > 0
        if scanned >= INTERESTING_SCAN_LIMIT or results.len >= INTERESTING_RESULT_LIMIT then
            truncated = true
            break
        end if

        node = pending.pop
        if not is_file(node) then
            unreadable = unreadable + 1
            continue
        end if
        path = node.path
        if typeof(path).lower != "string" or path == "" then
            unreadable = unreadable + 1
            continue
        end if
        if seen.hasIndex(path) then continue
        seen[path] = 1
        scanned = scanned + 1

        is_link = false
        if node.hasIndex("is_symlink") then
            symlink_api = true
            is_link = node.is_symlink == 1
        end if

        if node.is_folder then
            if path_has_trash_component(path) then
                trash_skipped = trash_skipped + 1
                continue
            end if
            if is_link then continue

            folders = node.get_folders
            files = node.get_files
            if typeof(folders).lower == "list" then
                for child in folders
                    pending.push(child)
                end for
            else
                unreadable = unreadable + 1
            end if
            if typeof(files).lower == "list" then
                for child in files
                    pending.push(child)
                end for
            else
                unreadable = unreadable + 1
            end if
            continue
        end if

        if is_stock_interesting_path(path) then
            stock_ignored = stock_ignored + 1
            continue
        end if

        results.push({
            "path": path,
            "category": interesting_category(node),
            "size": interesting_value(node.size),
            "owner": interesting_value(node.owner),
            "permissions": interesting_value(node.permissions),
            "hidden": path_is_hidden(path),
        })
    end while

    return {
        "results": results,
        "scanned": scanned,
        "stock_ignored": stock_ignored,
        "trash_skipped": trash_skipped,
        "unreadable": unreadable,
        "truncated": truncated,
        "symlink_api": symlink_api,}
end function


print_interesting_inventory = function(scan, access, session_index)
    print(char(10) + paint("INTERESTING FILES", COLOR_PURPLE) + " [" +
        paint(session_index, COLOR_CYAN) + "]")
    print("Host: " + paint(access.public_ip, COLOR_CYAN) + "/" +
        paint(access.local_ip, COLOR_CYAN) + "  Authority: " +
        paint(access.authority, COLOR_PINK))
    print("Items examined: " + paint(scan.scanned, COLOR_GREEN) +
        "  Stock ignored: " + paint(scan.stock_ignored, COLOR_ORANGE) +
        "  Interesting: " + paint(scan.results.len, COLOR_PINK))

    if scan.results.len == 0 then
        print(paint("No non-stock files were visible through this retained session.", COLOR_ORANGE))
    else
        for index in range(0, scan.results.len - 1)
            item = scan.results[index]
            hidden = ""
            if item.hidden then hidden = " " + paint("HIDDEN", COLOR_ORANGE)
            print("[" + paint(index, COLOR_CYAN) + "] " +
                paint(item.category, interesting_color(item.category)) + hidden + "  " +
                paint(item.path, COLOR_CYAN))
            print("    size=" + item.size + "  owner=" + paint(item.owner, COLOR_PINK) +
                "  permissions=" + item.permissions)
        end for
    end if

    if scan.trash_skipped > 0 then
        print(paint("Skipped " + str(scan.trash_skipped) + " trash folder(s).", COLOR_ORANGE))
    end if
    if scan.unreadable > 0 then
        print(paint(str(scan.unreadable) + " filesystem location(s) could not be enumerated.", COLOR_ORANGE))
    end if
    if not scan.symlink_api then
        print(paint("This runtime did not expose is_symlink; duplicate paths and hard limits still bounded the scan.", COLOR_ORANGE))
    end if
    if scan.truncated then
        print(paint("Inventory limit reached; results are intentionally truncated.", COLOR_ORANGE))
    end if
    print("This command lists metadata only. It does not read or download file contents.")
end function


has_rwx = function(value)
    if not is_file(value) then return false
    if not value.has_permission("r") then return false
    if not value.has_permission("w") then return false
    return value.has_permission("x")
end function


access_level = function(value)
    root = root_from_value(value)
    if not is_file(root) then return "none"
    root_home = file_from_root(root, "/root")
    if has_rwx(root_home) then return "root"
    home = file_from_root(root, "/home")
    if not is_file(home) then return "guest"
    folders = home.get_folders
    if typeof(folders).lower != "list" then return "guest"
    for folder in folders
        if folder.name == "guest" then continue
        if has_rwx(folder) then return "user"
    end for
    return "guest"
end function


scrub_source_from_value = function(value)
    root = root_from_value(value)
    if not is_file(root) then return null
    for path in ["/var/silentclean", "/etc/fstab", "/etc/xorg.conf"]
        candidate = file_from_root(root, path)
        if not is_file(candidate) then continue
        if candidate.is_folder or candidate.is_binary then continue
        if candidate.has_permission("r") then return candidate
    end for
    etc = file_from_root(root, "/etc")
    if not is_file(etc) then return null
    files = etc.get_files
    if typeof(files).lower != "list" then return null
    for candidate in files
        if candidate.is_folder or candidate.is_binary then continue
        if candidate.has_permission("r") then return candidate
    end for
    return null
end function


stage_clean_source = function(value)
    root = root_from_value(value)
    if not is_file(root) then return null

    // Grey Hack's File.copy overwrite gate is the destination folder's write
    // permission, not the existing file's write bit. This deliberately matches
    // the runtime operation clean_source performs and permits the proven case
    // where a non-root object can replace /var/system.log through writable /var.
    var_folder = file_from_root(root, "/var")
    if not is_file(var_folder) or not var_folder.is_folder then return null
    if not var_folder.has_permission("w") then return null
    return scrub_source_from_value(value)
end function


clean_source = function(source)
    if not is_file(source) then return false
    return source.copy("/var", "system.log") == 1
end function


unsafe_checks = function(provider, meta_lib, region)
    checks = []
    scan_text = provider.scan_address(meta_lib, region)
    if typeof(scan_text).lower != "string" then return checks
    pieces = scan_text.split("Unsafe check: ")
    if pieces.len < 2 then return checks
    for piece in pieces[1:]
        start = piece.indexOf("<b>")
        finish = piece.indexOf("</b>")
        if start == null or finish == null then continue
        if finish <= start + 3 then continue
        unsafe = piece[start + 3:finish].replace(char(10), "").trim
        if unsafe != "" and checks.indexOf(unsafe) == null then checks.push(unsafe)
    end for
    return checks
end function


stage_local_router_source = function(provider_path = "/lib/metaxploit.so")
    bridge = get_custom_object
    bridge.an_router_attempts = 0
    bridge.an_router_objects = 0
    bridge.an_router_detail = "starting"
    router = get_router
    if typeof(router).lower != "router" then
        bridge.an_router_detail = "router-unavailable"
        return null
    end if
    provider = include_lib(provider_path)
    if typeof(provider).lower != "metaxploitlib" then
        bridge.an_router_detail = "provider-unavailable"
        return null
    end if
    session = provider.net_use(router.public_ip, 0)
    if not is_session(session) then
        bridge.an_router_detail = "kernel-session-unavailable"
        return null
    end if
    meta_lib = session.dump_lib
    if not is_meta_lib(meta_lib) then
        bridge.an_router_detail = "kernel-library-unavailable"
        return null
    end if
    regions = provider.scan(meta_lib)
    if typeof(regions).lower != "list" then
        bridge.an_router_detail = "kernel-scan-unavailable"
        return null
    end if
    for region in regions
        for unsafe in unsafe_checks(provider, meta_lib, region)
            // Router COMPUTER results require a LAN IP. CHANGE_PASS results
            // require an alphanumeric payload. Other result types ignore the
            // argument, so these two calls cover every runtime result family
            // without the former duplicate no-argument attempt.
            bridge.an_router_attempts = bridge.an_router_attempts + 1
            show_attack_attempt(vuln_fingerprint(meta_lib), bridge.an_router_attempts, "router LAN payload")
            result = meta_lib.overflow(region, unsafe, router.local_ip)
            show_attack_result(result)
            if is_exploit_object(result) then
                bridge.an_router_objects = bridge.an_router_objects + 1
            end if
            source = stage_clean_source(result)
            if is_file(source) then
                bridge.an_router_detail = "cleanup-source-ready"
                return source
            end if

            bridge.an_router_attempts = bridge.an_router_attempts + 1
            show_attack_attempt(vuln_fingerprint(meta_lib), bridge.an_router_attempts, "router credential payload")
            result = meta_lib.overflow(region, unsafe, ROOT_PASSWORD_INJECT)
            show_attack_result(result)
            if is_exploit_object(result) then
                bridge.an_router_objects = bridge.an_router_objects + 1
            end if
            source = stage_clean_source(result)
            if is_file(source) then
                bridge.an_router_detail = "cleanup-source-ready"
                return source
            end if
        end for
    end for
    bridge.an_router_detail = "kernel-access-exhausted"
    return null
end function


router_helper_mode = function()
    bridge = get_custom_object
    bridge.an_router_source = null
    bridge.an_router_status = "running"
    provider_path = "/lib/metaxploit.so"
    if params.len > 1 then provider_path = params[1]
    source = stage_local_router_source(provider_path)
    if is_file(source) then
        bridge.an_router_source = source
        bridge.an_router_status = "ready"
    else
        bridge.an_router_status = "unavailable"
    end if
    exit
end function


writable_folder = function(shell)
    if not is_shell(shell) then return null
    computer = shell.host_computer
    root = computer.File("/root")
    if is_file(root) and root.has_permission("w") and root.has_permission("x") then return root
    homes = computer.File("/home")
    if not is_file(homes) then return null
    folders = homes.get_folders
    if typeof(folders).lower != "list" then return null
    for folder in folders
        if folder.has_permission("w") and folder.has_permission("x") then return folder
    end for
    return null
end function


deploy_router_helper = function(remote_shell)
    work = writable_folder(remote_shell)
    if not is_file(work) then return {"helper": "", "provider": "",
        "provider_owned": false, "status": "no-work-folder",}
    source_file = globals.local_computer.File(program_path)
    if not is_file(source_file) then return {"helper": "", "provider": "",
        "provider_owned": false, "status": "helper-missing",}
    if globals.local_shell.scp(program_path, work.path, remote_shell) != 1 then
        return {"helper": "", "provider": "", "provider_owned": false,
            "status": "helper-copy-failed",}
    end if
    helper_path = join_path(work.path, source_file.name)
    if not is_file(remote_shell.host_computer.File(helper_path)) then
        return {"helper": "", "provider": "", "provider_owned": false,
            "status": "helper-not-found",}
    end if

    // Direct SCP is the field-proven provider path used by the other Auto
    // workers. File.copy from /lib into APP_ROOT can fail even when scp is
    // permitted, which is exactly what Dev3 reported as provider-stage-failed.
    provider_path = join_path(work.path, "metaxploit.so")
    remote_provider = remote_shell.host_computer.File(provider_path)
    provider_owned = false
    if is_file(remote_provider) then
        if not remote_provider.allow_import then
            return {"helper": helper_path, "provider": "", "provider_owned": false,
                "status": "provider-name-conflict",}
        end if
    else
        copy_result = globals.local_shell.scp("/lib/metaxploit.so", work.path, remote_shell)
        remote_provider = remote_shell.host_computer.File(provider_path)
        if copy_result != 1 or not is_file(remote_provider) then
            return {"helper": helper_path, "provider": "", "provider_owned": false,
                "status": "provider-copy-failed",}
        end if
        if not remote_provider.allow_import then
            return {"helper": helper_path, "provider": provider_path, "provider_owned": true,
                "status": "provider-not-importable",}
        end if
        provider_owned = true
    end if
    return {"helper": helper_path, "provider": provider_path,
        "provider_owned": provider_owned, "status": "ready",}
end function


stage_remote_router_source = function(remote_shell)
    deployment = deploy_router_helper(remote_shell)
    helper_path = deployment.helper
    provider_path = deployment.provider
    if helper_path == "" or provider_path == "" then return {"source": null,
        "helper": helper_path, "provider": provider_path,
        "provider_owned": deployment.provider_owned,
        "attempts": 0, "objects": 0, "status": deployment.status,
        "detail": "not-launched",}
    bridge = get_custom_object
    bridge.an_router_source = null
    bridge.an_router_status = "waiting"
    bridge.an_router_attempts = 0
    bridge.an_router_objects = 0
    bridge.an_router_detail = "waiting"
    remote_shell.launch(helper_path, "--router-clean-helper " + provider_path)
    waited = 0
    while waited < HELPER_WAIT_SECONDS
        if bridge.an_router_status != "waiting" and bridge.an_router_status != "running" then break
        wait(0.2)
        waited = waited + 0.2
    end while
    source = bridge.an_router_source
    status = bridge.an_router_status
    attempts = bridge.an_router_attempts
    objects = bridge.an_router_objects
    detail = bridge.an_router_detail
    bridge.an_router_source = null
    return {"source": source, "helper": helper_path, "provider": provider_path,
        "provider_owned": deployment.provider_owned,
        "attempts": attempts, "objects": objects, "status": status, "detail": detail,}
end function


delete_remote_artifact = function(remote_shell, path)
    if not is_shell(remote_shell) or path == "" then return
    file = remote_shell.host_computer.File(path)
    if is_file(file) then file.delete
end function


decipher_root_password = function(value)
    root = root_from_value(value)
    if not is_file(root) then return null
    passwd = file_from_root(root, "/etc/passwd")
    if not is_file(passwd) or not passwd.has_permission("r") then return null
    content = passwd.get_content
    if typeof(content).lower != "string" then return null
    root_hash = ""
    for line in content.split(char(10))
        fields = line.trim.split(":")
        if fields.len < 2 then continue
        if fields[0] == "root" then
            root_hash = fields[1].trim
            break
        end if
    end for
    if root_hash == "" then return null
    if root_hash == "ced421b174bd05a560a4f098565d4c7b" then return "madeinRussia"
    password = globals.crypto.decipher(root_hash)
    if typeof(password).lower != "string" or password == "" then return null
    return password
end function


vuln_fingerprint = function(meta_lib)
    return meta_lib.lib_name + "@" + meta_lib.version
end function


vuln_major = function(version)
    parts = str(version).split("[.]")
    if parts.len == 0 then return "unknown"
    return path_component(parts[0])
end function


vuln_bucket_key_values = function(library, version)
    return str(library) + "@V" + vuln_major(version)
end function


vuln_mode = function(requirement)
    lowered = requirement.lower
    if lowered.indexOf("password") != null then return "password"
    if lowered.indexOf("lan ip") != null or lowered.indexOf("local ip") != null or
        lowered.indexOf("same subnet") != null or lowered.indexOf("same network") != null or
        lowered.indexOf("router membership") != null then return "lan"
    if lowered.trim == "" then return "plain"
    return "unknown"
end function


vuln_shard_name = function(number)
    return VULN_DB_SHARD_PREFIX + pad4(number) + ".txt"
end function


vuln_folder_named = function(name, create = false)
    path = join_path(VULN_DB_ROOT, name)
    folder = globals.local_computer.File(path)
    if is_file(folder) then
        if folder.is_folder then return folder
        return null
    end if
    if not create then return null
    return ensure_folder_path(path)
end function


vuln_bucket_folder = function(library, version, create = false)
    library_folder = vuln_folder_named(path_component(library), create)
    if not is_file(library_folder) then return null
    path = join_path(library_folder.path, "V" + vuln_major(version))
    folder = globals.local_computer.File(path)
    if is_file(folder) then
        if folder.is_folder then return folder
        return null
    end if
    if not create then return null
    return ensure_folder_path(path)
end function


merge_vuln = function(fingerprint, incoming)
    if not globals.vulns.hasIndex(fingerprint) then globals.vulns[fingerprint] = []
    for known in globals.vulns[fingerprint]
        if known.region != incoming.region or known.unsafe != incoming.unsafe or
            known.mode != incoming.mode then continue
        if incoming.score > known.score then
            known.score = incoming.score
            known.last_kind = incoming.last_kind
        end if
        if incoming.hits > known.hits then known.hits = incoming.hits
        if incoming.attempts > known.attempts then known.attempts = incoming.attempts
        if known.requirement == "" and incoming.requirement != "" then known.requirement = incoming.requirement
        return false
    end for
    globals.vulns[fingerprint].push(incoming)
    return true
end function


remember_fingerprint = function(library, version)
    fingerprint = library + "@" + version
    globals.vuln_meta[fingerprint] = [library, version]
    if not globals.vulns.hasIndex(fingerprint) then globals.vulns[fingerprint] = []
    return fingerprint
end function


load_vuln_content = function(content)
    if typeof(content).lower != "string" then return 0
    loaded = 0
    for line in content.replace(char(13), "").split(char(10))
        parts = line.trim.split("[|]")
        if parts.len < 3 then continue
        if parts[0] == "S" then
            globals.vuln_scanned[parts[1] + "@" + parts[2]] = 1
            remember_fingerprint(parts[1], parts[2])
            continue
        end if
        if parts[0] != "V" or parts.len < 11 then continue
        score = parts[7].to_int
        hits = parts[8].to_int
        attempts = parts[9].to_int
        if typeof(score).lower != "number" then score = 0
        if typeof(hits).lower != "number" then hits = 0
        if typeof(attempts).lower != "number" then attempts = 0
        source = "-"
        if parts.len >= 12 then source = parts[11]
        fingerprint = remember_fingerprint(parts[1], parts[2])
        incoming = {"lib": parts[1], "version": parts[2], "region": parts[3],
            "unsafe": parts[4], "mode": parts[5], "requirement": parts[6],
            "score": score, "hits": hits, "attempts": attempts,
            "last_kind": parts[10], "source": source,}
        if merge_vuln(fingerprint, incoming) then loaded = loaded + 1
    end for
    return loaded
end function


load_vuln_index = function()
    globals.vuln_index = {}
    file = globals.local_computer.File(VULN_DB_INDEX_PATH)
    if not is_file(file) then return "missing"
    content = file.get_content
    if typeof(content).lower != "string" then return "unreadable"
    lines = content.replace(char(13), "").split(char(10))
    if lines.len == 0 or lines[0].trim != VULN_DB_INDEX_HEADER then return "incompatible"
    for line in lines[1:]
        parts = line.trim.split("[|]")
        if parts.len < 7 or parts[0] != "B" then continue
        count = parts[5].to_int
        if typeof(count).lower != "number" then count = 0
        key = parts[1] + "@V" + parts[2]
        globals.vuln_index[key] = {"lib": parts[1], "major": parts[2],
            "folder": parts[3], "bucket": parts[4], "count": count, "source": parts[6],}
    end for
    return VULN_DB_INDEX_HEADER
end function


load_vuln_bucket = function(meta_lib)
    bucket_key = vuln_bucket_key_values(meta_lib.lib_name, meta_lib.version)
    if globals.vuln_loaded_buckets.hasIndex(bucket_key) then return 0
    globals.vuln_loaded_buckets[bucket_key] = 1
    folder = vuln_bucket_folder(meta_lib.lib_name, meta_lib.version)
    if not is_file(folder) then return 0
    count = 0
    if globals.vuln_index.hasIndex(bucket_key) then count = globals.vuln_index[bucket_key].count
    names = []
    if count > 0 then
        number = 1
        while number <= count
            names.push(vuln_shard_name(number))
            number = number + 1
        end while
    else
        files = folder.get_files
        if typeof(files).lower == "list" then
            for file in files
                if file.name.indexOf(VULN_DB_SHARD_PREFIX) == 0 then add_unique(names, file.name)
            end for
        end if
    end if
    loaded = 0
    for name in names
        file = globals.local_computer.File(join_path(folder.path, name))
        if is_file(file) then loaded = loaded + load_vuln_content(file.get_content)
    end for
    diag("vuln bucket load | bucket=" + bucket_key + " | entries=" + loaded)
    return loaded
end function


mark_vuln_dirty = function(fingerprint)
    globals.vuln_dirty = true
    globals.vuln_dirty_fingerprints[fingerprint] = 1
end function


scan_vulnerabilities = function(provider, meta_lib)
    fingerprint = vuln_fingerprint(meta_lib)
    load_vuln_bucket(meta_lib)
    remember_fingerprint(meta_lib.lib_name, str(meta_lib.version))
    if globals.vuln_scanned.hasIndex(fingerprint) then return globals.vulns[fingerprint]
    if not LEARN_UNKNOWN_LIBRARIES then return globals.vulns[fingerprint]

    regions = provider.scan(meta_lib)
    if typeof(regions).lower != "list" then return globals.vulns[fingerprint]
    for region in regions
        scan_text = provider.scan_address(meta_lib, region)
        if typeof(scan_text).lower != "string" then continue
        pieces = scan_text.split("Unsafe check: ")
        if pieces.len < 2 then continue
        for piece in pieces[1:]
            start = piece.indexOf("<b>")
            finish = piece.indexOf("</b>")
            if start == null or finish == null or finish <= start + 3 then continue
            unsafe = piece[start + 3:finish].replace(char(10), "").trim
            if unsafe == "" then continue
            requirement = piece[finish + 4:].replace("<b>", "").replace("</b>", "")
            requirement = requirement.replace("<color=red>", "").replace("</color>", "")
            requirement = requirement.replace(char(10), " ").trim
            while requirement.indexOf("  ") != null
                requirement = requirement.replace("  ", " ")
            end while
            incoming = {"lib": meta_lib.lib_name, "version": str(meta_lib.version),
                "region": region, "unsafe": unsafe, "mode": vuln_mode(requirement),
                "requirement": requirement, "score": 0, "hits": 0,
                "attempts": 0, "last_kind": "untried", "source": VULN_DB_SOURCE,}
            merge_vuln(fingerprint, incoming)
        end for
    end for
    globals.vuln_scanned[fingerprint] = 1
    mark_vuln_dirty(fingerprint)
    diag("vuln scan | library=" + fingerprint + " | entries=" + globals.vulns[fingerprint].len)
    return globals.vulns[fingerprint]
end function


ordered_vulns = function(entries)
    ordered = []
    for floor_score in [90, 70, 50, 1, -1000]
        for entry in entries
            if floor_score == 90 and entry.score >= 90 then ordered.push(entry)
            if floor_score == 70 and entry.score >= 70 and entry.score < 90 then ordered.push(entry)
            if floor_score == 50 and entry.score >= 50 and entry.score < 70 then ordered.push(entry)
            if floor_score == 1 and entry.score > 0 and entry.score < 50 then ordered.push(entry)
            if floor_score == -1000 and entry.score <= 0 then ordered.push(entry)
        end for
    end for
    return ordered
end function


requirement_ready = function(entry, session, target_lan = "")
    if entry.mode == "lan" and target_lan == "" then return false
    lowered = entry.requirement.lower
    if lowered.indexOf("root active") != null or lowered.indexOf("active root") != null then
        if not session.is_root_active_user then return false
    end if
    if lowered.indexOf("active user") != null then
        if not session.is_any_active_user then return false
    end if
    return true
end function


record_vuln_result = function(entry, result)
    entry.attempts = entry.attempts + 1
    kind = typeof(result).lower
    entry.last_kind = kind
    level = access_level(result)
    score = 0
    if is_exploit_object(result) then entry.hits = entry.hits + 1
    if level == "root" then
        score = 100
    else if level == "user" then
        score = 70
    else if kind == "shell" then
        score = 50
    else if kind == "file" then
        score = 30
    else if kind == "computer" then
        score = 35
    else if kind == "number" then
        score = 10
    end if
    if score > entry.score then entry.score = score
    mark_vuln_dirty(entry.lib + "@" + entry.version)
end function


vuln_line = function(entry)
    source = VULN_DB_SOURCE
    if entry.source != "" and entry.source != "-" then source = entry.source
    return "V|" + db_field(entry.lib) + "|" + db_field(entry.version) + "|" +
        db_field(entry.region) + "|" + db_field(entry.unsafe) + "|" +
        db_field(entry.mode) + "|" + db_field(entry.requirement) + "|" +
        entry.score + "|" + entry.hits + "|" + entry.attempts + "|" +
        db_field(entry.last_kind) + "|" + db_field(source)
end function


write_vuln_bucket = function(bucket_key)
    bucket_parts = bucket_key.split("@V")
    if bucket_parts.len < 2 then return null
    library = bucket_parts[0]
    major = bucket_parts[1]
    folder = vuln_bucket_folder(library, major + ".0.0", true)
    if not is_file(folder) then return null

    old_count = 0
    if globals.vuln_index.hasIndex(bucket_key) then old_count = globals.vuln_index[bucket_key].count
    number = 1
    lines = ["ACVDB3"]
    size = 7
    for fingerprint in globals.vuln_meta.indexes
        meta = globals.vuln_meta[fingerprint]
        if vuln_bucket_key_values(meta[0], meta[1]) != bucket_key then continue
        scan_line = "S|" + db_field(meta[0]) + "|" + db_field(meta[1])
        if size + scan_line.len + 1 > VULN_DB_SHARD_LIMIT and lines.len > 1 then
            file = touch_file(folder, vuln_shard_name(number))
            if not is_file(file) or file.set_content(lines.join(char(10))) != 1 then return null
            number = number + 1
            lines = ["ACVDB3"]
            size = 7
        end if
        lines.push(scan_line)
        size = size + scan_line.len + 1
        if globals.vulns.hasIndex(fingerprint) then
            for entry in globals.vulns[fingerprint]
                line = vuln_line(entry)
                if size + line.len + 1 > VULN_DB_SHARD_LIMIT and lines.len > 1 then
                    file = touch_file(folder, vuln_shard_name(number))
                    if not is_file(file) or file.set_content(lines.join(char(10))) != 1 then return null
                    number = number + 1
                    lines = ["ACVDB3", scan_line]
                    size = 7 + scan_line.len + 1
                end if
                lines.push(line)
                size = size + line.len + 1
            end for
        end if
    end for
    file = touch_file(folder, vuln_shard_name(number))
    if not is_file(file) or file.set_content(lines.join(char(10))) != 1 then return null
    retired = number + 1
    while retired <= old_count
        old_file = globals.local_computer.File(join_path(folder.path, vuln_shard_name(retired)))
        if is_file(old_file) then old_file.delete
        retired = retired + 1
    end while
    globals.vuln_index[bucket_key] = {"lib": library, "major": major,
        "folder": path_component(library), "bucket": "V" + major,
        "count": number, "source": VULN_DB_SOURCE,}
    return number
end function


save_vulns = function()
    if not globals.vuln_dirty then return true
    dirty_buckets = {}
    for fingerprint in globals.vuln_dirty_fingerprints.indexes
        if not globals.vuln_meta.hasIndex(fingerprint) then continue
        meta = globals.vuln_meta[fingerprint]
        dirty_buckets[vuln_bucket_key_values(meta[0], meta[1])] = 1
    end for
    for bucket_key in dirty_buckets.indexes
        if typeof(write_vuln_bucket(bucket_key)).lower != "number" then return false
    end for
    index = touch_file(globals.vuln_folder, "index.txt")
    if not is_file(index) then return false
    lines = [VULN_DB_INDEX_HEADER]
    for bucket_key in globals.vuln_index.indexes
        entry = globals.vuln_index[bucket_key]
        lines.push("B|" + db_field(entry.lib) + "|" + db_field(entry.major) + "|" +
            db_field(entry.folder) + "|" + db_field(entry.bucket) + "|" +
            entry.count + "|" + db_field(entry.source))
    end for
    if index.set_content(lines.join(char(10))) != 1 then return false
    globals.vuln_dirty = false
    globals.vuln_dirty_fingerprints = {}
    diag("vuln db save complete | buckets=" + dirty_buckets.indexes.len)
    return true
end function


init_vulns = function()
    globals.vulns = {}
    globals.vuln_meta = {}
    globals.vuln_scanned = {}
    globals.vuln_loaded_buckets = {}
    globals.vuln_dirty = false
    globals.vuln_dirty_fingerprints = {}
    state = load_vuln_index
    if state != VULN_DB_INDEX_HEADER then
        index = touch_file(globals.vuln_folder, "index.txt")
        if is_file(index) then index.set_content(VULN_DB_INDEX_HEADER)
    end if
    diag("vuln db ready | schema=" + VULN_DB_INDEX_HEADER + " | state=" + state)
end function


service_protocol = function(meta_lib)
    if not is_meta_lib(meta_lib) then return ""
    name = meta_lib.lib_name.lower
    if name.indexOf("ssh") != null then return "ssh"
    if name.indexOf("ftp") != null then return "ftp"
    return ""
end function


endpoint_exists = function(endpoints, ip, port)
    for endpoint in endpoints
        if endpoint.ip == ip and endpoint.port == port then return true
    end for
    return false
end function


discover_endpoints = function(ip, requested_port = -1, expected_lan = "")
    endpoints = []
    // Negative means the operator omitted the port and wants discovery.
    // Zero is a real public router-control endpoint in Grey Hack.
    if requested_port >= 0 then
        info = "operator-selected"
        if requested_port == 0 then info = "operator-selected router control"
        endpoints.push({"ip": ip, "port": requested_port,
            "lan": expected_lan, "info": info,})
        return endpoints
    end if

    router = get_router(ip)
    if typeof(router).lower != "router" then return endpoints
    used = router.used_ports
    if typeof(used).lower == "list" then
        for port_object in used
            if typeof(port_object).lower != "port" then continue
            port = port_object.port_number
            if endpoint_exists(endpoints, ip, port) then continue
            info = router.port_info(port_object)
            if typeof(info).lower != "string" then info = "unknown"
            endpoints.push({"ip": ip, "port": port, "lan": expected_lan, "info": info})
        end for
    end if

    // Port zero is the router control plane. Keep it last so forwarded services
    // get the first chance to return a machine shell rather than a router shell.
    if not endpoint_exists(endpoints, ip, 0) then
        endpoints.push({"ip": ip, "port": 0, "lan": expected_lan, "info": "router control"})
    end if
    return endpoints
end function


add_computer_users = function(users, value)
    root = root_from_value(value)
    if not is_file(root) then return

    home = file_from_root(root, "/home")
    if is_file(home) then
        folders = home.get_folders
        if typeof(folders).lower == "list" then
            for folder in folders
                if users.len >= 16 then return
                add_unique(users, folder.name)
            end for
        end if
    end if

    passwd = file_from_root(root, "/etc/passwd")
    if not is_file(passwd) or not passwd.has_permission("r") then return
    content = passwd.get_content
    if typeof(content).lower != "string" then return
    for line in content.split(char(10))
        if users.len >= 16 then return
        fields = line.trim.split(":")
        if fields.len < 2 then continue
        add_unique(users, fields[0].trim)
    end for
end function


shell_score = function(value)
    if not is_shell(value) then return 0
    level = access_level(value)
    if level == "root" then return 100
    if level == "user" then return 70
    return 50
end function


shell_matches_target = function(shell, public_ip, local_ip = "")
    if not is_shell(shell) then return false
    computer = shell.host_computer
    if not is_computer(computer) then return false
    if computer.public_ip != public_ip then return false
    if local_ip != "" and computer.local_ip != local_ip then return false
    return true
end function


root_shell_valid = function(shell, public_ip, local_ip = "")
    if not shell_matches_target(shell, public_ip, local_ip) then return false
    return access_level(shell) == "root"
end function


credential_key = function(ip, local_ip = "")
    if local_ip == "" then return ip
    return ip + "|" + local_ip
end function


connect_root = function(ip, port, password, protocol, local_ip = "")
    if protocol == "" then return null
    if typeof(password).lower != "string" or password == "" then return null
    shell = globals.local_shell.connect_service(ip, port, "root", password, protocol)
    if not root_shell_valid(shell, ip, local_ip) then return null
    return shell
end function


remember_root_password = function(ip, value, local_ip = "")
    key = credential_key(ip, local_ip)
    if globals.network_root_passwords.hasIndex(key) then
        return globals.network_root_passwords[key]
    end if
    password = decipher_root_password(value)
    if typeof(password).lower != "string" or password == "" then return ""
    globals.network_root_passwords[key] = password
    target = ip
    if local_ip != "" then target = target + "/" + local_ip
    diag("root credential recovered | host=" + target + " | password=masked")
    return password
end function


poison_source_for = function(library_name)
    if typeof(library_name).lower != "string" or library_name == "" then return null
    source = globals.local_computer.File(join_path(POISON_LIB_ROOT, library_name))
    if not is_file(source) or source.is_folder or not source.is_binary then return null
    return source
end function


poison_library_names = function()
    names = []
    folder = globals.local_computer.File(POISON_LIB_ROOT)
    if not is_file(folder) or not folder.is_folder then return names
    files = folder.get_files
    if typeof(files).lower != "list" then return names
    for file in files
        if file.is_folder or not file.is_binary then continue
        add_unique(names, file.name)
    end for
    return names
end function


promotion_authority_ready = function(value)
    if not is_file(value) and not is_computer(value) then return false
    if access_level(value) != "root" then return false
    root = root_from_value(value)
    if not is_file(root) then return false
    lib_folder = file_from_root(root, "/lib")
    bin_folder = file_from_root(root, "/bin")
    if not is_file(lib_folder) or not lib_folder.is_folder then return false
    if not is_file(bin_folder) or not bin_folder.is_folder then return false
    if not lib_folder.has_permission("w") then return false
    if not bin_folder.has_permission("w") then return false
    return true
end function


remember_promotion_authority = function(result, value)
    if not promotion_authority_ready(value) then return
    current = result.root_object
    if typeof(current).lower == "null" then
        result.root_object = value
        return
    end if
    // Prefer a Computer because its host identity is directly inspectable. A
    // root File remains valid promotion authority when it is the only object.
    if is_computer(value) and is_file(current) then result.root_object = value
end function


remote_promotion_stage = function(remote_shell)
    work = writable_folder(remote_shell)
    if not is_file(work) then return null
    computer = remote_shell.host_computer
    stage_name = ".autohack-promote-" + globals.poison_attempts
    stage_path = join_path(work.path, stage_name)
    stage = computer.File(stage_path)
    if not is_file(stage) then
        if computer.create_folder(work.path, stage_name) != 1 then return null
        stage = computer.File(stage_path)
    end if
    if not is_file(stage) or not stage.is_folder then return null
    if not stage.has_permission("w") or not stage.has_permission("x") then return null
    return stage
end function


remove_remote_promotion_stage = function(remote_shell, stage)
    if not is_shell(remote_shell) or not is_file(stage) then return
    files = stage.get_files
    if typeof(files).lower == "list" then
        for file in files
            file.delete
        end for
    end if
    folders = stage.get_folders
    if typeof(folders).lower == "list" then
        for folder in folders
            folder.delete
        end for
    end if
    stage.delete
end function


promote_exact_endpoint = function(endpoint, meta_lib, attack_result)
    outcome = {"eligible": false, "attempted": false, "rebooted": false,
        "status": "not-eligible", "result": null, "library": "",}
    if not globals.poison_auto then
        outcome.status = "automatic promotion disabled"
        return outcome
    end if
    if attack_result.score <= 0 or attack_result.score >= 100 then return outcome
    if not is_shell(attack_result.shell) then return outcome
    if not shell_matches_target(attack_result.shell, endpoint.ip, endpoint.lan) then return outcome
    if not promotion_authority_ready(attack_result.root_object) then return outcome
    if not is_meta_lib(meta_lib) then return outcome

    library_name = meta_lib.lib_name
    outcome.library = library_name
    outcome.eligible = true
    source = poison_source_for(library_name)
    if not is_file(source) then
        outcome.status = "matching poison library unavailable"
        globals.poison_last = library_name + " | unavailable"
        show_auto_action("POISON SKIPPED", library_name + " not found in " + POISON_LIB_ROOT, COLOR_ORANGE)
        diag("poison promotion skipped | host=" + endpoint.ip + ":" + endpoint.port +
            " | library=" + library_name + " | reason=source-unavailable")
        return outcome
    end if
    reboot_source = globals.local_computer.File(REBOOT_SOURCE)
    if not is_file(reboot_source) or reboot_source.is_folder or not reboot_source.is_binary then
        outcome.status = "local reboot binary unavailable"
        globals.poison_last = library_name + " | reboot source unavailable"
        show_auto_action("POISON SKIPPED", REBOOT_SOURCE + " unavailable", COLOR_RED)
        diag("poison promotion skipped | host=" + endpoint.ip + ":" + endpoint.port +
            " | library=" + library_name + " | reason=reboot-source-unavailable")
        return outcome
    end if

    globals.poison_attempts = globals.poison_attempts + 1
    outcome.attempted = true
    globals.poison_last = library_name + " | staging"
    show_auto_action("POISON PROMOTION", library_name + " | exact endpoint", COLOR_ORANGE)
    diag("poison promotion start | host=" + endpoint.ip + ":" + endpoint.port +
        " | lan=" + endpoint.lan + " | library=" + library_name +
        " | authority=" + typeof(attack_result.root_object).lower)

    stage = remote_promotion_stage(attack_result.shell)
    if not is_file(stage) then
        outcome.status = "remote staging unavailable"
        globals.poison_last = library_name + " | staging failed"
        show_auto_action("POISON FAILED", outcome.status, COLOR_RED)
        diag("poison promotion failed | host=" + endpoint.ip + ":" + endpoint.port +
            " | library=" + library_name + " | reason=remote-staging-unavailable")
        return outcome
    end if

    poison_copy = globals.local_shell.scp(source.path, stage.path, attack_result.shell)
    reboot_copy = globals.local_shell.scp(REBOOT_SOURCE, stage.path, attack_result.shell)
    staged_poison_path = join_path(stage.path, source.name)
    staged_reboot_path = join_path(stage.path, reboot_source.name)
    authority_root = root_from_value(attack_result.root_object)
    staged_poison = file_from_root(authority_root, staged_poison_path)
    staged_reboot = file_from_root(authority_root, staged_reboot_path)
    if poison_copy != 1 or reboot_copy != 1 or not is_file(staged_poison) or
        not is_file(staged_reboot) then
        outcome.status = "payload transfer failed"
        globals.poison_last = library_name + " | transfer failed"
        show_auto_action("POISON FAILED", outcome.status, COLOR_RED)
        diag("poison promotion failed | host=" + endpoint.ip + ":" + endpoint.port +
            " | library=" + library_name + " | reason=payload-transfer-failed" +
            " | poison_copy=" + poison_copy + " | reboot_copy=" + reboot_copy)
        remove_remote_promotion_stage(attack_result.shell, stage)
        return outcome
    end if

    lib_copy = staged_poison.copy("/lib", library_name)
    reboot_install = staged_reboot.copy("/bin", "reboot")
    installed_lib = file_from_root(authority_root, "/lib/" + library_name)
    installed_reboot = file_from_root(authority_root, "/bin/reboot")
    if lib_copy != 1 or reboot_install != 1 or not is_file(installed_lib) or
        not is_file(installed_reboot) then
        outcome.status = "root installation failed"
        globals.poison_last = library_name + " | install failed"
        show_auto_action("POISON FAILED", outcome.status, COLOR_RED)
        diag("poison promotion failed | host=" + endpoint.ip + ":" + endpoint.port +
            " | library=" + library_name + " | reason=root-installation-failed" +
            " | lib_copy=" + lib_copy + " | reboot_install=" + reboot_install)
        remove_remote_promotion_stage(attack_result.shell, stage)
        return outcome
    end if

    remove_remote_promotion_stage(attack_result.shell, stage)
    show_auto_action("POISON INSTALLED", "/lib/" + library_name + " + /bin/reboot", COLOR_GREEN)
    diag("poison installed | host=" + endpoint.ip + ":" + endpoint.port + " | lan=" + endpoint.lan + " | library=/lib/" + library_name + " | reboot=/bin/reboot")

    // The Computer API is the authority-bearing reboot path used by 5hell.
    // /bin/reboot is installed first because current routers may not expose a
    // commandable reboot until the binary exists on the target filesystem.
    clean_execution_route
    show_auto_action("TARGET REBOOT", endpoint.ip + " | waiting " +
        POISON_REBOOT_WAIT_SECONDS + "s", COLOR_ORANGE)
    attack_result.shell.host_computer.reboot
    outcome.rebooted = true
    globals.poison_last = library_name + " | rebooted; reacquiring"
    wait(POISON_REBOOT_WAIT_SECONDS)

    fresh = attack_endpoint(endpoint, false)
    fresh.risk = true
    fresh.promoted = true
    fresh.promotion = "rebooted and reacquired"
    outcome.result = fresh
    if fresh.score > 0 then
        globals.poison_successes = globals.poison_successes + 1
        globals.poison_last = library_name + " | access reacquired"
        outcome.status = "access reacquired"
        show_auto_action("POISON REACQUIRED", access_level(fresh.shell) + " shell", COLOR_GREEN)
        diag("poison promotion complete | host=" + endpoint.ip + ":" + endpoint.port +
            " | lan=" + endpoint.lan + " | library=" + library_name +
            " | authority=" + access_level(fresh.shell))
    else
        globals.poison_last = library_name + " | reacquisition failed"
        outcome.status = "reacquisition failed"
        show_auto_action("POISON REACQUIRE FAILED", "endpoint remains changed", COLOR_RED)
        diag("poison promotion failed | host=" + endpoint.ip + ":" + endpoint.port + " | lan=" + endpoint.lan + " | library=" + library_name + " | reason=reacquisition-failed | residual_risk=yes")
    end if
    return outcome
end function


reconnect_injected = function(endpoint, meta_lib, session, objects)
    protocol = service_protocol(meta_lib)
    if protocol == "" then return null

    users = []
    if session.is_root_active_user then add_unique(users, "root")
    for value in objects
        add_computer_users(users, value)
    end for
    if session.is_any_active_user then add_unique(users, "guest")

    best = null
    best_score = 0
    for user in users
        connected = globals.local_shell.connect_service(
            endpoint.ip,
            endpoint.port,
            user,
            ROOT_PASSWORD_INJECT,
            protocol)
        score = shell_score(connected)
        if not shell_matches_target(connected, endpoint.ip, endpoint.lan) then score = 0
        if score > best_score then
            best = connected
            best_score = score
        end if
        if score == 100 then return connected
    end for
    return best
end function


attack_endpoint = function(endpoint, allow_promotion = true)
    result = {"shell": null, "score": 0, "objects": [], "risk": false,
        "fingerprint": "", "reason": "access exhausted", "root_object": null,
        "promoted": false, "promotion": "not-attempted",}

    endpoint_label = endpoint.ip + ":" + endpoint.port
    if endpoint.lan != "" then endpoint_label = endpoint_label + " -> " + endpoint.lan
    show_auto_action("ENDPOINT PROBE", endpoint_label, COLOR_PURPLE)

    if endpoint.port == 0 then
        session = globals.metaxploit.net_use(endpoint.ip)
    else
        session = globals.metaxploit.net_use(endpoint.ip, endpoint.port)
    end if
    if not is_session(session) then
        result.reason = "net_use failed"
        show_auto_action("ENDPOINT REJECTED", result.reason, COLOR_RED)
        return result
    end if

    meta_lib = session.dump_lib
    if not is_meta_lib(meta_lib) then
        result.reason = "service library unavailable"
        show_auto_action("ENDPOINT REJECTED", result.reason, COLOR_RED)
        return result
    end if

    result.fingerprint = vuln_fingerprint(meta_lib)
    show_auto_action("LIBRARY READY", result.fingerprint, COLOR_PURPLE)
    protocol = service_protocol(meta_lib)
    key = credential_key(endpoint.ip, endpoint.lan)
    if protocol != "" and globals.network_root_passwords.hasIndex(key) then
        show_auto_action("ROOT RECONNECT", endpoint_label, COLOR_ORANGE)
        known = connect_root(
            endpoint.ip,
            endpoint.port,
            globals.network_root_passwords[key],
            protocol,
            endpoint.lan)
        if is_shell(known) then
            result.shell = known
            result.score = 100
            result.reason = "known root credential reused"
            show_auto_action("ACCESS RETAINED", "root | known credential", COLOR_GREEN)
            return result
        end if
        show_auto_action("ROOT RECONNECT MISSED", "continuing exploit sequence", COLOR_RED)
    end if

    entries = scan_vulnerabilities(globals.metaxploit, meta_lib)
    diag("vuln use | host=" + endpoint.ip + ":" + endpoint.port +
        " | library=" + result.fingerprint + " | entries=" + entries.len)
    if entries.len == 0 then
        result.reason = "no vulnerability entries"
        show_auto_action("ATTACK SKIPPED", result.reason, COLOR_RED)
        return result
    end if

    password_changed = false
    attempts = 0
    for entry in ordered_vulns(entries)
        if attempts >= MAX_RESULTS_PER_SERVICE then break
        if not requirement_ready(entry, session, endpoint.lan) then continue

        arguments = []
        if entry.mode == "password" then arguments = [ROOT_PASSWORD_INJECT]
        if entry.mode == "lan" then arguments = [endpoint.lan]
        if entry.mode == "plain" then arguments = ["__AH_PLAIN__"]
        if entry.mode == "unknown" then
            arguments = [ROOT_PASSWORD_INJECT, "__AH_PLAIN__"]
            if endpoint.lan != "" then
                arguments = [endpoint.lan, ROOT_PASSWORD_INJECT, "__AH_PLAIN__"]
            end if
        end if

        for argument in arguments
            if attempts >= MAX_RESULTS_PER_SERVICE then break
            attempts = attempts + 1
            result.risk = true
            attack_mode = "plain overflow"
            if argument != "__AH_PLAIN__" then attack_mode = "credential payload"
            show_attack_attempt(result.fingerprint, attempts, attack_mode)
            if argument == "__AH_PLAIN__" then
                overflow = meta_lib.overflow(entry.region, entry.unsafe)
            else
                overflow = meta_lib.overflow(entry.region, entry.unsafe, argument)
            end if
            record_vuln_result(entry, overflow)

            if typeof(overflow).lower == "number" then password_changed = true
            if is_exploit_object(overflow) then
                result.objects.push(overflow)
                globals.retained_results.push(overflow)
                remember_promotion_authority(result, overflow)
                score = shell_score(overflow)
                target_match = true
                if is_shell(overflow) then
                    target_match = shell_matches_target(overflow, endpoint.ip, endpoint.lan)
                    if not target_match then score = 0
                end if
                show_attack_result(overflow, target_match)
                if score > result.score then
                    result.shell = overflow
                    result.score = score
                end if
                remember_root_password(endpoint.ip, overflow, endpoint.lan)
                if entry.mode == "unknown" then
                    if argument == "__AH_PLAIN__" then
                        entry.mode = "plain"
                    else if endpoint.lan != "" and argument == endpoint.lan then
                        entry.mode = "lan"
                    else
                        entry.mode = "password"
                    end if
                end if
                if score == 100 then
                    result.reason = "direct root shell"
                    return result
                end if
            else
                show_attack_result(overflow)
            end if
        end for
    end for

    if protocol != "" and globals.network_root_passwords.hasIndex(key) then
        root_shell = connect_root(
            endpoint.ip,
            endpoint.port,
            globals.network_root_passwords[key],
            protocol,
            endpoint.lan)
        if is_shell(root_shell) then
            result.shell = root_shell
            result.score = 100
            result.reason = "deciphered root reconnect"
            show_auto_action("ACCESS RETAINED", "root | deciphered credential", COLOR_GREEN)
            return result
        end if
    end if

    if password_changed then
        injected = reconnect_injected(endpoint, meta_lib, session, result.objects)
        injected_score = shell_score(injected)
        if injected_score > result.score then
            result.shell = injected
            result.score = injected_score
            globals.retained_results.push(injected)
        end if
        if is_shell(injected) then
            password = remember_root_password(endpoint.ip, injected, endpoint.lan)
            if password != "" then
                root_shell = connect_root(endpoint.ip, endpoint.port, password, protocol, endpoint.lan)
                if is_shell(root_shell) then
                    result.shell = root_shell
                    result.score = 100
                    result.reason = "injected user escalated to root"
                    show_auto_action("ACCESS RETAINED", "root | injected escalation", COLOR_GREEN)
                    return result
                end if
            end if
        end if
    end if

    if allow_promotion and result.score > 0 and result.score < 100 and
        promotion_authority_ready(result.root_object) then
        promotion = promote_exact_endpoint(endpoint, meta_lib, result)
        result.promotion = promotion.status
        if promotion.rebooted and typeof(promotion.result).lower == "map" then
            return promotion.result
        end if
    end if

    if result.score > 0 then
        result.reason = access_level(result.shell) + " shell retained"
        show_auto_action("ACCESS RETAINED", result.reason, COLOR_GREEN)
    else
        show_auto_action("ACCESS EXHAUSTED", attempts + " attempt(s)", COLOR_RED)
    end if
    return result
end function


retry_known_root = function(endpoints, ip, local_ip = "")
    key = credential_key(ip, local_ip)
    if not globals.network_root_passwords.hasIndex(key) then return null
    password = globals.network_root_passwords[key]
    for endpoint in endpoints
        if endpoint.port == 0 then continue
        session = globals.metaxploit.net_use(endpoint.ip, endpoint.port)
        if not is_session(session) then continue
        meta_lib = session.dump_lib
        protocol = service_protocol(meta_lib)
        if protocol == "" then continue
        shell = connect_root(endpoint.ip, endpoint.port, password, protocol, local_ip)
        if is_shell(shell) then return shell
    end for
    return null
end function


clean_execution_route = function()
    computer_ok = clean_source(globals.execution_computer_source)
    router_ok = clean_source(globals.execution_router_source)
    if computer_ok and router_ok then
        diag("execution logs clean | computer=yes | router=yes")
        return true
    end if
    diag("execution log cleanup failed | computer=" + computer_ok + " | router=" + router_ok)
    return false
end function


prepare_execution_cleanup = function()
    globals.execution_computer_source = stage_clean_source(globals.local_shell)
    globals.execution_router_source = stage_local_router_source
    computer_ready = is_file(globals.execution_computer_source)
    router_ready = is_file(globals.execution_router_source)
    bridge = get_custom_object
    diag("execution cleanup staged | host=" + globals.local_computer.public_ip + "/" +
        globals.local_computer.local_ip + " | computer=" + computer_ready + " | router=" + router_ready +
        " | router_attempts=" + bridge.an_router_attempts +
        " | router_objects=" + bridge.an_router_objects +
        " | router_detail=" + bridge.an_router_detail)
    if not computer_ready then return false
    if REQUIRE_EXECUTION_ROUTER_CLEAN and not router_ready then return false
    return true
end function


stage_target_cleanup = function(shell)
    computer_source = stage_clean_source(shell)
    router_stage = stage_remote_router_source(shell)
    router_source = router_stage.source
    helper_path = router_stage.helper
    provider_path = router_stage.provider
    delete_remote_artifact(shell, helper_path)
    if router_stage.provider_owned then delete_remote_artifact(shell, provider_path)
    helper_path = ""
    provider_path = ""

    computer_ready = is_file(computer_source)
    router_ready = is_file(router_source)
    computer = shell.host_computer
    diag("target cleanup staged | host=" + computer.public_ip + "/" + computer.local_ip +
        " | computer=" + computer_ready + " | router=" + router_ready +
        " | router_attempts=" + router_stage.attempts +
        " | router_objects=" + router_stage.objects +
        " | helper_status=" + router_stage.status +
        " | router_detail=" + router_stage.detail)
    return {"computer": computer_source, "router": router_source,
        "computer_ready": computer_ready, "router_ready": router_ready,}
end function


cleanup_target = function(staged)
    computer_ok = clean_source(staged.computer)
    router_ok = clean_source(staged.router)
    diag("target cleanup complete | computer=" + computer_ok + " | router=" + router_ok)
    return {"computer": computer_ok, "router": router_ok}
end function


remember_access_session = function(shell, staged, authority, promoted = false, promotion = "not-attempted")
    if not is_shell(shell) then return -1
    computer = shell.host_computer
    while globals.access_sessions.len >= MAX_ACCESS_SESSIONS
        globals.access_sessions.remove(0)
    end while
    globals.access_sessions.push({
        "shell": shell,
        "staged": staged,
        "public_ip": computer.public_ip,
        "local_ip": computer.local_ip,
        "authority": authority,
        "promoted": promoted,
        "promotion": promotion,
        "router_ready": staged.router_ready,
        "state": "ready",
        "uses": 0,
        "retained": current_date,
        "last_computer_clean": true,
        "last_router_clean": staged.router_ready,
        "last_execution_clean": true,})
    index = globals.access_sessions.len - 1
    globals.active_session = index
    return index
end function


run_target = function(ip, requested_port = -1, expected_lan = "")
    if not prepare_execution_cleanup then
        diag("target refused | reason=execution cleanup unavailable")
        flush_log
        return false
    end if
    clean_execution_route

    endpoints = discover_endpoints(ip, requested_port, expected_lan)
    if endpoints.len == 0 then
        diag("target refused | host=" + ip + " | reason=no endpoints")
        flush_log
        clean_execution_route
        return false
    end if

    print(char(10) + paint("AutoHack target", COLOR_PURPLE))
    print("Public IP: " + paint(ip, COLOR_CYAN))
    print("Endpoints: " + paint(endpoints.len, COLOR_GREEN))
    if expected_lan != "" then
        print("Exact LAN machine: " + paint(expected_lan, COLOR_CYAN))
    end if
    diag("target start | host=" + ip + " | endpoints=" + endpoints.len +
        " | requested_port=" + requested_port + " | requested_lan=" + expected_lan)

    best_shell = null
    best_score = 0
    best_promoted = false
    best_promotion = "not-attempted"
    risky_endpoints = 0
    for endpoint in endpoints
        print(char(10) + paint("Endpoint ", COLOR_PURPLE) +
            paint(endpoint.ip + ":" + endpoint.port, COLOR_CYAN) + "  " + endpoint.info)
        attack = attack_endpoint(endpoint)
        if attack.risk then risky_endpoints = risky_endpoints + 1
        if attack.score > best_score then
            best_shell = attack.shell
            best_score = attack.score
            best_promoted = attack.promoted
            best_promotion = attack.promotion
        end if
        if attack.score == 100 then break
    end for

    if best_score < 100 then
        root_retry = retry_known_root(endpoints, ip, expected_lan)
        if is_shell(root_retry) then
            best_shell = root_retry
            best_score = 100
            best_promoted = false
            best_promotion = "known root retry"
        end if
    end if

    if not is_shell(best_shell) then
        globals.retained_results = []
        save_vulns
        diag("target failed | host=" + ip + " | residual_risk_endpoints=" + risky_endpoints + " | reason=no usable shell")
        flush_log
        wait(FINALIZER_WAIT_SECONDS)
        clean_execution_route
        return false
    end if

    authority = access_level(best_shell)
    target_computer = best_shell.host_computer
    if expected_lan != "" and target_computer.local_ip != expected_lan then
        globals.retained_results = []
        best_shell = null
        save_vulns
        diag("target refused | host=" + ip + " | requested_lan=" + expected_lan + " | reason=returned shell belongs to another LAN machine")
        flush_log
        wait(FINALIZER_WAIT_SECONDS)
        clean_execution_route
        return false
    end if
    staged = stage_target_cleanup(best_shell)
    if not staged.computer_ready then
        globals.retained_results = []
        best_shell = null
        save_vulns
        diag("target refused | host=" + ip + " | reason=target computer cleanup unavailable")
        flush_log
        wait(FINALIZER_WAIT_SECONDS)
        clean_source(staged.computer)
        clean_source(staged.router)
        clean_execution_route
        return false
    end if
    if REQUIRE_TARGET_ROUTER_CLEAN and not staged.router_ready then
        globals.retained_results = []
        best_shell = null
        save_vulns
        diag("target refused | host=" + ip + " | reason=target router cleanup unavailable")
        flush_log
        wait(FINALIZER_WAIT_SECONDS)
        clean_source(staged.computer)
        clean_source(staged.router)
        clean_execution_route
        return false
    end if

    globals.retained_results = []
    save_vulns
    diag("access ready | host=" + target_computer.public_ip + "/" +
        target_computer.local_ip + " | authority=" + authority +
        " | router_cleanup=" + staged.router_ready +
        " | poison_promoted=" + best_promoted +
        " | promotion=" + best_promotion)
    flush_log

    // Remove the helper upload/deletion and all exploit evidence before retaining
    // the shell. Opening a target terminal is a separate operator action so a
    // successful attack never unexpectedly replaces the AutoHack console.
    wait(FINALIZER_WAIT_SECONDS)
    initial_target = cleanup_target(staged)
    initial_execution = clean_execution_route
    if not initial_target.computer or not initial_execution then
        best_shell = null
        wait(FINALIZER_WAIT_SECONDS)
        clean_source(staged.computer)
        clean_source(staged.router)
        clean_execution_route
        print(paint("AutoHack refused to open an unclean access path.", COLOR_RED))
        return false
    end if

    session_index = remember_access_session(
        best_shell,
        staged,
        authority,
        best_promoted,
        best_promotion)
    if session_index < 0 then
        best_shell = null
        print(paint("AutoHack could not retain the verified access object.", COLOR_RED))
        return false
    end if

    print(char(10) + paint("ACCESS RETAINED", COLOR_GREEN) + " [" +
        paint(session_index, COLOR_CYAN) + "]")
    print("Host: " + paint(target_computer.public_ip, COLOR_CYAN) + "/" +
        paint(target_computer.local_ip, COLOR_CYAN))
    print("Authority: " + paint(authority, COLOR_PINK))
    if best_promoted then
        print("Poison promotion: " + paint(best_promotion, COLOR_GREEN))
    end if
    if not staged.router_ready then
        print(paint("Target router cleanup is unavailable; the owned AutoRoute chain remains the break.", COLOR_ORANGE))
    end if
    if globals.autoshell then
        print(paint("AutoShell is on; opening retained session " + session_index + ".", COLOR_PURPLE))
        open_access_session(session_index)
    else
        print("Type " + paint("shell", COLOR_GREEN) + " or " +
            paint("shell " + session_index, COLOR_GREEN) + " when you want the terminal.")
    end if
    return true
end function


selected_access_index = function()
    if globals.access_sessions.len == 0 then
        globals.active_session = -1
        return -1
    end if
    index = globals.active_session
    if typeof(index).lower != "number" or index < 0 or index >= globals.access_sessions.len then
        index = globals.access_sessions.len - 1
        globals.active_session = index
    end if
    return index
end function


session_state_color = function(state)
    if state == "ready" then return COLOR_GREEN
    return COLOR_RED
end function


console_prompt = function()
    origin = globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
    selected = selected_access_index
    top = paint("╭─◆ ", COLOR_PURPLE) + paint("AUTOHACK", COLOR_PURPLE) +
        paint(" ◆─", COLOR_PURPLE)
    if selected < 0 then
        top = top + paint("[NO RETAINED TARGET]", COLOR_ORANGE)
        bottom = paint("╰─", COLOR_PURPLE) + paint("ORIGIN ", COLOR_ORANGE) +
            paint(origin, COLOR_CYAN) + paint(" ─▶ ", COLOR_GREEN)
        return top + char(10) + bottom
    end if

    access = globals.access_sessions[selected]
    top = top + paint("[S" + selected + "/" + globals.access_sessions.len + "]", COLOR_PINK) +
        paint("─[" + access.authority.upper + "]", COLOR_PINK) +
        paint("─[" + access.state.upper + "]", session_state_color(access.state))
    bottom = paint("╰─", COLOR_PURPLE) + paint("ORIGIN ", COLOR_ORANGE) +
        paint(origin, COLOR_CYAN) + paint(" ─▶ ", COLOR_GREEN) +
        paint("TARGET ", COLOR_CYAN) +
        paint(access.public_ip + "/" + access.local_ip, COLOR_CYAN) +
        paint(" ─▶ ", COLOR_GREEN)
    return top + char(10) + bottom
end function


show_location = function()
    print(paint("AutoHack location", COLOR_PURPLE))
    print("Execution origin: " + paint(globals.local_computer.public_ip, COLOR_CYAN) + "/" +
        paint(globals.local_computer.local_ip, COLOR_CYAN))
    selected = selected_access_index
    if selected < 0 then
        print(paint("No retained target is currently selected.", COLOR_ORANGE))
        return
    end if
    access = globals.access_sessions[selected]
    print("Selected session: [" + paint(selected, COLOR_PINK) + "] of " +
        paint(globals.access_sessions.len, COLOR_GREEN))
    print("Attached target: " + paint(access.public_ip, COLOR_CYAN) + "/" +
        paint(access.local_ip, COLOR_CYAN))
    print("Authority: " + paint(access.authority, COLOR_PINK))
    print("State: " + paint(access.state, session_state_color(access.state)))
    if access.promoted then
        print("Poison promotion: " + paint(access.promotion, COLOR_GREEN))
    end if
    if access.router_ready then
        print("Target router cleanup: " + paint("available", COLOR_GREEN))
    else
        print("Target router cleanup: " + paint("best effort unavailable", COLOR_ORANGE))
    end if
end function


show_access_sessions = function()
    print(paint("Retained access sessions", COLOR_PURPLE))
    if globals.access_sessions.len == 0 then
        print(paint("No verified access is currently retained.", COLOR_ORANGE))
        return
    end if
    selected = selected_access_index
    for index in range(0, globals.access_sessions.len - 1)
        access = globals.access_sessions[index]
        state_color = COLOR_GREEN
        if access.state != "ready" then state_color = COLOR_RED
        router_text = "clean"
        router_color = COLOR_GREEN
        if not access.router_ready then
            router_text = "best-effort"
            router_color = COLOR_ORANGE
        end if
        poison_text = "native"
        poison_color = COLOR_PURPLE
        if access.promoted then
            poison_text = "promoted"
            poison_color = COLOR_GREEN
        end if
        marker = " "
        if index == selected then marker = paint("◆", COLOR_GREEN)
        print(marker + "[" + paint(index, COLOR_CYAN) + "] " +
            paint(access.public_ip, COLOR_CYAN) + "/" + paint(access.local_ip, COLOR_CYAN) +
            "  " + paint(access.authority, COLOR_PINK) +
            "  state=" + paint(access.state, state_color) +
            "  router=" + paint(router_text, router_color) +
            "  poison=" + paint(poison_text, poison_color) +
            "  opens=" + access.uses)
    end for
end function


open_access_session = function(index = -1)
    if globals.access_sessions.len == 0 then
        print(paint("No retained access session is available.", COLOR_RED))
        return false
    end if
    if index < 0 then index = selected_access_index
    if index >= globals.access_sessions.len then
        print(paint("Session index is outside the retained-access list.", COLOR_RED))
        return false
    end if
    globals.active_session = index

    access = globals.access_sessions[index]
    if not is_shell(access.shell) then
        access.state = "invalid-shell"
        print(paint("The retained shell object is no longer usable.", COLOR_RED))
        return false
    end if

    // A retained shell may be opened more than once. Re-clean both sides before
    // every launch so the terminal is never entered on top of stale evidence.
    pre_target = cleanup_target(access.staged)
    pre_execution = clean_execution_route
    if not pre_target.computer or not pre_execution then
        access.state = "preclean-failed"
        access.last_computer_clean = pre_target.computer
        access.last_router_clean = pre_target.router
        access.last_execution_clean = pre_execution
        print(paint("AutoHack refused to open a session whose pre-clean failed.", COLOR_RED))
        return false
    end if

    print(char(10) + paint("OPENING SESSION", COLOR_GREEN) + " [" +
        paint(index, COLOR_CYAN) + "]")
    print("Host: " + paint(access.public_ip, COLOR_CYAN) + "/" +
        paint(access.local_ip, COLOR_CYAN) + "  Authority: " +
        paint(access.authority, COLOR_PINK))
    print(paint("Close the target terminal to return to AutoHack and finalize logs.", COLOR_PURPLE))

    access.shell.start_terminal
    wait(FINALIZER_WAIT_SECONDS)

    final_target = cleanup_target(access.staged)
    diag("terminal finalizer | session=" + index + " | host=" + access.public_ip +
        "/" + access.local_ip + " | computer=" + final_target.computer +
        " | router=" + final_target.router)
    flush_log
    final_execution = clean_execution_route

    access.uses = access.uses + 1
    access.last_computer_clean = final_target.computer
    access.last_router_clean = final_target.router
    access.last_execution_clean = final_execution
    if final_target.computer and final_execution then
        access.state = "ready"
    else
        access.state = "cleanup-failed"
    end if

    print(char(10) + paint("AutoHack finalizer", COLOR_PURPLE))
    print("Target computer: " + paint(final_target.computer, COLOR_GREEN))
    if final_target.router then
        print("Target router: " + paint("clean", COLOR_GREEN))
    else
        print("Target router: " + paint("best effort unavailable", COLOR_ORANGE))
    end if
    print("Execution route: " + paint(final_execution, COLOR_GREEN))
    print(paint("Returned to the AutoHack console.", COLOR_CYAN))
    return final_target.computer and final_execution
end function


scan_interesting_session = function(index = -1)
    if globals.access_sessions.len == 0 then
        print(paint("No retained access session is available.", COLOR_RED))
        return false
    end if
    if index < 0 then index = selected_access_index
    if index >= globals.access_sessions.len then
        print(paint("Session index is outside the retained-access list.", COLOR_RED))
        return false
    end if
    globals.active_session = index

    access = globals.access_sessions[index]
    if not is_shell(access.shell) then
        access.state = "invalid-shell"
        print(paint("The retained shell object is no longer usable.", COLOR_RED))
        return false
    end if

    // The metadata walk is still a remote action. Clean first, retain only plain
    // result data, then finalize both target and owned execution route before
    // printing the inventory or returning to the persistent console.
    pre_target = cleanup_target(access.staged)
    pre_execution = clean_execution_route
    if not pre_target.computer or not pre_execution then
        access.state = "preclean-failed"
        access.last_computer_clean = pre_target.computer
        access.last_router_clean = pre_target.router
        access.last_execution_clean = pre_execution
        print(paint("AutoHack refused an interesting-file scan whose pre-clean failed.", COLOR_RED))
        return false
    end if

    print(char(10) + paint("Scanning retained session " + index + " for non-stock files ...", COLOR_PURPLE))
    root = access.shell.host_computer.File("/")
    if not is_file(root) then
        scan = {"results": [], "scanned": 0, "stock_ignored": 0,
            "trash_skipped": 0, "unreadable": 1, "truncated": false,
            "symlink_api": false,}
    else
        scan = inventory_interesting_files(root)
    end if

    // Do not touch the target again after these retained finalizers.
    wait(FINALIZER_WAIT_SECONDS)
    final_target = cleanup_target(access.staged)
    diag("interesting inventory | session=" + index + " | host=" + access.public_ip +
        "/" + access.local_ip + " | examined=" + scan.scanned +
        " | results=" + scan.results.len + " | truncated=" + scan.truncated +
        " | computer=" + final_target.computer + " | router=" + final_target.router)
    flush_log
    final_execution = clean_execution_route

    access.last_computer_clean = final_target.computer
    access.last_router_clean = final_target.router
    access.last_execution_clean = final_execution
    if final_target.computer and final_execution then
        access.state = "ready"
    else
        access.state = "cleanup-failed"
    end if

    globals.interesting_results = scan.results
    globals.interesting_session = index
    print_interesting_inventory(scan, access, index)
    print("Target computer cleanup: " + paint(final_target.computer, COLOR_GREEN))
    if final_target.router then
        print("Target router cleanup: " + paint("clean", COLOR_GREEN))
    else
        print("Target router cleanup: " + paint("best effort unavailable", COLOR_ORANGE))
    end if
    print("Execution route cleanup: " + paint(final_execution, COLOR_GREEN))
    print(paint("Returned to the AutoHack console.", COLOR_CYAN))
    return final_target.computer and final_execution
end function


is_direct_child_path = function(parent_path, child_path)
    if typeof(parent_path).lower != "string" then return false
    if typeof(child_path).lower != "string" then return false
    prefix = parent_path
    if prefix != "/" then prefix = prefix + "/"
    relative = child_path
    if parent_path == "/" then
        if relative.indexOf("/") != 0 then return false
        relative = relative[1:]
    else
        if relative.indexOf(prefix) != 0 then return false
        relative = relative[prefix.len:]
    end if
    if relative == "" then return false
    return relative.indexOf("/") == null
end function


discover_trash_roots = function(computer)
    roots = []
    pending = [computer.File("/")]
    seen = {}
    scanned = 0
    unreadable = 0
    truncated = false
    symlink_api = false

    while pending.len > 0
        if scanned >= NUKE_SCAN_LIMIT then
            truncated = true
            break
        end if
        node = pending.pop
        if not is_file(node) or not node.is_folder then
            unreadable = unreadable + 1
            continue
        end if
        path = node.path
        if typeof(path).lower != "string" or path == "" then
            unreadable = unreadable + 1
            continue
        end if
        if seen.hasIndex(path) then continue
        seen[path] = 1
        scanned = scanned + 1

        is_link = false
        if node.hasIndex("is_symlink") then
            symlink_api = true
            is_link = node.is_symlink == 1
        end if
        if is_link then continue

        if node.name == ".Trash" then
            roots.push(path)
            continue
        end if
        folders = node.get_folders
        if typeof(folders).lower != "list" then
            unreadable = unreadable + 1
            continue
        end if
        for child in folders
            pending.push(child)
        end for
    end while
    roots.sort
    return {"paths": roots, "scanned": scanned, "unreadable": unreadable,
        "truncated": truncated, "symlink_api": symlink_api,}
end function


empty_trash_roots = function(computer, discovery)
    targets = {}
    discovery_issues = discovery.unreadable
    for trash_path in discovery.paths
        trash = computer.File(trash_path)
        if not is_file(trash) or not trash.is_folder or trash.path != trash_path then
            discovery_issues = discovery_issues + 1
            continue
        end if
        if trash.hasIndex("is_symlink") and trash.is_symlink == 1 then
            discovery_issues = discovery_issues + 1
            continue
        end if
        files = trash.get_files
        folders = trash.get_folders
        if typeof(files).lower != "list" or typeof(folders).lower != "list" then
            discovery_issues = discovery_issues + 1
            continue
        end if
        for child in files
            if not is_file(child) or not is_direct_child_path(trash_path, child.path) then
                discovery_issues = discovery_issues + 1
            else
                targets[child.path] = trash_path
            end if
        end for
        for child in folders
            if not is_file(child) or not is_direct_child_path(trash_path, child.path) then
                discovery_issues = discovery_issues + 1
            else
                targets[child.path] = trash_path
            end if
        end for
    end for

    deleted = 0
    missing = 0
    failed = 0
    paths = targets.indexes
    paths.sort
    for path in paths
        current = computer.File(path)
        if not is_file(current) then
            missing = missing + 1
        else if current.path != path or not is_direct_child_path(targets[path], current.path) then
            failed = failed + 1
        else
            result = current.delete
            if not is_file(computer.File(path)) then
                deleted = deleted + 1
            else
                failed = failed + 1
                print(paint("TRASH DELETE FAILED", COLOR_RED) + " " + path + " | " + str(result))
            end if
        end if
    end for
    return {"targets": paths.len, "deleted": deleted, "missing": missing,
        "failed": failed, "issues": discovery_issues,}
end function


delete_bin_payloads = function(computer)
    bin = computer.File("/bin")
    if not is_file(bin) or not bin.is_folder or bin.path != "/bin" then
        return {"attempted": 0, "deleted": 0, "missing": 1, "failed": 1,
            "preserved": 0, "failed_paths": ["/bin"],}
    end if
    targets = []
    failed_paths = []
    preserved = 0
    files = bin.get_files
    folders = bin.get_folders
    if typeof(files).lower != "list" or typeof(folders).lower != "list" then
        return {"attempted": 0, "deleted": 0, "missing": 0, "failed": 1,
            "preserved": 0, "failed_paths": ["/bin enumeration"],}
    end if
    for child in files
        if not is_file(child) or not is_direct_child_path("/bin", child.path) then
            failed_paths.push("/bin boundary")
        else if NUKE_PRESERVE_BIN.indexOf(child.path) != null then
            preserved = preserved + 1
        else
            targets.push(child.path)
        end if
    end for
    for child in folders
        if not is_file(child) or not is_direct_child_path("/bin", child.path) then
            failed_paths.push("/bin boundary")
        else
            targets.push(child.path)
        end if
    end for
    targets.sort
    deleted = 0
    missing = 0
    failed = failed_paths.len
    for path in targets
        current = computer.File(path)
        if not is_file(current) then
            missing = missing + 1
        else if current.path != path or not is_direct_child_path("/bin", current.path) then
            failed = failed + 1
            failed_paths.push(path)
        else
            result = current.delete
            if not is_file(computer.File(path)) then
                deleted = deleted + 1
            else
                failed = failed + 1
                failed_paths.push(path)
                print(paint("BIN DELETE FAILED", COLOR_RED) + " " + path + " | " + str(result))
            end if
        end if
    end for
    return {"attempted": targets.len, "deleted": deleted, "missing": missing,
        "failed": failed, "preserved": preserved, "failed_paths": failed_paths,}
end function


nuke_access_session = function(index = -1)
    if globals.access_sessions.len == 0 then
        print(paint("No retained access session is available.", COLOR_RED))
        return false
    end if
    if index < 0 then index = selected_access_index
    if index < 0 or index >= globals.access_sessions.len then
        print(paint("Session index is outside the retained-access list.", COLOR_RED))
        return false
    end if
    access = globals.access_sessions[index]
    if not is_shell(access.shell) or access.authority != "root" then
        print(paint("NUKE REFUSED", COLOR_RED) +
            " | exact retained root shell required; selected authority=" + access.authority)
        return false
    end if
    computer = access.shell.host_computer
    if not is_computer(computer) then
        print(paint("NUKE REFUSED", COLOR_RED) + " | retained target computer is unavailable")
        return false
    end if
    host = access.public_ip + "/" + access.local_ip
    expected = "NUKE " + host

    print(char(10) + paint("ROWAN BLACKOUT // EXACT TARGET NUKE", COLOR_RED))
    print("Target: " + paint(host, COLOR_CYAN) + "  Authority: " + paint(access.authority, COLOR_PINK))
    print(paint("This deletes the retained target filesystem and cannot be undone.", COLOR_RED))
    print("Only " + paint("/bin/rm", COLOR_ORANGE) + " and " +
        paint("/bin/rmdir", COLOR_ORANGE) + " are preserved inside /bin.")
    confirmation = user_input("Type exactly " + expected + ": ").trim
    if confirmation != expected then
        print(paint("NUKE CANCELLED", COLOR_ORANGE) + " | confirmation did not match")
        return false
    end if

    globals.nuke_attempts = globals.nuke_attempts + 1
    globals.nuke_last = host + " | staging"
    diag("nuke start | session=" + index + " | host=" + host + " | authority=root")

    pre_target = cleanup_target(access.staged)
    pre_execution = clean_execution_route
    if not pre_target.computer or not pre_execution then
        globals.nuke_last = host + " | preclean failed"
        print(paint("NUKE REFUSED", COLOR_RED) + " | pre-clean failed; target was not destroyed")
        diag("nuke refused | host=" + host + " | computer_clean=" +
            pre_target.computer + " | execution_clean=" + pre_execution)
        flush_log
        return false
    end if

    show_auto_action("BLACKOUT INVENTORY", "discovering every visible .Trash", COLOR_ORANGE)
    trash_discovery = discover_trash_roots(computer)
    trash = empty_trash_roots(computer, trash_discovery)
    show_auto_action("TRASH PURGED", trash.deleted + "/" + trash.targets +
        " top-level entries", COLOR_GREEN)

    show_auto_action("BIN STRIP", "preserving rm and rmdir", COLOR_ORANGE)
    bin_result = delete_bin_payloads(computer)

    root_attempted = 0
    root_deleted = 0
    root_missing = 0
    root_failed = 0
    failed_paths = []
    for path in NUKE_ROOTS
        current = computer.File(path)
        if not is_file(current) then
            root_missing = root_missing + 1
            continue
        end if
        root_attempted = root_attempted + 1
        result = current.delete
        if not is_file(computer.File(path)) then
            root_deleted = root_deleted + 1
        else
            root_failed = root_failed + 1
            failed_paths.push(path)
            print(paint("ROOT DELETE FAILED", COLOR_RED) + " " + path + " | " + str(result))
        end if
    end for

    // /var is the last filesystem target. Grey Hack may regenerate it during
    // reboot; this command reports submission rather than pretending it stays
    // absent. No target filesystem read occurs after this delete request.
    show_auto_action("FINAL FILESYSTEM CUT", "/var then reboot", COLOR_RED)
    var = computer.File("/var")
    var_submitted = false
    if is_file(var) and var.path == "/var" then
        var.delete
        var_submitted = true
    end if
    computer.reboot

    // The retained object points at a deliberately destroyed machine. Release
    // it without another target read and return only to the owned route.
    globals.access_sessions.remove(index)
    if globals.access_sessions.len == 0 then
        globals.active_session = -1
    else
        globals.active_session = globals.access_sessions.len - 1
    end if
    execution_clean = clean_execution_route

    total_failed = trash.failed + trash.issues + bin_result.failed + root_failed
    if total_failed == 0 then
        globals.nuke_successes = globals.nuke_successes + 1
        globals.nuke_last = host + " | payload complete"
    else
        globals.nuke_last = host + " | partial; failures=" + total_failed
    end if
    diag("nuke complete | host=" + host + " | trash_roots=" +
        trash_discovery.paths.len + " | trash_deleted=" + trash.deleted +
        " | bin_deleted=" + bin_result.deleted + " | bin_preserved=" +
        bin_result.preserved + " | roots_deleted=" + root_deleted +
        " | roots_failed=" + root_failed + " | var_submitted=" +
        var_submitted + " | execution_clean=" + execution_clean)
    flush_log

    print(char(10) + paint("ROWAN BLACKOUT RESULTS", COLOR_PURPLE))
    print("Target: " + paint(host, COLOR_CYAN))
    print("Trash roots: " + paint(trash_discovery.paths.len, COLOR_CYAN) +
        "  entries deleted: " + paint(trash.deleted, COLOR_GREEN) +
        "  issues: " + paint(trash.failed + trash.issues, COLOR_RED))
    print("/bin deleted: " + paint(bin_result.deleted, COLOR_GREEN) +
        "  preserved: " + paint(bin_result.preserved, COLOR_ORANGE) +
        "  failed: " + paint(bin_result.failed, COLOR_RED))
    print("System roots deleted: " + paint(root_deleted, COLOR_GREEN) +
        "/" + root_attempted + "  failed: " + paint(root_failed, COLOR_RED))
    for path in bin_result.failed_paths
        print("  " + paint("BIN RESIDUAL", COLOR_RED) + " " + path)
    end for
    for path in failed_paths
        print("  " + paint("RESIDUAL", COLOR_RED) + " " + path)
    end for
    print("/var delete submitted: " + paint(var_submitted, COLOR_ORANGE) +
        "  reboot submitted: " + paint(true, COLOR_GREEN))
    print("Execution route clean: " + paint(execution_clean, COLOR_GREEN))
    print(paint("The destroyed target session was released. /var may regenerate during reboot.", COLOR_ORANGE))
    if total_failed == 0 then
        print(paint("BLACKOUT PAYLOAD COMPLETE", COLOR_GREEN))
    else
        print(paint("BLACKOUT PAYLOAD PARTIAL", COLOR_ORANGE) + " | residual items are listed above")
    end if
    return true
end function


harden_execution_host = function(mode)
    mode = mode.lower
    if mode != "home" and mode != "server" then
        print(paint("Usage: harden home|server", COLOR_RED))
        return false
    end if
    authority = access_level(globals.local_shell)
    if authority != "root" then
        print(paint("HARDEN REFUSED", COLOR_RED) +
            " | run AutoHack from a root shell; current authority=" + authority)
        return false
    end if
    root = globals.local_computer.File("/")
    if not is_file(root) or not root.is_folder or root.path != "/" then
        print(paint("HARDEN REFUSED", COLOR_RED) + " | execution root is unavailable")
        return false
    end if
    if mode == "home" then
        for path in HOME_HARDEN_TRAVERSE
            candidate = globals.local_computer.File(path)
            if not is_file(candidate) or candidate.path != path then
                print(paint("HARDEN REFUSED", COLOR_RED) + " | bootstrap path missing: " + path)
                return false
            end if
        end for
        for path in HOME_HARDEN_EXECUTE
            candidate = globals.local_computer.File(path)
            if not is_file(candidate) or candidate.path != path then
                print(paint("HARDEN REFUSED", COLOR_RED) + " | bootstrap path missing: " + path)
                return false
            end if
        end for
    end if

    host = globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
    expected = "HARDEN " + mode.upper + " " + host
    print(char(10) + paint("ROWAN FORTIFY // " + mode.upper, COLOR_PURPLE))
    print("Execution host: " + paint(host, COLOR_CYAN) + "  Authority: " + paint(authority, COLOR_PINK))
    if mode == "home" then
        print(paint("Everything becomes root-owned and root-only except the minimal Terminal/sudo/bash bootstrap.", COLOR_ORANGE))
    else
        print(paint("Everything becomes root-owned and root-only. SSH root access is required afterward.", COLOR_RED))
    end if
    confirmation = user_input("Type exactly " + expected + ": ").trim
    if confirmation != expected then
        print(paint("HARDEN CANCELLED", COLOR_ORANGE) + " | confirmation did not match")
        return false
    end if

    globals.harden_attempts = globals.harden_attempts + 1
    globals.harden_last = mode + " | staging"
    diag("harden start | mode=" + mode + " | host=" + host)
    if not prepare_execution_cleanup then
        globals.harden_last = mode + " | cleanup staging failed"
        print(paint("HARDEN REFUSED", COLOR_RED) + " | owned execution-route cleanup could not be staged")
        diag("harden refused | mode=" + mode + " | host=" + host + " | reason=execution cleanup unavailable")
        flush_log
        return false
    end if
    pre_execution = clean_execution_route
    if not pre_execution then
        globals.harden_last = mode + " | preclean failed"
        print(paint("HARDEN REFUSED", COLOR_RED) + " | owned execution route could not be cleaned")
        diag("harden refused | mode=" + mode + " | host=" + host + " | reason=execution preclean failed")
        flush_log
        return false
    end if

    show_auto_action("OWNERSHIP LOCK", "root:root recursively", COLOR_ORANGE)
    owner_result = root.set_owner("root", 1)
    group_result = root.set_group("root", 1)
    show_auto_action("PERMISSION LOCK", "root rwx; group/other none", COLOR_ORANGE)
    user_result = root.chmod("u+rwx", 1)
    group_lock = root.chmod("g-rwx", 1)
    other_lock = root.chmod("o-rwx", 1)

    restored = 0
    restore_failed = 0
    if mode == "home" then
        for path in HOME_HARDEN_TRAVERSE
            candidate = globals.local_computer.File(path)
            if is_file(candidate) and candidate.path == path then
                candidate.chmod("o+x", 0)
                restored = restored + 1
            else
                restore_failed = restore_failed + 1
            end if
        end for
        for path in HOME_HARDEN_EXECUTE
            candidate = globals.local_computer.File(path)
            if is_file(candidate) and candidate.path == path then
                candidate.chmod("o+rx", 0)
                restored = restored + 1
            else
                restore_failed = restore_failed + 1
            end if
        end for
    end if

    execution_clean = clean_execution_route
    clean_root = globals.local_computer.File("/")
    verified_root = is_file(clean_root) and clean_root.owner == "root" and
        clean_root.group == "root"
    expected_root_permissions = "drwx------"
    if mode == "home" then expected_root_permissions = "drwx-----x"
    verified_permissions = verified_root and
        clean_root.permissions == expected_root_permissions
    verified_traverse = true
    verified_bootstrap = true
    if mode == "home" then
        for path in HOME_HARDEN_TRAVERSE
            candidate = globals.local_computer.File(path)
            if not is_file(candidate) or candidate.path != path or
                candidate.permissions != "drwx-----x" then verified_traverse = false
        end for
        for path in HOME_HARDEN_EXECUTE
            candidate = globals.local_computer.File(path)
            if not is_file(candidate) or candidate.path != path or
                candidate.permissions != "-rwx---r-x" then verified_bootstrap = false
        end for
    end if
    success = verified_root and verified_permissions and verified_traverse and
        verified_bootstrap and restore_failed == 0 and execution_clean
    if success then
        globals.harden_successes = globals.harden_successes + 1
        globals.harden_last = mode + " | complete"
    else
        globals.harden_last = mode + " | verification issue"
    end if
    diag("harden complete | mode=" + mode + " | host=" + host +
        " | owner_return=" + str(owner_result) + " | group_return=" + str(group_result) +
        " | user_return=" + str(user_result) + " | group_lock=" + str(group_lock) +
        " | other_lock=" + str(other_lock) + " | restored=" + restored +
        " | restore_failed=" + restore_failed + " | root_verified=" +
        verified_root + " | permissions_verified=" + verified_permissions +
        " | traverse_verified=" + verified_traverse +
        " | bootstrap_verified=" + verified_bootstrap +
        " | execution_clean=" + execution_clean)
    flush_log

    print(char(10) + paint("ROWAN FORTIFY RESULTS", COLOR_PURPLE))
    print("Mode: " + paint(mode, COLOR_CYAN) + "  Host: " + paint(host, COLOR_CYAN))
    print("Root ownership verified: " + paint(verified_root, COLOR_GREEN))
    print("Root permission pattern: " + paint(clean_root.permissions, COLOR_CYAN) +
        "  expected: " + paint(expected_root_permissions, COLOR_ORANGE))
    if mode == "home" then
        print("Bootstrap paths restored: " + paint(restored, COLOR_GREEN) +
            "/" + (HOME_HARDEN_TRAVERSE.len + HOME_HARDEN_EXECUTE.len))
        print("Traversal paths verified: " + paint(verified_traverse, COLOR_GREEN))
        print("Terminal/sudo/bash bootstrap visible: " + paint(verified_bootstrap, COLOR_GREEN))
    else
        print("Exceptions restored: " + paint(0, COLOR_GREEN))
    end if
    print("Execution logs clean: " + paint(execution_clean, COLOR_GREEN))
    if success then
        print(paint("FORTIFICATION COMPLETE", COLOR_GREEN))
    else
        print(paint("FORTIFICATION NEEDS REVIEW", COLOR_RED))
    end if
    return success
end function


forget_access_session = function(index = -1)
    if globals.access_sessions.len == 0 then
        print(paint("No retained access session is available.", COLOR_ORANGE))
        return false
    end if
    active_before = selected_access_index
    if index < 0 then index = active_before
    if index >= globals.access_sessions.len then
        print(paint("Session index is outside the retained-access list.", COLOR_RED))
        return false
    end if
    access = globals.access_sessions[index]
    globals.access_sessions.remove(index)
    if globals.access_sessions.len == 0 then
        globals.active_session = -1
    else if active_before > index then
        globals.active_session = active_before - 1
    else if active_before == index then
        globals.active_session = index
        if globals.active_session >= globals.access_sessions.len then
            globals.active_session = globals.access_sessions.len - 1
        end if
    end if
    print("Forgot [" + paint(index, COLOR_CYAN) + "] " +
        paint(access.public_ip, COLOR_CYAN) + "/" + paint(access.local_ip, COLOR_CYAN) + ".")
    return true
end function


