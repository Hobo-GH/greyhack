deep_usage = function()
    return "<b>Usage: nmap [--quick] [ip_address|domain]</b>" + char(10) +
        "Runs the complete read-only Synthwave Deep Recon engine: stock ports, " +
        "router identity, firewall rules, full 0-65535 forwarding sweeps, LAN " +
        "discovery, internal services, switches, Whois, and explicit pivot gaps." + char(10) +
        "Use --quick to skip exhaustive port and direct-subnet sweeps."
end function


deep_safe_string = function(value, fallback="-")
    kind = typeof(value).lower
    if kind == "string" then
        if value != "" then return value
        return fallback
    end if
    if kind == "number" then return str(value)
    return fallback
end function



deep_is_router_device = function(value)
    kind = typeof(value).lower
    return kind == "router" or kind == "switch"
end function


deep_clean_spaces = function(value)
    text = deep_safe_string(value, "").replace(char(13), " ").replace(char(10), " ").trim
    while text.indexOf("  ") != null
        text = text.replace("  ", " ")
    end while
    return text
end function


deep_bounded_text = function(value, limit=240)
    text = deep_clean_spaces(value)
    if text.len > limit then return text[:limit] + "..."
    return text
end function


deep_heading = function(title)
    print(char(10) + "<size=125%><b>" + paint(title, COLOR_PURPLE) + "</b></size>")
end function


deep_plain_cell = function(value)
    text = str(value)
    for color in [COLOR_PURPLE, COLOR_CYAN, COLOR_GREEN, COLOR_RED, COLOR_ORANGE, COLOR_PINK]
        text = text.replace("<color=" + color + ">", "")
    end for
    return text.replace("</color>", "")
end function


deep_render_table_line = function(cells, widths)
    line = ""
    index = 0
    while index < cells.len
        cell = cells[index]
        line = line + cell
        if index < cells.len - 1 then
            padding = widths[index] - deep_plain_cell(cell).len + 2
            if padding < 1 then padding = 1
            line = line + (" " * padding)
        end if
        index = index + 1
    end while
    return line
end function


deep_table_row = function(cells)
    safe_cells = []
    for cell in cells
        safe_cells.push(str(cell).replace(char(13), " ").replace(char(10), " ").replace(DEEP_TABLE_DELIMITER, " "))
    end for
    return safe_cells.join(DEEP_TABLE_DELIMITER)
end function


deep_print_table = function(header, rows)
    if typeof(rows).lower != "list" or rows.len == 0 then return
    header_cells = header.split(DEEP_TABLE_DELIMITER)
    widths = []
    for cell in header_cells
        widths.push(cell.len)
    end for
    split_rows = []
    for row in rows
        cells = row.split(DEEP_TABLE_DELIMITER)
        split_rows.push(cells)
        index = 0
        while index < cells.len
            while widths.len <= index
                widths.push(0)
            end while
            width = deep_plain_cell(cells[index]).len
            if width > widths[index] then widths[index] = width
            index = index + 1
        end while
    end for

    colored_header = []
    for cell in header_cells
        colored_header.push(paint(cell, COLOR_PURPLE))
    end for
    rendered_header = deep_render_table_line(colored_header, widths)
    buffer = rendered_header
    for cells in split_rows
        rendered = deep_render_table_line(cells, widths)
        if buffer.len + rendered.len + 1 > DEEP_TABLE_PRINT_LIMIT then
            print(buffer)
            buffer = rendered_header + char(10) + rendered
        else
            buffer = buffer + char(10) + rendered
        end if
    end for
    if buffer != rendered_header then print(buffer)
end function



deep_port_record = function(router, port_object)
    info = router.port_info(port_object)
    if typeof(info).lower != "string" or info == "" then info = "unknown -"
    info = deep_bounded_text(info, 160)
    pieces = info.split(" ")
    service = "unknown"
    version = "-"
    if pieces.len > 0 then service = pieces[0]
    if pieces.len > 1 then version = pieces[1:].join(" ")
    lan_ip = deep_safe_string(port_object.get_lan_ip, "-")
    return {"number": port_object.port_number, "closed": port_object.is_closed,
        "service": service, "version": version, "info": info, "lan": lan_ip,
        "hidden_external": false, "forward_scope": "",}
end function


deep_sort_port_records = function(records)
    i = 0
    while i < records.len
        j = i + 1
        while j < records.len
            if records[j].number < records[i].number then
                temp = records[i]
                records[i] = records[j]
                records[j] = temp
            end if
            j = j + 1
        end while
        i = i + 1
    end while
    return records
end function


deep_records_from_ports = function(router, ports)
    records = []
    if typeof(ports).lower != "list" then return records
    for port_object in ports
        if typeof(port_object).lower == "port" then records.push(deep_port_record(router, port_object))
    end for
    return deep_sort_port_records(records)
end function


deep_wan_links = function(wan_records, internal_record)
    internet_links = []
    upstream_links = []
    closed_links = []
    for wan_record in wan_records
        if wan_record.lan == internal_record.lan and wan_record.info == internal_record.info then
            if wan_record.closed then
                closed_links.push(wan_record.number)
            else if wan_record.forward_scope == "WAN" then
                internet_links.push(wan_record.number)
            else
                upstream_links.push(wan_record.number)
            end if
        end if
    end for
    return {"internet": internet_links, "upstream": upstream_links, "closed": closed_links}
end function


deep_router_key = function(router)
    return deep_safe_string(router.public_ip, "?") + "|" + deep_safe_string(router.local_ip, "?")
end function


deep_same_router = function(left, right)
    if not deep_is_router_device(left) or not deep_is_router_device(right) then return false
    return deep_router_key(left) == deep_router_key(right)
end function


deep_status_cell = function(label, color)
    return paint(label, color)
end function


deep_firewall_row = function(router_id, raw_rule)
    rule = deep_clean_spaces(raw_rule)
    pieces = rule.split(" ")
    if pieces.len < 4 then
        return deep_table_row([paint(router_id, COLOR_PINK), paint("RAW", COLOR_ORANGE),
            "-", "-", paint(deep_bounded_text(rule, 160), COLOR_ORANGE)])
    end if
    action = "?"
    port = "?"
    source = "?"
    destination = "?"
    if pieces.len > 0 then action = pieces[0]
    if pieces.len > 1 then port = pieces[1]
    if pieces.len > 2 then source = pieces[2]
    if pieces.len > 3 then destination = pieces[3:].join(" ")
    action_color = COLOR_ORANGE
    if action.lower == "allow" then action_color = COLOR_GREEN
    if action.lower == "deny" or action.lower == "reject" then action_color = COLOR_RED
    return deep_table_row([paint(router_id, COLOR_PINK), paint(action, action_color),
        paint(port, COLOR_CYAN), paint(source, COLOR_CYAN), paint(destination, COLOR_CYAN)])
end function


deep_show_whois = function(public_ip)
    deep_heading("WHOIS // PUBLIC IDENTITY")
    print("Public network: " + paint(public_ip, COLOR_CYAN))
    result = whois(public_ip)
    if typeof(result).lower != "string" or result == "" then
        print(paint("Whois returned no data.", COLOR_ORANGE))
        return
    end if
    for raw_line in result.replace(char(13), "").split(char(10))
        line = deep_bounded_text(raw_line, 300)
        if line == "" then continue
        colon = line.indexOf(":")
        if colon == null then
            print(paint(line, COLOR_CYAN))
        else
            label = line[:colon]
            value = line[colon + 1:].trim
            print(label + ": " + paint(value, COLOR_CYAN))
        end if
    end for
end function


deep_show_basic_nmap = function(router, target_ip, target_is_lan, ports)
    deep_heading("BASIC NMAP READOUT")
    print("Starting nmap synthwave v" + DEEP_RECON_ENGINE + " at " + paint(current_date, COLOR_ORANGE))
    print("Interesting ports on " + paint(target_ip, COLOR_CYAN))
    if typeof(ports).lower == "string" then
        print(paint(ports, COLOR_RED))
        return
    end if
    if typeof(ports).lower != "list" then
        print(paint("No port data returned from this vantage.", COLOR_ORANGE))
        return
    end if
    records = deep_records_from_ports(router, ports)
    if records.len == 0 then
        print(paint("Scan finished. No visible ports.", COLOR_ORANGE))
        return
    end if
    rows = []
    for record in records
        state = deep_status_cell("open", COLOR_GREEN)
        if record.closed and not target_is_lan then state = deep_status_cell("closed", COLOR_RED)
        rows.push(deep_table_row([paint(record.number, COLOR_CYAN), state,
            paint(record.service, COLOR_CYAN), record.version, paint(record.lan, COLOR_CYAN)]))
    end for
    header = deep_table_row(["PORT", "STATE", "SERVICE", "VERSION", "LAN"])
    deep_print_table(header, rows)
end function


deep_discover_child = function(ip, current_router)
    child = get_switch(ip)
    if deep_is_router_device(child) and not deep_same_router(child, current_router) then
        return {"device": child, "kind": "switch"}
    end if
    return null
end function


deep_add_gap = function(router_id, ip, reason)
    clean_reason = deep_bounded_text(reason, 240)
    key = router_id + "|" + ip + "|" + clean_reason
    if globals.deep_seen_gaps.hasIndex(key) then return
    globals.deep_seen_gaps[key] = 1
    globals.deep_gaps.push({"router": router_id, "ip": ip, "reason": clean_reason})
end function


deep_full_port_sweep = function(router, router_id, visible_records, device_kind, forward_scope)
    all_records = visible_records[0:]
    sweep_label = forward_scope.lower + " forwarding"
    if globals.deep_quick then
        deep_add_gap(router_id, deep_safe_string(router.public_ip), "full " + sweep_label + " sweep skipped by --quick")
        return all_records
    end if
    if device_kind == "switch" then return all_records
    if globals.deep_stats.full_port_sweeps >= DEEP_MAX_PORT_SWEEP_ROUTERS then
        deep_add_gap(router_id, deep_safe_string(router.public_ip), "full " + sweep_label + " sweep safety limit reached")
        return all_records
    end if

    globals.deep_stats.full_port_sweeps = globals.deep_stats.full_port_sweeps + 1
    sweep_hidden = 0
    known = {}
    for record in visible_records
        known[str(record.number)] = 1
    end for
    print(paint(router_id + " scanning " + sweep_label + " ports 0-" + DEEP_MAX_PORT_NUMBER + "...", COLOR_PURPLE))
    sweep_start = time
    candidate = 0
    while candidate <= DEEP_MAX_PORT_NUMBER
        port_object = router.ping_port(candidate)
        if typeof(port_object).lower == "port" and not known.hasIndex(str(candidate)) then
            record = deep_port_record(router, port_object)
            record.number = candidate
            record.hidden_external = true
            record.forward_scope = forward_scope
            all_records.push(record)
            known[str(candidate)] = 1
            state = deep_status_cell("HIDDEN-FWD", COLOR_ORANGE)
            if forward_scope == "UPSTREAM" then state = deep_status_cell("HIDDEN-UPSTREAM", COLOR_ORANGE)
            if record.closed then state = deep_status_cell("HIDDEN-CLOSED", COLOR_RED)
            globals.deep_hidden_wan_rows.push(deep_table_row([paint(router_id, COLOR_PINK),
                paint(forward_scope, COLOR_CYAN), paint(candidate, COLOR_CYAN), state,
                paint(record.service, COLOR_CYAN), record.version, paint(record.lan, COLOR_CYAN)]))
            globals.deep_stats.hidden_external_ports = globals.deep_stats.hidden_external_ports + 1
            sweep_hidden = sweep_hidden + 1
        end if
        candidate = candidate + 1
        if candidate % 1000 == 0 then wait(0.01)
    end while
    print(paint(router_id + " " + sweep_label + " sweep complete in " + (time - sweep_start) + "s", COLOR_GREEN) +
        "  hidden=" + paint(sweep_hidden, COLOR_PINK))
    return deep_sort_port_records(all_records)
end function


deep_expand_direct_subnet = function(router, router_id, addresses)
    if globals.deep_quick then
        deep_add_gap(router_id, deep_safe_string(router.local_ip), "direct /24 ping discovery skipped by --quick")
        return addresses
    end if
    if not deep_same_router(router, globals.deep_vantage_router) then
        deep_add_gap(router_id, deep_safe_string(router.local_ip), "direct /24 ping discovery requires execution inside this router's LAN")
        return addresses
    end if
    local_ip = deep_safe_string(router.local_ip, "")
    pieces = local_ip.split(".")
    if pieces.len != 4 then
        deep_add_gap(router_id, local_ip, "could not derive a /24 subnet from router local IP")
        return addresses
    end if

    prefix = pieces[0] + "." + pieces[1] + "." + pieces[2] + "."
    print(paint(router_id + " probing direct subnet " + prefix + "1-254...", COLOR_PURPLE))
    octet = 1
    while octet <= 254
        candidate = prefix + octet
        cache_key = router_id + "|" + candidate
        reply = globals.deep_execution_shell.ping(candidate)
        globals.deep_ping_cache[cache_key] = reply
        if reply and addresses.indexOf(candidate) == null then
            addresses.push(candidate)
            globals.deep_unlisted_hosts[cache_key] = 1
            globals.deep_stats.unlisted_hosts = globals.deep_stats.unlisted_hosts + 1
        end if
        octet = octet + 1
        if octet % 50 == 0 then wait(0.01)
    end while
    globals.deep_stats.subnet_sweeps = globals.deep_stats.subnet_sweeps + 1
    return addresses
end function


deep_collect_router = function(router, device_kind, depth, via)
    if not deep_is_router_device(router) then return
    if globals.deep_stats.routers >= DEEP_MAX_NETWORK_DEVICES then
        deep_add_gap("LIMIT", via, "router/switch safety limit reached")
        return
    end if
    key = deep_router_key(router)
    if globals.deep_seen_routers.hasIndex(key) then return
    globals.deep_seen_routers[key] = 1

    router_number = globals.deep_stats.routers
    globals.deep_stats.routers = globals.deep_stats.routers + 1
    router_id = "R" + router_number
    public_ip = deep_safe_string(router.public_ip, "-")
    local_ip = deep_safe_string(router.local_ip, "-")
    kernel = deep_safe_string(router.kernel_version, "unknown")
    essid = deep_safe_string(router.essid_name, "unavailable/disabled")
    bssid = deep_safe_string(router.bssid_name, "-")
    if device_kind == "switch" then globals.deep_stats.switches = globals.deep_stats.switches + 1
    router_is_vantage = deep_same_router(router, globals.deep_vantage_router)

    globals.deep_router_rows.push(deep_table_row([paint(router_id, COLOR_PINK),
        paint(device_kind.upper, COLOR_CYAN), paint(public_ip, COLOR_CYAN),
        paint(local_ip, COLOR_CYAN), paint(kernel, COLOR_CYAN),
        paint(depth, COLOR_PINK), paint(via, COLOR_CYAN)]))

    wifi_state = paint(essid, COLOR_CYAN)
    if device_kind == "switch" then
        wifi_state = paint("N/A", COLOR_ORANGE)
        bssid = "-"
    else if essid == "unavailable/disabled" then
        wifi_state = paint(essid, COLOR_ORANGE)
    end if
    globals.deep_wifi_rows.push(deep_table_row([paint(router_id, COLOR_PINK),
        paint(device_kind.upper, COLOR_CYAN), wifi_state, paint(bssid, COLOR_CYAN)]))

    globals.deep_control_rows.push(deep_table_row([paint(router_id, COLOR_PINK), paint(0, COLOR_CYAN),
        paint("NATIVE", COLOR_ORANGE), paint("kernel_router.so", COLOR_CYAN),
        kernel, paint(local_ip, COLOR_CYAN)]))
    globals.deep_stats.control_endpoints = globals.deep_stats.control_endpoints + 1

    raw_rules = router.firewall_rules
    if typeof(raw_rules).lower == "list" then
        for rule in raw_rules
            globals.deep_firewall_rows.push(deep_firewall_row(router_id, rule))
            globals.deep_stats.firewall_rules = globals.deep_stats.firewall_rules + 1
        end for
        if raw_rules.len == 0 then
            globals.deep_firewall_notes.push(paint(router_id, COLOR_PINK) + " " +
                paint("No explicit firewall rules reported.", COLOR_ORANGE))
        end if
    else
        globals.deep_firewall_notes.push(paint(router_id, COLOR_PINK) + " " +
            paint("Firewall rule data unavailable.", COLOR_ORANGE))
        deep_add_gap(router_id, local_ip, "firewall rules unavailable")
    end if

    raw_wan_ports = router.used_ports
    if depth == 0 and not globals.deep_target_is_lan and typeof(globals.deep_basic_ports).lower == "list" then
        raw_wan_ports = globals.deep_basic_ports
    end if
    if typeof(raw_wan_ports).lower == "string" then
        globals.deep_forwarding_notes.push(paint(router_id, COLOR_PINK) + " " +
            paint("Forwarding list unavailable: " + deep_bounded_text(raw_wan_ports, 180), COLOR_ORANGE))
        deep_add_gap(router_id, public_ip, raw_wan_ports)
    else if typeof(raw_wan_ports).lower != "list" then
        globals.deep_forwarding_notes.push(paint(router_id, COLOR_PINK) + " " +
            paint("Forwarding list unavailable from this vantage.", COLOR_ORANGE))
        deep_add_gap(router_id, public_ip, "forwarding list unavailable")
    end if
    wan_records = deep_records_from_ports(router, raw_wan_ports)
    forward_scope = "UPSTREAM"
    if depth == 0 and not globals.deep_target_is_lan then forward_scope = "WAN"
    for record in wan_records
        record.forward_scope = forward_scope
        wan_state = deep_status_cell("FORWARDED", COLOR_ORANGE)
        if forward_scope == "UPSTREAM" then wan_state = deep_status_cell("UPSTREAM-FWD", COLOR_ORANGE)
        if record.closed then wan_state = deep_status_cell("CLOSED", COLOR_RED)
        globals.deep_wan_rows.push(deep_table_row([paint(router_id, COLOR_PINK),
            paint(forward_scope, COLOR_CYAN), paint(record.number, COLOR_CYAN), wan_state,
            paint(record.service, COLOR_CYAN), record.version, paint(record.lan, COLOR_CYAN)]))
        globals.deep_stats.visible_wan_ports = globals.deep_stats.visible_wan_ports + 1
    end for
    wan_records = deep_full_port_sweep(router, router_id, wan_records, device_kind, forward_scope)

    addresses = []
    listed_addresses = {}
    if is_valid_ip(local_ip) then
        add_unique(addresses, local_ip)
        listed_addresses[local_ip] = 1
    end if
    devices = router.devices_lan_ip
    if typeof(devices).lower == "list" then
        for ip in devices
            if is_valid_ip(ip) then
                add_unique(addresses, ip)
                listed_addresses[ip] = 1
            end if
        end for
    else
        deep_add_gap(router_id, local_ip, "LAN device list unavailable from this vantage")
    end if
    if depth == 0 and globals.deep_target_is_lan then
        add_unique(addresses, globals.deep_target_ip)
        if listed_addresses.hasIndex(globals.deep_target_ip) == false then
            globals.deep_unlisted_hosts[router_id + "|" + globals.deep_target_ip] = 1
            globals.deep_stats.unlisted_hosts = globals.deep_stats.unlisted_hosts + 1
        end if
    end if
    addresses = deep_expand_direct_subnet(router, router_id, addresses)
    addresses.sort

    if not router_is_vantage then
        deep_add_gap(router_id, local_ip, "execution-host ping and local switch-object lookup withheld outside this LAN to avoid private-IP collisions")
    end if

    for ip in addresses
        if globals.deep_stats.lan_nodes >= DEEP_MAX_NETWORK_DEVICES then
            deep_add_gap(router_id, ip, "LAN node safety limit reached")
            break
        end if
        host_key = router_id + "|" + ip
        if globals.deep_seen_hosts.hasIndex(host_key) then continue
        globals.deep_seen_hosts[host_key] = 1

        child_info = null
        node_kind = "host"
        if ip == local_ip then
            node_kind = device_kind
        else if router_is_vantage then
            child_info = deep_discover_child(ip, router)
            if typeof(child_info).lower == "map" then node_kind = child_info.kind
        end if

        cache_key = router_id + "|" + ip
        ping_reply = null
        ping_label = deep_status_cell("UNKNOWN", COLOR_ORANGE)
        if router_is_vantage then
            if globals.deep_ping_cache.hasIndex(cache_key) then
                ping_reply = globals.deep_ping_cache[cache_key]
            else
                ping_reply = globals.deep_execution_shell.ping(ip)
                globals.deep_ping_cache[cache_key] = ping_reply
            end if
            ping_label = deep_status_cell("NO-REPLY", COLOR_RED)
            if ping_reply then ping_label = deep_status_cell("REPLY", COLOR_GREEN)
        end if

        raw_ports = null
        if depth == 0 and globals.deep_target_is_lan and ip == globals.deep_target_ip then
            raw_ports = globals.deep_basic_ports
        else
            raw_ports = router.device_ports(ip)
        end if

        visibility = deep_status_cell("NO-DATA", COLOR_ORANGE)
        port_count = 0
        if typeof(raw_ports).lower == "list" then
            port_count = raw_ports.len
            visibility = deep_status_cell("VISIBLE", COLOR_GREEN)
            if raw_ports.len == 0 then visibility = deep_status_cell("NO-SERVICE", COLOR_ORANGE)
        else if typeof(raw_ports).lower == "string" then
            lower_error = raw_ports.lower
            visibility = deep_status_cell("FILTERED", COLOR_ORANGE)
            if lower_error.indexOf("firewall") != null or lower_error.indexOf("unreachable") != null then
                visibility = deep_status_cell("BLOCKED", COLOR_RED)
            end if
            globals.deep_stats.filtered = globals.deep_stats.filtered + 1
            deep_add_gap(router_id, ip, raw_ports)
        else
            globals.deep_stats.filtered = globals.deep_stats.filtered + 1
            deep_add_gap(router_id, ip, "device ports unavailable; closer LAN vantage required")
        end if

        host_number = globals.deep_stats.lan_nodes
        host_id = "H" + host_number
        globals.deep_stats.lan_nodes = globals.deep_stats.lan_nodes + 1
        discovery = paint("ROUTER-LIST", COLOR_CYAN)
        if ip == local_ip then discovery = paint("ROUTER-LOCAL", COLOR_CYAN)
        if globals.deep_unlisted_hosts.hasIndex(cache_key) then discovery = paint("PING-UNLISTED", COLOR_ORANGE)
        globals.deep_host_rows.push(deep_table_row([paint(host_id, COLOR_PINK), paint(router_id, COLOR_PINK),
            paint(ip, COLOR_CYAN), paint(node_kind.upper, COLOR_CYAN), discovery,
            ping_label, visibility, paint(port_count, COLOR_PINK)]))

        internal_records = deep_records_from_ports(router, raw_ports)
        for record in internal_records
            links = deep_wan_links(wan_records, record)
            mapped_text = "-"
            scope = deep_status_cell("NO-FORWARD-MATCH", COLOR_CYAN)
            if links.internet.len > 0 then
                mapped_text = links.internet.join(",")
                scope = deep_status_cell("LIKELY-WAN-MAPPED", COLOR_ORANGE)
            else if links.upstream.len > 0 then
                mapped_text = links.upstream.join(",")
                scope = deep_status_cell("LIKELY-UPSTREAM-MAPPED", COLOR_ORANGE)
            else if links.closed.len > 0 then
                mapped_text = links.closed.join(",")
                scope = deep_status_cell("MAPPED-CLOSED", COLOR_RED)
            else if record.closed then
                scope = deep_status_cell("CLOSED-NO-MATCH", COLOR_RED)
            end if
            globals.deep_port_rows.push(deep_table_row([paint(host_id, COLOR_PINK),
                paint(ip, COLOR_CYAN), paint(record.number, COLOR_CYAN), scope,
                paint(record.service, COLOR_CYAN), record.version, paint(mapped_text, COLOR_CYAN)]))
            globals.deep_stats.internal_ports = globals.deep_stats.internal_ports + 1
            if links.internet.len == 0 and links.upstream.len == 0 and links.closed.len == 0 then
                globals.deep_stats.unmatched_internal_ports = globals.deep_stats.unmatched_internal_ports + 1
            end if
        end for

        if typeof(child_info).lower == "map" then
            globals.deep_topology_rows.push(deep_table_row([paint(router_id, COLOR_PINK),
                paint("->", COLOR_PURPLE), paint(ip, COLOR_CYAN),
                paint(child_info.kind.upper, COLOR_CYAN), paint("DISCOVERED", COLOR_GREEN)]))
            if depth < DEEP_MAX_DEPTH then
                deep_collect_router(child_info.device, child_info.kind, depth + 1, router_id + "/" + ip)
            else
                deep_add_gap(router_id, ip, "child " + child_info.kind + " found at recursion depth limit")
            end if
        else if node_kind != "host" and not router_is_vantage then
            deep_add_gap(router_id, ip, "child-object lookup withheld outside execution LAN to avoid private-IP collision")
        end if
    end for
end function


run_deep_recon = function(recon_args)
    globals.deep_quick = false
    target_argument = ""
    for argument in recon_args
        if argument == "-h" or argument == "--help" then
            print(deep_usage)
            return true
        end if
        if argument == "--quick" then
            globals.deep_quick = true
        else if argument[:2] == "--" then
            print(paint("nmap: unknown option", COLOR_RED) + " " + argument)
            print(deep_usage)
            return false
        else
            if target_argument != "" then
                print(deep_usage)
                return false
            end if
            target_argument = argument
        end if
    end for
    if target_argument == "" then
        print(deep_usage)
        return false
    end if

    globals.deep_execution_shell = get_shell
    globals.deep_execution_computer = globals.deep_execution_shell.host_computer
    globals.deep_vantage_router = get_router

    globals.deep_requested_target = target_argument
    globals.deep_target_ip = globals.deep_requested_target
    if globals.deep_target_ip == "127.0.0.1" then
        globals.deep_target_ip = globals.deep_execution_computer.local_ip
    end if
    if not is_valid_ip(globals.deep_target_ip) then
        globals.deep_target_ip = nslookup(globals.deep_target_ip)
    end if
    if not is_valid_ip(globals.deep_target_ip) then
        print(paint("nmap: target could not be resolved", COLOR_RED) + " " +
            globals.deep_requested_target)
        return false
    end if
    globals.deep_target_is_lan = is_lan_ip(globals.deep_target_ip)
    if not globals.deep_target_is_lan and
        not globals.deep_execution_computer.is_network_active then
        print(paint("nmap: no Internet route for this public target", COLOR_RED))
        return false
    end if

    globals.deep_root_router = null
    if globals.deep_target_is_lan then
        globals.deep_root_router = get_router
    else
        globals.deep_root_router = get_router(globals.deep_target_ip)
    end if
    if not deep_is_router_device(globals.deep_root_router) then
        print(paint("nmap: router or target not found", COLOR_RED) + " " +
            paint(globals.deep_target_ip, COLOR_CYAN))
        return false
    end if

globals.deep_basic_ports = null
if globals.deep_target_is_lan then
    globals.deep_basic_ports = globals.deep_root_router.device_ports(globals.deep_target_ip)
else
    globals.deep_basic_ports = globals.deep_root_router.used_ports
end if

globals.deep_router_rows = []
globals.deep_wifi_rows = []
globals.deep_control_rows = []
globals.deep_firewall_rows = []
globals.deep_firewall_notes = []
globals.deep_forwarding_notes = []
