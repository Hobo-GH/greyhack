end if

deep_heading("INTERNAL PORT MAP")
print(paint("LIKELY mappings correlate destination LAN IP plus service/version; the API does not expose an exact internal destination port.", COLOR_ORANGE))
if globals.deep_port_rows.len == 0 then
    print(paint("No internal service ports were observable.", COLOR_ORANGE))
else
    deep_print_table(deep_table_row(["HOST", "IP", "PORT", "SCOPE", "SERVICE", "VERSION", "MAPPED_PORT"]), globals.deep_port_rows)
