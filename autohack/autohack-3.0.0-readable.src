summary_rows.push(deep_table_row(["ELAPSED_SECONDS", paint(time - globals.deep_scan_start, COLOR_PINK)]))
deep_print_table(deep_table_row(["METRIC", "VALUE"]), summary_rows)
print(paint("READ-ONLY", COLOR_GREEN) + "  no exploits, service sessions, file writes, or network configuration changes")
print(paint("Observation boundary:", COLOR_ORANGE) + " results are complete only for data visible from this execution vantage.")
    return true
end function


show_help = function()
    print(paint("AutoHack " + SCRIPT_VERSION, COLOR_PURPLE))
    print("  " + paint("<ip> [port|lan-ip] [lan-ip]", COLOR_GREEN) + "  attack all services or one exact port")
    print("  " + paint("target <ip> [port|lan-ip] [lan-ip]", COLOR_GREEN) + "  explicit form of the same command")
    print("  " + paint("nmap <ip|host> [--quick]", COLOR_PURPLE) + "       embedded read-only deep topology recon")
    print("  " + paint("sessions", COLOR_CYAN) + "                     list retained verified access")
    print("  " + paint("where / whoami", COLOR_CYAN) + "               show execution origin and selected target")
    print("  " + paint("shell [index]", COLOR_GREEN) + "                open latest or selected access")
    print("  " + paint("interesting [index]", COLOR_PURPLE) + "          list non-stock files without reading contents")
    print("  " + paint("autoshell [on|off]", COLOR_CYAN) + "           show or change automatic shell entry")
    print("  " + paint("poison [status|list|on|off]", COLOR_PURPLE) + "  inspect or control weak-library promotion")
    print("  " + paint("nuke [index]", COLOR_RED) + "                 Blackout one retained root target")
    print("  " + paint("harden home|server", COLOR_ORANGE) + "           fortify this execution host")
    print("  " + paint("forget [index|all]", COLOR_ORANGE) + "          release retained access objects")
    print("  " + paint("status", COLOR_CYAN) + "                       show storage and VDB readiness")
    print("  " + paint("help", COLOR_CYAN) + "                         show this help")
    print("  " + paint("quit", COLOR_ORANGE) + "                         leave AutoHack")
    print(char(10) + "Examples:")
    print("  " + paint("20.20.20.20", COLOR_CYAN))
    print("  " + paint("20.20.20.20 22", COLOR_CYAN))
    print("  " + paint("20.20.20.20 192.168.0.2", COLOR_CYAN) + "     scan all services for this LAN machine")
    print("  " + paint("20.20.20.20 22 192.168.0.2", COLOR_CYAN) + "  require that exact LAN machine")
    print("  " + paint("20.20.20.20 0 192.168.0.1", COLOR_CYAN) + "   target the router control plane")
    print("  " + paint("nmap 20.20.20.20", COLOR_PURPLE) + "              full embedded deep recon")
    print("  " + paint("shell", COLOR_GREEN) + "  open the newest retained session and return here on exit")
    print("  " + paint("interesting 0", COLOR_PURPLE) + "  inventory unusual files on retained session 0")
    print("  " + paint("nuke 0", COLOR_RED) + "  destroy retained root session 0 after exact confirmation")
    print("  " + paint("harden home", COLOR_ORANGE) + "  root-lock this host while preserving Terminal bootstrap")
    print("  " + paint("harden server", COLOR_ORANGE) + "  root-lock this entire SSH server")
    print(char(10) + "Successful access is retained without opening a terminal unless AutoShell is on.")
    print("AutoHack stays open after failures and after target terminals close.")
    print(paint("Nuke and harden always require explicit target-specific confirmation.", COLOR_RED))
    print("The Rowan circuit prompt reads left-to-right from execution origin to selected target.")
end function


words_from_line = function(line)
    words = []
    if typeof(line).lower != "string" then return words
    for word in line.split(" ")
        word = word.trim
        if word != "" then words.push(word)
    end for
    return words
end function


parse_target_words = function(words)
    start = 0
    if words.len > 0 then
        command = words[0].lower
        if command == "target" or command == "hack" then start = 1
    end if
    if words.len <= start then
        return {"ok": false, "error": "Usage: <public-ip> [port|lan-ip] [lan-ip]"}
    end if

    ip = words[start]
    if not is_valid_ip(ip) then
        return {"ok": false, "error": "Invalid public IP."}
    end if

    port = -1
    lan = ""
    if words.len > start + 1 then
        selector = words[start + 1]
        if is_lan_ip(selector) then
            lan = selector
            if words.len > start + 2 then
                return {"ok": false, "error": "Usage: <public-ip> [port|lan-ip] [lan-ip]"}
            end if
        else
            port = selector.to_int
            if typeof(port).lower != "number" then
                return {"ok": false, "error": "Second value must be a port or target LAN IP."}
            end if
            if port < 0 or port > 65535 then
                return {"ok": false, "error": "Port must be between 0 and 65535."}
            end if
            if words.len > start + 2 then
                lan = words[start + 2]
                if not is_lan_ip(lan) then
                    return {"ok": false, "error": "Invalid target LAN IP."}
                end if
            end if
            if words.len > start + 3 then
                return {"ok": false, "error": "Usage: <public-ip> [port|lan-ip] [lan-ip]"}
            end if
        end if
    end if

    return {"ok": true, "ip": ip, "port": port, "lan": lan, "error": ""}
end function


run_console_command = function(words)
    if words.len == 0 then return true
    command = words[0].lower
    if command == "quit" or command == "q" or command == "exit" then return false
    if command == "help" or command == "--help" or command == "-h" then
        show_help
        return true
    end if
    if command == "nmap" or command == "deepmap" then
        recon_args = []
        if words.len > 1 then
            for word in words[1:]
                recon_args.push(word)
            end for
        end if
        run_deep_recon(recon_args)
        return true
    end if
    if command == "status" then
        show_status
        return true
    end if
    if command == "where" or command == "whoami" or command == "location" then
        show_location
        return true
    end if
    if command == "sessions" then
        show_access_sessions
        return true
    end if
    if command == "interesting" or command == "i" then
        if words.len > 2 then
            print(paint("Usage: interesting [index]", COLOR_RED))
            return true
        end if
        index = -1
        if words.len == 2 and words[1].lower != "latest" then
            index = words[1].to_int
            if typeof(index).lower != "number" or index < 0 then
                print(paint("Session index must be zero or greater.", COLOR_RED))
                return true
            end if
        end if
        scan_interesting_session(index)
        return true
    end if
    if command == "shell" then
        if words.len > 2 then
            print(paint("Usage: shell [index]", COLOR_RED))
            return true
        end if
        index = -1
        if words.len == 2 and words[1].lower != "latest" then
            index = words[1].to_int
            if typeof(index).lower != "number" or index < 0 then
                print(paint("Session index must be zero or greater.", COLOR_RED))
                return true
            end if
        end if
        open_access_session(index)
        return true
    end if
    if command == "autoshell" then
        if words.len == 1 then
            print("AutoShell: " + paint(globals.autoshell, COLOR_CYAN))
            return true
        end if
        if words.len != 2 then
            print(paint("Usage: autoshell [on|off]", COLOR_RED))
            return true
        end if
        mode = words[1].lower
        if mode == "on" then
            globals.autoshell = true
        else if mode == "off" then
            globals.autoshell = false
        else
            print(paint("Usage: autoshell [on|off]", COLOR_RED))
            return true
        end if
        print("AutoShell: " + paint(globals.autoshell, COLOR_CYAN))
        return true
    end if
    if command == "poison" then
        if words.len == 1 then
            show_poison_status
            return true
        end if
        if words.len != 2 then
            print(paint("Usage: poison [status|list|on|off]", COLOR_RED))
            return true
        end if
        mode = words[1].lower
        if mode == "status" or mode == "list" then
            show_poison_status
            return true
        end if
        if mode == "on" then
            globals.poison_auto = true
        else if mode == "off" then
            globals.poison_auto = false
        else
            print(paint("Usage: poison [status|list|on|off]", COLOR_RED))
            return true
        end if
        print("Automatic poison promotion: " + paint(globals.poison_auto, COLOR_CYAN))
        return true
    end if
    if command == "nuke" or command == "blackout" then
        if words.len > 2 then
            print(paint("Usage: nuke [index]", COLOR_RED))
            return true
        end if
        index = -1
        if words.len == 2 and words[1].lower != "latest" then
            index = words[1].to_int
            if typeof(index).lower != "number" or index < 0 then
                print(paint("Session index must be zero or greater.", COLOR_RED))
                return true
            end if
        end if
        nuke_access_session(index)
        return true
    end if
    if command == "harden" or command == "fortify" then
        if words.len != 2 then
            print(paint("Usage: harden home|server", COLOR_RED))
            return true
        end if
        harden_execution_host(words[1])
        return true
    end if
    if command == "forget" then
        if words.len > 2 then
            print(paint("Usage: forget [index|all]", COLOR_RED))
            return true
        end if
        if words.len == 2 and words[1].lower == "all" then
            count = globals.access_sessions.len
            globals.access_sessions = []
            globals.active_session = -1
            print("Forgot " + paint(count, COLOR_CYAN) + " retained session(s).")
            return true
        end if
        index = -1
        if words.len == 2 and words[1].lower != "latest" then
            index = words[1].to_int
            if typeof(index).lower != "number" or index < 0 then
                print(paint("Session index must be zero or greater.", COLOR_RED))
                return true
            end if
        end if
        forget_access_session(index)
        return true
    end if

    target = parse_target_words(words)
    if not target.ok then
        print(paint(target.error, COLOR_RED))
        return true
    end if

    success = run_target(target.ip, target.port, target.lan)
    if success then
        print(paint("AUTOHACK COMPLETE", COLOR_GREEN))
    else
        print(paint("AUTOHACK FAILED", COLOR_RED))
        print("See " + paint(LOG_ROOT + "/latest.txt", COLOR_ORANGE))
    end if
    return true
end function


if params.len > 0 and params[0] == "--router-clean-helper" then router_helper_mode

globals.local_shell = get_shell
if not is_shell(globals.local_shell) then exit("AutoHack requires a local shell.")
globals.local_computer = globals.local_shell.host_computer
globals.metaxploit = include_lib("/lib/metaxploit.so")
globals.crypto = include_lib("/lib/crypto.so")
globals.execution_computer_source = null
globals.execution_router_source = null
globals.network_root_passwords = {}
globals.retained_results = []
globals.access_sessions = []
globals.active_session = -1
globals.autoshell = false
globals.interesting_results = []
globals.interesting_session = -1
globals.poison_auto = true
globals.poison_attempts = 0
globals.poison_successes = 0
globals.poison_last = "none"
globals.nuke_attempts = 0
globals.nuke_successes = 0
globals.nuke_last = "none"
globals.harden_attempts = 0
globals.harden_successes = 0
globals.harden_last = "none"

show_banner
if not require_pin then exit
if typeof(globals.metaxploit).lower != "metaxploitlib" then exit(paint("AUTOHACK ERROR", COLOR_RED) + " missing " + paint("/lib/metaxploit.so", COLOR_CYAN))
if typeof(globals.crypto).lower != "cryptolib" then exit(paint("AUTOHACK ERROR", COLOR_RED) + " missing " + paint("/lib/crypto.so", COLOR_CYAN))
if not init_storage then exit(paint("AUTOHACK ERROR", COLOR_RED) + " could not create " + paint(APP_ROOT, COLOR_ORANGE))
init_log
init_vulns
diag("startup | host=" + globals.local_computer.public_ip + "/" +
    globals.local_computer.local_ip)

keep_running = true
if params.len > 0 then
    keep_running = run_console_command(params)
else
    show_help
end if
while keep_running
    line = user_input(console_prompt).trim
    keep_running = run_console_command(words_from_line(line))
end while
diag("shutdown | retained_sessions=" + globals.access_sessions.len)
globals.access_sessions = []
flush_log
if is_file(globals.execution_computer_source) then
    wait(FINALIZER_WAIT_SECONDS)
    clean_execution_route
end if
