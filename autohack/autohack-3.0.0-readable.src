print("<align=center><size=125%><b>" + paint("NMAP", COLOR_PURPLE) + " // " +
    paint("SYNTHWAVE DEEP RECON", COLOR_PINK) + "</b></size></align>")
print("Target " + paint(globals.deep_requested_target, COLOR_CYAN) + " -> " +
