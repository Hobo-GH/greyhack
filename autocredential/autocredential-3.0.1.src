	print "                          " + paint("│", COLOR_GREEN)
	print "             " + paint("╭────────────", COLOR_PURPLE) + paint("┴", COLOR_GREEN) + paint("─────╮", COLOR_CYAN)
	print "             " + paint("│  ", COLOR_PURPLE) + paint("AUTOCREDENTIAL", COLOR_PINK) + paint("  │", COLOR_CYAN) + paint("──────◆", COLOR_GREEN)
	print "             " + paint("╰────────", COLOR_PURPLE) + paint("◆", COLOR_GREEN) + paint("─────────╯", COLOR_CYAN)
	print "                      " + paint("│", COLOR_GREEN)
	print "                " + paint("◆─────", COLOR_PINK) + paint("┴", COLOR_GREEN) + paint("─────◆", COLOR_GREEN)
