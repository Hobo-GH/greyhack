	print ""
	print paint("AutoCredential ", COLOR_PURPLE) + paint(SCRIPT_VERSION, COLOR_CYAN) + paint(" — classic credential contracts", COLOR_DIM)
	print paint("AutoCredential handles ", COLOR_DIM) + paint("mail, route, access, password recovery, queue, cleanup, and continuation", COLOR_GREEN)
