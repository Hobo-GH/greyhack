//Made By Hobo & Rowan
// AutoCredential 3.0.1
// Targeted credential-contract automation for Grey Hack Public v0.9.6773.
//
// This handles the classic "Mission Contract" credential jobs. The newer
// procedural Fraud/Sabotage/Corporate Espionage missions are multi-stage and
// intentionally are not treated as credential contracts here.
//
// One command, one PIN, one selection. A short-lived child process rebuilds the
// current MetaMail snapshot on every invocation and every fresh/refresh request;
// completed jobs are never loaded from an old task file.

SCRIPT_VERSION = "3.0.1"

// Empty mail fields are prompted at runtime; an empty PIN disables the PIN
// check. Keeping secrets out of source is recommended. Password/PIN prompts
// use user_input(..., 1) so their input is masked.
MAIL_USER = ""
MAIL_PASSWORD = ""
PIN = ""

MAX_MAILS = 100
AUTOSCRIPTS_ROOT = "/root/autoscripts"
APP_ROOT = "/root/autoscripts/credential"
TASK_ROOT = "/root/autoscripts/credential/tasks"
TASK_PATH = "/root/autoscripts/credential/tasks/current.txt"
TASK_HEADER = "ACTASK1"
LOG_ROOT = "/root/autoscripts/credential/logs"
DEBUG_FILE_PREFIX = "latest"
DEBUG_FILE_LIMIT = 150000
DEBUG_FLUSH_LINES = 12
MAIL_INTAKE_REQUEST_PREFIX = "mail-intake-request-"
MAIL_INTAKE_SNAPSHOT_PREFIX = "mail-intake-snapshot-"
MAIL_INTAKE_SNAPSHOT_HEADER = "ACMAIL2"
MAIL_INTAKE_WAIT = 30

VULN_DB_ROOT = "/root/vulndb"
VULN_DB_INDEX_PATH = "/root/vulndb/index.txt"
VULN_DB_INDEX_HEADER = "ACVDBINDEX3"
VULN_DB_V2_INDEX_HEADER = "ACVDBINDEX2"
VULN_DB_LEGACY_INDEX_HEADER = "ACVDBINDEX1"
VULN_DB_LEGACY_SHARD_PREFIX = "vulns-"
VULN_DB_SHARD_PREFIX = "shard-"
VULN_DB_SHARD_LIMIT = 120000
VULN_DB_SOURCE = "autocredential"

LOG_FINALIZER_WAIT = 2
MAX_ROUTE_SHELLS = 12
MAX_OBJECTS_PER_ENDPOINT = 24
CREDENTIAL_INJECT = "ac2026"

// Optional router-jump library. Leave blank to disable. The file must exist on
// the execution server. AutoCredential only installs it after root is proven on a
// router and only uses it to reach the contract LAN address.
POISON_HTTP_SOURCE = ""

COLOR_PURPLE = "#D86CFF"
COLOR_CYAN = "#55E7FF"
COLOR_GREEN = "#63FF9B"
COLOR_RED = "#FF5C7C"
COLOR_ORANGE = "#FFB86B"
COLOR_PINK = "#FF79C6"
COLOR_LAVENDER = "#C7A7E8"
COLOR_DIM = "#A79BC8"


is_shell_type = function(kind)
	// overflow documents full shell/computer/file return objects. Partial and
	// FTP variants expose different members, so do not call full-object APIs on
	// them without an exploit-specific adapter.
	return kind == "shell"
end function


is_ftp_shell_type = function(kind)
	return kind.lower == "ftpshell"
end function


is_computer_type = function(kind)
	return kind.lower == "computer"
end function


is_file_type = function(kind)
	return kind.lower == "file"
end function


is_router_type = function(kind)
	return kind.lower == "router"
end function


is_switch_type = function(kind)
	return kind.lower == "switch"
end function


is_route_device = function(value)
	kind = typeof(value)
	return is_router_type(kind) or is_switch_type(kind)
end function


is_net_session = function(value)
	return typeof(value).lower == "netsession"
end function


is_meta_lib = function(value)
	return typeof(value).lower == "metalib"
end function


is_metaxploit = function(value)
	return typeof(value).lower == "metaxploitlib"
end function


is_exploit_object = function(value)
	kind = typeof(value)
	if is_shell_type(kind) then return true
	if is_ftp_shell_type(kind) then return true
	if is_computer_type(kind) then return true
	if is_file_type(kind) then return true
	return false
end function


join_path = function(folder, name)
	if folder == "/" then return "/" + name
	if folder[-1] == "/" then return folder + name
	return folder + "/" + name
end function


paint = function(value, color)
	return "<color=" + color + ">" + str(value) + "</color>"
end function


yes_no = function(value)
	if value then return "yes"
	return "no"
end function


event_line = function(label, label_color, detail = "", detail_color = COLOR_LAVENDER)
	line = paint("◆ " + label, label_color)
	if detail != "" then line = line + "  " + paint(detail, detail_color)
	return line
end function


event_branch = function(label, label_color, detail = "", detail_color = COLOR_LAVENDER)
	line = paint("  ╰ " + label, label_color)
	if detail != "" then line = line + "  " + paint(detail, detail_color)
	return line
end function


credential_heading = function(title, detail = "")
	line = char(10) + paint("◆ " + title, COLOR_PURPLE)
	if detail != "" then line = line + "  " + paint(detail, COLOR_CYAN)
	print line
end function


fatal_line = function(message)
	return paint("AUTOCREDENTIAL REFUSED", COLOR_RED) + " | " + paint(message, COLOR_ORANGE)
end function


credential_state_color = function(state)
	lowered = state.lower
	if lowered.indexOf("ready") != null or lowered.indexOf("complete") != null then return COLOR_GREEN
	if lowered.indexOf("failed") != null or lowered.indexOf("refused") != null then return COLOR_RED
	if lowered.indexOf("wait") != null or lowered.indexOf("login") != null then return COLOR_ORANGE
	return COLOR_PINK
end function


credential_input_signature = function(state, destination_label, destination, requested_user = "")
	origin = "NO ORIGIN"
	if is_computer_type(typeof(globals.local_computer)) then
		origin = globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
	end if
	if destination == "" then destination = "NO TARGET"
	top = paint("╭─◆ AUTOCREDENTIAL ◆─", COLOR_PURPLE) + paint("[" + state + "]", credential_state_color(state))
	bottom = paint("╰─", COLOR_PURPLE) + paint("ORIGIN ", COLOR_ORANGE) + paint(origin, COLOR_CYAN) + paint(" ─▶ ", COLOR_GREEN) + paint(destination_label + " ", COLOR_PINK) + paint(destination, COLOR_CYAN)
	if requested_user != "" then
		bottom = bottom + paint(" ─▶ ", COLOR_GREEN) + paint("ACCOUNT ", COLOR_PINK) + paint(requested_user, COLOR_PINK)
	end if
	return top + char(10) + bottom + paint(" ─▶ ", COLOR_GREEN)
end function


credential_pin_signature = function
	origin = "NO ORIGIN"
	if is_computer_type(typeof(globals.local_computer)) then
		origin = globals.local_computer.public_ip + "/" + globals.local_computer.local_ip
	end if
	top = paint("╭─◆ AUTOCREDENTIAL ◆─", COLOR_PURPLE) + paint("[PIN REQUIRED]", COLOR_ORANGE)
	bottom = paint("╰─", COLOR_PURPLE) + paint("ORIGIN ", COLOR_ORANGE) + paint(origin, COLOR_CYAN) + paint(" ─▶ ", COLOR_GREEN) + paint("ENTER PIN", COLOR_PINK) + paint(" ─▶ ", COLOR_GREEN)
	return top + char(10) + bottom
end function


